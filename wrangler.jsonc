{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "lectio",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"vars": {
		// Pinned so /start and /callback always send Google the identical redirect_uri;
		// deriving it from the request URL can differ by scheme and breaks token exchange.
		"GOOGLE_REDIRECT_URI": "https://enjoyhim.org/api/auth/google/callback"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lectio-readings",
			"database_id": "b31145ba-04a6-4fc9-bc01-744f1224e3d8"
		}
	],
	// Prebuilt TTS clips (steps + lectionary days). /audio/* and /api/tts read
	// them from this binding, so a deploy no longer needs the audio corpus on
	// the build machine. scripts/seed-audio-r2.mjs keeps the bucket in sync
	// with the manifests.
	"r2_buckets": [
		{
			"binding": "AUDIO",
			"bucket_name": "lectio-audio"
		}
	],
	// Open-source TTS (MeloTTS) for listening to the daily passage.
	"ai": {
		"binding": "AI"
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "f8cfe6b42b2c473587f061c683777705"
		}
	],
	"routes": [
		{
			"pattern": "enjoyhim.org",
			"zone_name": "enjoyhim.org",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	]
}