{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "inspire",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"binding": "ASSETS",
		"directory": "./dist"
	},
	"observability": {
		"enabled": true,
		"redact_query_string": false
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "inspire-readings",
			"database_id": "2873b281-1d7c-4a82-8649-a91d912bbb0f"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "8c7ba8cc166749d49512d17cd856b45c"
		}
	],
	"routes": [
		{
			"pattern": "dramatherapy.us",
			"zone_name": "dramatherapy.us",
			"custom_domain": true,
			"enabled": true,
			"previews_enabled": false
		}
	]
}