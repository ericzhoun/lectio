---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import {
  getTarotDeck, drawCards, drawCardsFromNames, rebuildDrawnCards,
  sanitizeDeckOrder, sanitizePickedIndices, SPREADS, DEFAULT_QUESTIONS,
  type DrawnCard, type Lang,
} from '../lib/tarot';
import {
  PENDING_DRAW_COOKIE, createPendingDrawToken, verifyPendingDrawToken,
  type PendingDrawSpread,
} from '../lib/pendingDraw';
import { drawVerses, rebuildDrawnVerses, buildBiblePages, BIBLE_SPREADS, type DrawnVerse, type Mode } from '../lib/bible';
import { generateInterpretation, generateFollowUpQuestions, generateBibleInterpretation } from '../lib/openai';
import { logReading } from '../lib/db';
import { env } from 'cloudflare:workers';
import { verifySessionToken } from '../lib/session';
import {
  canDraw, recordDraw, resolveTier, SPREAD_ACCESS, QUOTA, ANON_DAILY_DRAWS,
  type Tier,
} from '../lib/entitlements';
import { getCreditBalance } from '../lib/credits';
import { getTodayUsage } from '../lib/usage';
import { resolveLang } from '../lib/i18n';

const url = Astro.url;
const lang = resolveLang(Astro);

const sessionCookie = Astro.cookies.get('session')?.value;
const loggedInUserId = sessionCookie ? await verifySessionToken(sessionCookie, env.SESSION_SECRET) : null;

let question = '';
let isDefaultQuestion = false;
let cards: DrawnCard[] | null = null;
let verses: DrawnVerse[] | null = null;
let interpretation = '';
let followUpQuestions: string[] = [];
let spreadKey = url.searchParams.get('spread') ?? 'single';
if (!(spreadKey in SPREADS)) spreadKey = 'single';
let mode: Mode = url.searchParams.get('mode') === 'bible' ? 'bible' : 'tarot';
let error: string | null = null;
let upsellReason: 'quota' | 'spread_locked' | 'no_credits' | null = null;
// "Draw now, register to reveal" state: cards that have been drawn but whose
// interpretation is still locked (anonymous visitor, or a registered visitor
// whose reveal is not possible yet).
let pendingCards: DrawnCard[] | null = null;
let pendingVerses: DrawnVerse[] | null = null;
let pendingSpreadKey: '3card' | 'celtic_cross' | null = null;
// Pending gate state. Object holder on purpose: every assignment happens
// inside closures (applyReveal / draw branches), and a plain let narrowed by
// control-flow analysis confuses the template comparisons below.
const pendingGateState: {
  gate: 'action' | 'credits' | 'quota' | 'locked' | 'retry' | null;
} = { gate: null };
const registered = loggedInUserId !== null;

// Pending draw cookie (read before the POST branch — the reveal flow needs it).
// A pending draw is an anonymous draw whose interpretation is still locked:
// the drawn items are shown (cards, or Bible verses inside their chapter),
// and the 解经/解读 button starts the reveal (registration for anonymous
// visitors, or the interpretation itself for registered ones).
const pendingToken = Astro.cookies.get(PENDING_DRAW_COOKIE)?.value;
const pendingDrawData = await verifyPendingDrawToken(pendingToken, env.SESSION_SECRET);
const clearPending = () => Astro.cookies.delete(PENDING_DRAW_COOKIE, { path: '/' });
const pendingSpreadMeta = pendingDrawData
  ? (pendingDrawData.mode === 'bible' ? BIBLE_SPREADS[pendingDrawData.spread] : SPREADS[pendingDrawData.spread])
  : undefined;

// Rebuild the drawn items for display (card faces or verse texts), with
// position labels in the current language. Returns null for a corrupt
// payload (wrong item count, unknown names/refs).
const rebuildPending = (): { cards: DrawnCard[]; verses: DrawnVerse[] } | null => {
  if (!pendingDrawData || !pendingSpreadMeta) return null;
  if (pendingDrawData.mode === 'bible') {
    const rebuilt = rebuildDrawnVerses(pendingDrawData.verses ?? []);
    if (rebuilt.length !== pendingSpreadMeta.number) return null;
    const positions = pendingSpreadMeta.positions[lang];
    rebuilt.forEach((v, i) => { v.position = positions[i] ?? ''; });
    return { cards: [], verses: rebuilt };
  }
  const rebuilt = rebuildDrawnCards(getTarotDeck(), pendingDrawData.cards ?? [], lang);
  if (rebuilt.length !== pendingSpreadMeta.number) return null;
  const positions = pendingSpreadMeta.positions[lang];
  rebuilt.forEach((c, i) => { c.position = positions[i] ?? ''; });
  return { cards: rebuilt, verses: [] };
};

// Run the reveal (button-driven): generate the question-based interpretation
// for the pending draw, spend the matching credit, log, and clear the cookie.
// Failure modes set a gate variant (credits / quota / locked / retry) and
// keep the cookie so a later attempt still works.
const applyReveal = async (): Promise<void> => {
  if (!pendingDrawData || !pendingSpreadMeta || !registered || !loggedInUserId) return;
  const revealEntitlement = await canDraw(loggedInUserId, pendingDrawData.spread, true);
  const pending = rebuildPending();
  if (!pending) {
    clearPending();
    return;
  }
  if (!revealEntitlement.ok) {
    pendingGateState.gate =
      revealEntitlement.reason === 'no_credits' ? 'credits'
      : revealEntitlement.reason === 'quota' ? 'quota'
      : 'locked';
    pendingCards = pending.cards.length > 0 ? pending.cards : null;
    pendingVerses = pending.verses.length > 0 ? pending.verses : null;
    pendingSpreadKey = pendingDrawData.spread;
    question = pendingDrawData.question;
    isDefaultQuestion = false;
    return;
  }
  try {
    if (pendingDrawData.mode === 'bible') {
      const rebuilt = pending.verses;
      const interp = await generateBibleInterpretation(pendingDrawData.question, rebuilt, lang, pendingDrawData.spread);
      rebuilt.forEach((v, i) => {
        v.interp_text = interp.cards[i]?.text ?? '';
        v.tags = interp.cards[i]?.tags ?? [];
      });
      interpretation = interp.summary;
      const followUpContext = interpretation || rebuilt.map((v) => v.interp_text).join(' ');
      followUpQuestions = await generateFollowUpQuestions(pendingDrawData.question, followUpContext, lang);
      const ipHeader = Astro.request.headers.get('x-forwarded-for');
      const ipAddress = ipHeader
        ? ipHeader.split(',')[0].trim()
        : Astro.request.headers.get('cf-connecting-ip');
      await logReading(
        pendingDrawData.question,
        rebuilt.map((v) => ({ en: v.refEn, zh: v.refZh })),
        interpretation,
        ipAddress,
        loggedInUserId,
        'bible'
      );
      await recordDraw(loggedInUserId, pendingDrawData.spread, true);
      question = pendingDrawData.question;
      isDefaultQuestion = false;
      verses = rebuilt;
      spreadKey = pendingDrawData.spread;
      mode = 'bible';
    } else {
      const rebuilt = pending.cards;
      const interp = await generateInterpretation(pendingDrawData.question, rebuilt, lang, pendingDrawData.spread);
      rebuilt.forEach((c, i) => {
        c.interp_text = interp.cards[i]?.text ?? '';
        c.tags = interp.cards[i]?.tags ?? [];
      });
      interpretation = interp.summary;
      const followUpContext = interpretation || rebuilt.map((c) => c.interp_text).join(' ');
      followUpQuestions = await generateFollowUpQuestions(pendingDrawData.question, followUpContext, lang);
      const ipHeader = Astro.request.headers.get('x-forwarded-for');
      const ipAddress = ipHeader
        ? ipHeader.split(',')[0].trim()
        : Astro.request.headers.get('cf-connecting-ip');
      await logReading(pendingDrawData.question, rebuilt, interpretation, ipAddress, loggedInUserId);
      await recordDraw(loggedInUserId, pendingDrawData.spread, true);
      question = pendingDrawData.question;
      isDefaultQuestion = false;
      cards = rebuilt;
      spreadKey = pendingDrawData.spread;
      mode = 'tarot';
    }
    clearPending();
  } catch (e) {
    // Interpretation failed (e.g. LLM outage) — keep the pending cookie so a
    // reload can retry without spending the credit again.
    console.error('Reveal interpretation failed:', e);
    pendingCards = pending.cards.length > 0 ? pending.cards : null;
    pendingVerses = pending.verses.length > 0 ? pending.verses : null;
    pendingSpreadKey = pendingDrawData.spread;
    pendingGateState.gate = 'retry';
    question = pendingDrawData.question;
    isDefaultQuestion = false;
  }
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  question = String(form.get('question') ?? '');

  if (form.get('reveal_pending') === '1') {
    // Button-driven reveal (解经 / 解读). Anonymous visitors never submit
    // this form — they see the registration modal instead.
    await applyReveal();
  } else if (!question) {
    error = lang === 'zh' ? '请输入问题' : 'Please enter a question';
  } else {
    // user id, persisted via cookie (replaces Flask session)
    let userId = Astro.cookies.get('user_id')?.value;
    if (!userId) {
      userId = crypto.randomUUID();
      Astro.cookies.set('user_id', userId, { path: '/', httpOnly: true });
    }

    const ipHeader = Astro.request.headers.get('x-forwarded-for');
    const ipAddress = ipHeader
      ? ipHeader.split(',')[0].trim()
      : Astro.request.headers.get('cf-connecting-ip');

    spreadKey = String(form.get('spread') ?? 'single');
    if (!(spreadKey in SPREADS)) spreadKey = 'single';
    mode = String(form.get('mode') ?? 'tarot') === 'bible' ? 'bible' : 'tarot';

    const entitlementUserId = loggedInUserId ?? userId;
    const entitlement = await canDraw(entitlementUserId, spreadKey, registered);

    if (!entitlement.ok) {
      upsellReason = entitlement.reason;
    } else if (entitlement.gated && mode === 'tarot') {
      // Anonymous 3-card "draw now, register to reveal" flow. The cards are
      // drawn immediately (honoring the visitor's fan picks when valid) and
      // stored in a signed cookie. No interpretation is generated and no
      // quota/credit is spent here — the reveal after registration spends one
      // of the account's welcome credits.
      const deck = getTarotDeck();
      const spread = SPREADS[spreadKey];
      const allowReversed = form.get('reversed') === 'on';
      const order = sanitizeDeckOrder(String(form.get('deck_order') ?? ''), deck);
      const picks = sanitizePickedIndices(String(form.get('picked') ?? ''), deck.length, spread.number);
      const drawn = order && picks
        ? drawCardsFromNames(deck, picks.map((i) => order[i]), allowReversed, lang)
        : drawCards(deck, spread.number, allowReversed, lang);
      if (drawn.length > 0) {
        const token = await createPendingDrawToken(
          {
            v: 1,
            mode: 'tarot',
            spread: spreadKey as PendingDrawSpread,
            question,
            cards: drawn.map((c) => ({ en: c.en, reversed: c.reversed })),
            ts: Date.now(),
          },
          env.SESSION_SECRET
        );
        Astro.cookies.set(PENDING_DRAW_COOKIE, token, {
          path: '/',
          httpOnly: true,
          sameSite: 'lax',
          secure: true,
          maxAge: 60 * 60 * 24 * 7,
        });
        const positions = spread.positions[lang];
        drawn.forEach((c, i) => { c.position = positions[i] ?? ''; });
        pendingCards = drawn;
        pendingSpreadKey = spreadKey as PendingDrawSpread;
        pendingGateState.gate = 'action';
      }
    } else if (entitlement.gated) {
      // Anonymous Bible "flip to reveal" flow: draw the verses now and show
      // the scripture for free; the question-based reading stays locked until
      // registration. The reveal afterwards consumes a trial credit.
      const spread = BIBLE_SPREADS[spreadKey];
      const drawnVerses = drawVerses(spread.number);
      const positions = spread.positions[lang];
      drawnVerses.forEach((v, i) => { v.position = positions[i] ?? ''; });
      const token = await createPendingDrawToken(
        {
          v: 1,
          mode: 'bible',
          spread: spreadKey as PendingDrawSpread,
          question,
          verses: drawnVerses.map((v) => v.refEn),
          ts: Date.now(),
        },
        env.SESSION_SECRET
      );
      Astro.cookies.set(PENDING_DRAW_COOKIE, token, {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        secure: true,
        maxAge: 60 * 60 * 24 * 7,
      });
      pendingVerses = drawnVerses;
      pendingSpreadKey = spreadKey as PendingDrawSpread;
      pendingGateState.gate = 'action';
    } else if (mode === 'bible') {
      const spread = BIBLE_SPREADS[spreadKey] ?? BIBLE_SPREADS.single;
      const drawnVerses = drawVerses(spread.number);
      const positions = spread.positions[lang];
      drawnVerses.forEach((v, i) => { v.position = positions[i] ?? ''; });

      const interp = await generateBibleInterpretation(question, drawnVerses, lang, spreadKey);
      drawnVerses.forEach((v, i) => {
        v.interp_text = interp.cards[i]?.text ?? '';
        v.tags = interp.cards[i]?.tags ?? [];
      });
      interpretation = interp.summary;
      verses = drawnVerses;

      const followUpContext = interpretation || verses.map((v) => v.interp_text).join(' ');
      followUpQuestions = await generateFollowUpQuestions(question, followUpContext, lang);

      await logReading(
        question,
        verses.map((v) => ({ en: v.refEn, zh: v.refZh })),
        interpretation,
        ipAddress,
        entitlementUserId,
        'bible'
      );
      await recordDraw(entitlementUserId, spreadKey, registered);
    } else {
      const deck = getTarotDeck();
      const spread = SPREADS[spreadKey];
      const allowReversed = form.get('reversed') === 'on';
      cards = drawCards(deck, spread.number, allowReversed, lang);

      const positions = spread.positions[lang];
      cards.forEach((c, i) => { c.position = positions[i] ?? ''; });

      const interp = await generateInterpretation(question, cards, lang, spreadKey);
      cards.forEach((c, i) => {
        c.interp_text = interp.cards[i]?.text ?? '';
        c.tags = interp.cards[i]?.tags ?? [];
      });
      interpretation = interp.summary;

      const followUpContext = interpretation || cards.map((c) => c.interp_text).join(' ');
      followUpQuestions = await generateFollowUpQuestions(question, followUpContext, lang);

      await logReading(question, cards, interpretation, ipAddress, entitlementUserId);
      await recordDraw(entitlementUserId, spreadKey, registered);
    }
  }
} else {
  const preservedQuestion = url.searchParams.get('question');
  if (preservedQuestion) {
    question = preservedQuestion;
    isDefaultQuestion = false;
  } else {
    const defaults = DEFAULT_QUESTIONS[lang];
    let idx = Number(Astro.cookies.get('question_index')?.value ?? Math.floor(Math.random() * defaults.length));
    if (Number.isNaN(idx) || idx < 0 || idx >= defaults.length) idx = 0;
    question = defaults[idx];
    Astro.cookies.set('question_index', String((idx + 1) % defaults.length), { path: '/' });
    isDefaultQuestion = true;
  }
}

// Pending view setup: when a valid pending draw exists and no fresh reading
// is being shown, render the drawn items with the 解经/解读 action. The
// reveal itself is button-driven — anonymous visitors get the registration
// modal on click; registered ones submit the reveal form.
if (pendingDrawData && pendingSpreadMeta && !cards && !verses && !pendingGateState.gate) {
  const pending = rebuildPending();
  if (pending) {
    pendingCards = pending.cards.length > 0 ? pending.cards : null;
    pendingVerses = pending.verses.length > 0 ? pending.verses : null;
    pendingSpreadKey = pendingDrawData.spread;
    pendingGateState.gate = 'action';
    question = pendingDrawData.question;
    isDefaultQuestion = false;
    mode = pendingDrawData.mode;
    spreadKey = pendingDrawData.spread;
  } else {
    clearPending();
  }
}
// Visual "pick cards" fan + Bible flip for anonymous visitors (daily-
// reflection style). The shuffled deck order is embedded in the form; the
// visitor's picks index into it, so the cards they choose are the cards they
// get. Bible mode needs no picking — one flip draws the verses.
const showFan = !registered && !pendingCards && !pendingVerses;
const showBibleFlip = showFan;
// Shuffled deck order for the fan: the visitor's picks index into it, so the
// cards they choose are the cards they get.
const fanOrder = showFan
  ? (() => {
      const names = getTarotDeck().map((c) => c.en);
      for (let i = names.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [names[i], names[j]] = [names[j], names[i]];
      }
      return names;
    })()
  : [];
// Slot position labels per multi-card spread, consumed by the fan script.
const fanPositionData = {
  '3card': SPREADS['3card'].positions[lang],
  celtic_cross: SPREADS['celtic_cross'].positions[lang],
};

// Copy for the pending (locked) view, mode-aware.
const pendingIsBible = pendingVerses !== null;
const pendingCount = pendingIsBible ? pendingVerses!.length : pendingCards?.length ?? 0;
const pendingTitle = pendingIsBible
  ? (lang === 'zh' ? '你翻到的经文' : 'Your Bible verses')
  : pendingCount === 10
    ? (lang === 'zh' ? '你的十张牌' : 'Your ten cards')
    : (lang === 'zh' ? '你的三张牌' : 'Your three cards');
const pendingSpreadName = pendingSpreadKey
  ? (pendingIsBible ? BIBLE_SPREADS[pendingSpreadKey]?.name[lang] : SPREADS[pendingSpreadKey]?.name[lang])
  : null;
const gateCopy = {
  title: pendingIsBible
    ? (lang === 'zh' ? '经文已翻开 — 免费注册即可查看解读' : 'Your verses are ready — register free to reveal the reading')
    : (lang === 'zh' ? '完整解读已就绪 — 免费注册即可揭晓' : 'Your full reading is ready — register free to reveal it'),
  text: pendingIsBible
    ? (lang === 'zh'
        ? '注册后即可查看这些经文如何回应你的问题，新账号还赠送体验额度。'
        : "Register to see what these verses say about your question — new accounts get free welcome credits.")
    : (lang === 'zh'
        ? '注册后立即查看每张牌的含义与整体解读，新账号还赠送体验额度。'
        : "Register to reveal every card's meaning and the overall reading — new accounts get free welcome credits."),
  modalText: pendingIsBible
    ? (lang === 'zh' ? '免费注册账号，看看这些经文想对你说什么。' : 'Create a free account to see what these verses are saying to you.')
    : (lang === 'zh' ? '免费注册账号，立即揭晓牌卡想对你说的话。' : 'Create a free account to reveal what your cards are telling you.'),
  modalReveal: pendingIsBible
    ? (lang === 'zh' ? '查看针对问题的经文解读' : 'Reveal the reading for your question')
    : (lang === 'zh' ? '揭晓本次抽牌的完整解读' : 'Reveal the full reading'),
};

// "Real Bible page" context for the pending Bible view: drawn verses embedded
// in their chapters with neighbouring verses. Position labels for the tags.
const biblePages = pendingIsBible && pendingVerses ? buildBiblePages(pendingVerses) : [];
const pendingPositionLabels = pendingSpreadKey
  ? ((pendingIsBible ? BIBLE_SPREADS[pendingSpreadKey] : SPREADS[pendingSpreadKey])?.positions[lang] ?? [])
  : [];
const pendingButtonLabel = lang === 'zh'
  ? (pendingIsBible ? '解经' : '解读')
  : 'Interpret';

const currentTier: Tier = await resolveTier(loggedInUserId ?? Astro.cookies.get('user_id')?.value ?? '');

// Usage + perk display data
const displayUserId = loggedInUserId ?? Astro.cookies.get('user_id')?.value ?? '';
const usedToday = displayUserId ? await getTodayUsage(displayUserId) : 0;
const dailyLimit = registered ? QUOTA[currentTier] : ANON_DAILY_DRAWS;
const creditBalance = registered ? await getCreditBalance(loggedInUserId!) : null;

const fmtLimit = (n: number): string =>
  n === Infinity ? (lang === 'zh' ? '无限' : 'unlimited') : String(n);

interface SpreadCardView {
  key: string;
  number: number;
  name: string;
  desc: string;
  locked: boolean;
  badge: string | null;
  badgeTrial: boolean;
  goto: string;
}

// Same tier/quota gates for tarot and Bible verse spreads — access is keyed
// by spread key, which both modes share.
const buildSpreadView = (
  key: string,
  s: { number: number; name: Record<Lang, string>; description: Record<Lang, string> }
): SpreadCardView => {
  let locked = false;
  let badge: string | null = null;
  let badgeTrial = false;
  let goto = '/pricing';
  if (currentTier === 'free') {
    if (key !== 'single') {
      if (!registered) {
        if (key === '3card' || key === 'celtic_cross') {
          // Draw-to-reveal: anonymous visitors may draw (cards or verses);
          // registering reveals the reading.
          locked = false;
          badge = lang === 'zh' ? '免费' : 'Free draw';
          badgeTrial = true;
        } else {
          // Anonymous visitors: registering unlocks trial credits for this spread.
          locked = true;
          badge = SPREAD_ACCESS.basic.includes(key) ? 'Basic' : 'Pro';
          goto = '/signup';
        }
      } else {
        const remaining = (creditBalance as unknown as Record<string, number>)[key] ?? 0;
        if (remaining > 0) {
          badge = lang === 'zh' ? `体验 ×${remaining}` : `Trial ×${remaining}`;
          badgeTrial = true;
        } else {
          locked = true;
          badge = 'Basic';
          goto = '/pricing';
        }
      }
    }
  } else {
    locked = !SPREAD_ACCESS[currentTier].includes(key);
    if (locked) badge = SPREAD_ACCESS.basic.includes(key) ? 'Basic' : 'Pro';
  }
  return {
    key,
    number: s.number,
    name: s.name[lang],
    desc: s.description[lang],
    locked,
    badge,
    badgeTrial,
    goto,
  };
};

const tarotSpreadViews: SpreadCardView[] = Object.entries(SPREADS).map(([key, s]) => buildSpreadView(key, s));
const bibleSpreadViews: SpreadCardView[] = Object.entries(BIBLE_SPREADS).map(([key, s]) => buildSpreadView(key, s));

const resultCount = cards?.length ?? verses?.length ?? 0;
const isBible = mode === 'bible';

// Assistant widget context: what reading is currently on screen (design:
// docs/superpowers/specs/2026-09-01-web-assistant-design.md, section 3).
// Hidden interpretations (gated draws) are passed as '' - the assistant is
// instructed not to invent them.
const hasReading = !!(cards || verses);
const assistantReading = hasReading
  ? {
      mode,
      spread: (mode === 'bible' ? BIBLE_SPREADS[spreadKey] : SPREADS[spreadKey])?.name?.[lang] ?? spreadKey,
      question: isDefaultQuestion ? '' : question,
      items: (mode === 'bible' ? verses ?? [] : cards ?? []).map((c) =>
        'refEn' in c
          ? { name: `${c.refEn} (${c.refZh})`, position: c.position ?? '', reversed: false, interp: c.interp_text ?? '' }
          : { name: `${c.en} (${c.zh})`, position: c.position ?? '', reversed: c.reversed === true, interp: c.interp_text ?? '' }
      ),
    }
  : null;
const assistantContextJson = JSON.stringify(assistantReading).replace(/</g, '\\u003c');

const title = lang === 'zh'
  ? '自我启发 韦特塔罗 — AI 塔罗牌在线解读'
  : 'Inspiration Tarot — Free AI Tarot Card Reading Online';
const description = lang === 'zh'
  ? '免费 AI 塔罗牌在线解读：支持单张牌、三张牌阵、凯尔特十字等经典牌阵，帮你探索事业、感情与人生方向。中英双语可用。'
  : 'Get a free AI-powered tarot reading online. Choose from single card, 3-card spread, or Celtic Cross. Explore love, career, and life guidance — available in English and Chinese.';
---
<Layout title={title} description={description} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Inspiration Tarot",
    "alternateName": "自我启发 韦特塔罗",
    "url": "https://dramatherapy.us",
    "description": description,
    "inLanguage": [lang, lang === 'zh' ? 'en' : 'zh'],
    "applicationCategory": "EntertainmentApplication",
    "offers": [
      { "@type": "Offer", "name": "Free", "price": "0", "priceCurrency": "USD", "description": "3–6 single-card tarot readings per day, plus trial credits for multi-card spreads" },
      { "@type": "Offer", "name": "Basic", "price": "4.99", "priceCurrency": "USD", "description": "Single and 3-card tarot spreads, 20 readings per day, full history" },
      { "@type": "Offer", "name": "Pro", "price": "11.99", "priceCurrency": "USD", "description": "All tarot spreads including Celtic Cross, unlimited readings, full history" }
    ]
  })}>
  </script>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Inspiration Tarot",
    "url": "https://dramatherapy.us",
    "inLanguage": ["en", "zh"]
  })}>
  </script>

  <div class="loading-overlay" id="loading-overlay">
    <div class="loading-content">
      <div class="loading-spinner"></div>
