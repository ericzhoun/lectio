---
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import { SPREADS, DEFAULT_QUESTIONS, type Lang } from '../lib/reading';
import {
  PENDING_DRAW_COOKIE, createPendingDrawToken, verifyPendingDrawToken,
  type PendingDrawSpread,
} from '../lib/pendingDraw';
import { drawVerses, rebuildDrawnVerses, buildBiblePages, type DrawnVerse } from '../lib/scripture';
import { generateInterpretation, generateFollowUpQuestions } from '../lib/openai';
import { performDraw } from '../lib/draw';
import { logReading, getReadingRendering, saveReadingRendering } from '../lib/db';
import {
  LAST_READING_COOKIE, createLastReadingToken, verifyLastReadingToken,
} from '../lib/lastReading';
import { env } from 'cloudflare:workers';
import { verifySessionToken } from '../lib/session';
import {
  canDraw, recordDraw, resolveTier, SPREAD_ACCESS, QUOTA, ANON_DAILY_DRAWS,
  type Tier,
} from '../lib/entitlements';
import { getCreditBalance } from '../lib/credits';
import { getTodayUsage } from '../lib/usage';
import { resolveLang } from '../lib/i18n';
import { getLectionaryDay, focusReference } from '../lib/lectionary';
import { resolvePassage } from '../lib/passage';
import { resolveLocalDay } from '../lib/localDay';
import lectionaryDays from '../lib/lectionaryDays.json';

const url = Astro.url;
const lang = resolveLang(Astro);

const sessionCookie = Astro.cookies.get('session')?.value;
const loggedInUserId = sessionCookie ? await verifySessionToken(sessionCookie, env.SESSION_SECRET) : null;

let question = '';
let isDefaultQuestion = false;
let verses: DrawnVerse[] | null = null;
let interpretation = '';
let followUpQuestions: string[] = [];
let spreadKey = url.searchParams.get('spread') ?? 'single';
if (!(spreadKey in SPREADS)) spreadKey = 'single';
let error: string | null = null;
let upsellReason: 'quota' | 'spread_locked' | 'no_credits' | null = null;
// "Read now, register to reveal" state: verses that have been received but
// whose reflection is still locked (anonymous visitor, or a registered
// visitor whose reveal is not possible yet).
let pendingVerses: DrawnVerse[] | null = null;
let pendingSpreadKey: '3card' | 'celtic_cross' | null = null;
// Pending gate state. Object holder on purpose: every assignment happens
// inside closures (applyReveal / draw branches), and a plain let narrowed by
// control-flow analysis confuses the template comparisons below.
const pendingGateState: {
  gate: 'action' | 'credits' | 'quota' | 'locked' | 'retry' | null;
} = { gate: null };
const registered = loggedInUserId !== null;

// Pending draw cookie (read before the POST branch — the reveal flow needs it).
// A pending draw is an anonymous reading whose reflection is still locked:
// the verses are shown inside their chapter, and the 解经 button starts the
// reveal (registration for anonymous visitors, or the reflection itself for
// registered ones).
const pendingToken = Astro.cookies.get(PENDING_DRAW_COOKIE)?.value;
const pendingDrawData = await verifyPendingDrawToken(pendingToken, env.SESSION_SECRET);
const clearPending = () => Astro.cookies.delete(PENDING_DRAW_COOKIE, { path: '/' });
const pendingSpreadMeta = pendingDrawData ? SPREADS[pendingDrawData.spread] : undefined;

// Rebuild the drawn verses for display, with position labels in the current
// language. Returns null for a corrupt payload (wrong count, unknown refs).
const rebuildPending = (): DrawnVerse[] | null => {
  if (!pendingDrawData || !pendingSpreadMeta) return null;
  const rebuilt = rebuildDrawnVerses(pendingDrawData.verses);
  if (rebuilt.length !== pendingSpreadMeta.number) return null;
  const positions = pendingSpreadMeta.positions[lang];
  rebuilt.forEach((v, i) => { v.position = positions[i] ?? ''; });
  return rebuilt;
};

// Remember the finished reading: the signed cookie carries its identity, and
// the language-specific reflection is cached so switching languages (or a
// reload) costs at most one regeneration per language and never a credit.
const rememberReading = async (
  id: string,
  spread: string,
  q: string,
  drawn: DrawnVerse[],
  summary: string,
  followUps: string[]
): Promise<void> => {
  const token = await createLastReadingToken(
    { v: 1, id, spread, question: q, verses: drawn.map((v) => v.refEn), ts: Date.now() },
    env.SESSION_SECRET
  );
  Astro.cookies.set(LAST_READING_COOKIE, token, {
    path: '/',
    httpOnly: true,
    sameSite: 'lax',
    secure: true,
    maxAge: 60 * 60 * 24 * 7,
  });
  await saveReadingRendering(id, lang, {
    summary,
    cards: drawn.map((v) => ({ text: v.interp_text ?? '', tags: v.tags ?? [] })),
    followUps,
  });
};

// Run the reveal (button-driven): generate the question-based interpretation
// for the pending draw, spend the matching credit, log, and clear the cookie.
// Failure modes set a gate variant (credits / quota / locked / retry) and
// keep the cookie so a later attempt still works.
const applyReveal = async (): Promise<void> => {
  if (!pendingDrawData || !pendingSpreadMeta || !registered || !loggedInUserId) return;
  const revealEntitlement = await canDraw(loggedInUserId, pendingDrawData.spread, true);
  const pending = rebuildPending();
  if (!pending) {
    clearPending();
    return;
  }
  if (!revealEntitlement.ok) {
    pendingGateState.gate =
      revealEntitlement.reason === 'no_credits' ? 'credits'
      : revealEntitlement.reason === 'quota' ? 'quota'
      : 'locked';
    pendingVerses = pending;
    pendingSpreadKey = pendingDrawData.spread;
    question = pendingDrawData.question;
    isDefaultQuestion = false;
    return;
  }
  try {
    const interp = await generateInterpretation(pendingDrawData.question, pending, lang, pendingDrawData.spread);
    pending.forEach((v, i) => {
      v.interp_text = interp.cards[i]?.text ?? '';
      v.tags = interp.cards[i]?.tags ?? [];
    });
    interpretation = interp.summary;
    const followUpContext = interpretation || pending.map((v) => v.interp_text).join(' ');
    followUpQuestions = await generateFollowUpQuestions(pendingDrawData.question, followUpContext, lang);
    const ipHeader = Astro.request.headers.get('x-forwarded-for');
    const ipAddress = ipHeader
      ? ipHeader.split(',')[0].trim()
      : Astro.request.headers.get('cf-connecting-ip');
    await logReading(
      pendingDrawData.question,
      pending.map((v) => ({ en: v.refEn, zh: v.refZh })),
      interpretation,
      ipAddress,
      loggedInUserId
    );
    await recordDraw(loggedInUserId, pendingDrawData.spread, true);
    question = pendingDrawData.question;
    isDefaultQuestion = false;
    verses = pending;
    spreadKey = pendingDrawData.spread;
    clearPending();
    await rememberReading(
      crypto.randomUUID(), pendingDrawData.spread, pendingDrawData.question,
      pending, interpretation, followUpQuestions
    );
  } catch (e) {
    // Reflection failed (e.g. LLM outage) — keep the pending cookie so a
    // reload can retry without spending the credit again.
    console.error('Reveal interpretation failed:', e);
    pendingVerses = pending;
    pendingSpreadKey = pendingDrawData.spread;
    pendingGateState.gate = 'retry';
    question = pendingDrawData.question;
    isDefaultQuestion = false;
  }
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  question = String(form.get('question') ?? '');

  if (form.get('reveal_pending') === '1') {
    // Button-driven reveal (解经 / 解读). Anonymous visitors never submit
    // this form — they see the registration modal instead.
    await applyReveal();
  } else if (!question) {
    error = lang === 'zh' ? '请输入问题' : 'Please enter a question';
  } else {
    // user id, persisted via cookie (replaces Flask session)
    let userId = Astro.cookies.get('user_id')?.value;
    if (!userId) {
      userId = crypto.randomUUID();
      Astro.cookies.set('user_id', userId, { path: '/', httpOnly: true });
    }

    const ipHeader = Astro.request.headers.get('x-forwarded-for');
    const ipAddress = ipHeader
      ? ipHeader.split(',')[0].trim()
      : Astro.request.headers.get('cf-connecting-ip');

    spreadKey = String(form.get('spread') ?? 'single');
    if (!(spreadKey in SPREADS)) spreadKey = 'single';

    const entitlementUserId = loggedInUserId ?? userId;
    const entitlement = await canDraw(entitlementUserId, spreadKey, registered);
    const spread = SPREADS[spreadKey] ?? SPREADS.single;

    if (!entitlement.ok) {
      upsellReason = entitlement.reason;
    } else if (entitlement.gated) {
      // Anonymous "open the Bible to reveal" flow: draw the verses now and
      // show the scripture for free; the question-based reflection stays
      // locked until registration. The reveal afterwards consumes a trial
      // credit. No quota is spent here.
      const drawnVerses = drawVerses(spread.number);
      const positions = spread.positions[lang];
      drawnVerses.forEach((v, i) => { v.position = positions[i] ?? ''; });
      const token = await createPendingDrawToken(
        {
          v: 1,
          spread: spreadKey as PendingDrawSpread,
          question,
          verses: drawnVerses.map((v) => v.refEn),
          ts: Date.now(),
        },
        env.SESSION_SECRET
      );
      Astro.cookies.set(PENDING_DRAW_COOKIE, token, {
        path: '/',
        httpOnly: true,
        sameSite: 'lax',
        secure: true,
        maxAge: 60 * 60 * 24 * 7,
      });
      pendingVerses = drawnVerses;
      pendingSpreadKey = spreadKey as PendingDrawSpread;
      pendingGateState.gate = 'action';
      // The pending draw is now the reading on screen; drop the previous one.
      Astro.cookies.delete(LAST_READING_COOKIE, { path: '/' });
    } else {
      const outcome = await performDraw({
        question, spreadKey, lang,
        userId: entitlementUserId, registered, ipAddress,
      });
      if (outcome.kind === 'reading') {
        verses = outcome.verses;
        interpretation = outcome.summary;
        followUpQuestions = outcome.followUps;
        await rememberReading(
          outcome.readingId, outcome.spreadKey, question, verses, interpretation, followUpQuestions
        );
      } else if (outcome.kind === 'blocked') {
        upsellReason = outcome.reason as 'quota' | 'spread_locked' | 'no_credits';
      }
    }
  }
} else {
  const preservedQuestion = url.searchParams.get('question');
  if (preservedQuestion) {
    question = preservedQuestion;
    isDefaultQuestion = false;
  } else {
    const defaults = DEFAULT_QUESTIONS[lang];
    let idx = Number(Astro.cookies.get('question_index')?.value ?? Math.floor(Math.random() * defaults.length));
    if (Number.isNaN(idx) || idx < 0 || idx >= defaults.length) idx = 0;
    question = defaults[idx];
    Astro.cookies.set('question_index', String((idx + 1) % defaults.length), { path: '/' });
    isDefaultQuestion = true;
  }
}

// Pending view setup: when a valid pending draw exists and no fresh reading
// is being shown, render the verses with the 解经 action. The reveal itself is
// button-driven — anonymous visitors get the registration modal on click;
// registered ones submit the reveal form.
if (pendingDrawData && pendingSpreadMeta && !verses && !pendingGateState.gate) {
  const pending = rebuildPending();
  if (pending) {
    pendingVerses = pending;
    pendingSpreadKey = pendingDrawData.spread;
    pendingGateState.gate = 'action';
    question = pendingDrawData.question;
    isDefaultQuestion = false;
    spreadKey = pendingDrawData.spread;
  } else {
    clearPending();
  }
}

// Restore the last finished reading on a GET. The reading itself is produced
// inside a POST, so without this a reload — or the nav language switch, which
// is a plain GET — would drop the visitor back on an empty form. The verses
// are rebuilt from their refs in the active language; the reflection is taken
// from the per-language cache, and generated once per language on a miss. No
// credit and no quota are spent: the reading was already paid for.
const startingOver = url.searchParams.get('new') === '1';
if (startingOver) Astro.cookies.delete(LAST_READING_COOKIE, { path: '/' });

const canRestore =
  Astro.request.method !== 'POST' && !startingOver &&
  !verses && !pendingVerses && !pendingGateState.gate && !error && !upsellReason;

if (canRestore) {
  const last = await verifyLastReadingToken(
    Astro.cookies.get(LAST_READING_COOKIE)?.value,
    env.SESSION_SECRET
  );
  const lastSpread = last ? SPREADS[last.spread] : undefined;
  const restored = last ? rebuildDrawnVerses(last.verses) : [];
  if (last && lastSpread && restored.length === lastSpread.number) {
    const positions = lastSpread.positions[lang];
    restored.forEach((v, i) => { v.position = positions[i] ?? ''; });

    let rendering = await getReadingRendering(last.id, lang);
    if (!rendering) {
      try {
        const interp = await generateInterpretation(last.question, restored, lang, last.spread);
        const followUpContext = interp.summary || interp.cards.map((c) => c.text).join(' ');
        rendering = {
          summary: interp.summary,
          cards: interp.cards,
          followUps: await generateFollowUpQuestions(last.question, followUpContext, lang),
        };
        await saveReadingRendering(last.id, lang, rendering);
      } catch (e) {
        // Re-rendering failed (e.g. LLM outage). Show the verses anyway —
        // losing the reflection is better than losing the reading.
        console.error('Re-rendering reading in ' + lang + ' failed:', e);
        rendering = null;
      }
    }

    restored.forEach((v, i) => {
      v.interp_text = rendering?.cards[i]?.text ?? '';
      v.tags = rendering?.cards[i]?.tags ?? [];
    });
    verses = restored;
    interpretation = rendering?.summary ?? '';
    followUpQuestions = rendering?.followUps ?? [];
    question = last.question;
    isDefaultQuestion = false;
    spreadKey = last.spread;
  } else if (last) {
    Astro.cookies.delete(LAST_READING_COOKIE, { path: '/' });
  }
}

// The "open the Bible" panel is the anonymous entry point into a multi-verse
// layout: one gesture receives the verses, registration reveals the reading.
const showOpenPanel = !registered && !pendingVerses;

// Copy for the pending (locked) view.
const pendingCount = pendingVerses?.length ?? 0;
const pendingTitle = lang === 'zh' ? '你领受的经文' : 'The verses you received';
const pendingSpreadName = pendingSpreadKey ? SPREADS[pendingSpreadKey]?.name[lang] : null;
const gateCopy = {
  modalText: lang === 'zh'
    ? '免费注册账号，看看这些经文想对你说什么。'
    : 'Create a free account to see what these verses are saying to you.',
  modalReveal: lang === 'zh'
    ? '查看针对问题的经文默想'
    : 'Reveal the reflection for your question',
};

// "Real Bible page" context for the pending view: verses embedded in their
// chapters with neighbouring verses. Position labels for the tags.
const biblePages = pendingVerses ? buildBiblePages(pendingVerses) : [];
const pendingPositionLabels = pendingSpreadKey
  ? (SPREADS[pendingSpreadKey]?.positions[lang] ?? [])
  : [];
const pendingButtonLabel = lang === 'zh' ? '默想' : 'Reflect';

const currentTier: Tier = await resolveTier(loggedInUserId ?? Astro.cookies.get('user_id')?.value ?? '');

// Usage + perk display data
const displayUserId = loggedInUserId ?? Astro.cookies.get('user_id')?.value ?? '';
const usedToday = displayUserId ? await getTodayUsage(displayUserId) : 0;
const dailyLimit = registered ? QUOTA[currentTier] : ANON_DAILY_DRAWS;
const creditBalance = registered ? await getCreditBalance(loggedInUserId!) : null;

const fmtLimit = (n: number): string =>
  n === Infinity ? (lang === 'zh' ? '无限' : 'unlimited') : String(n);

interface SpreadCardView {
  key: string;
  number: number;
  name: string;
  desc: string;
  locked: boolean;
  badge: string | null;
  badgeTrial: boolean;
  goto: string;
}

// Tier/quota gates, keyed by layout key.
const buildSpreadView = (
  key: string,
  s: { number: number; name: Record<Lang, string>; description: Record<Lang, string> }
): SpreadCardView => {
  let locked = false;
  let badge: string | null = null;
  let badgeTrial = false;
  let goto = '/pricing';
  if (currentTier === 'free') {
    if (key !== 'single') {
      if (!registered) {
        if (key === '3card' || key === 'celtic_cross') {
          // Read-to-reveal: anonymous visitors may receive the verses;
          // registering reveals the reflection.
          locked = false;
          badge = lang === 'zh' ? '免费' : 'Free';
          badgeTrial = true;
        } else {
          // Anonymous visitors: registering unlocks trial credits for this layout.
          locked = true;
          badge = SPREAD_ACCESS.basic.includes(key) ? 'Basic' : 'Pro';
          goto = '/signup';
        }
      } else {
        const remaining = (creditBalance as unknown as Record<string, number>)[key] ?? 0;
        if (remaining > 0) {
          badge = lang === 'zh' ? `体验 ×${remaining}` : `Trial ×${remaining}`;
          badgeTrial = true;
        } else {
          locked = true;
          badge = 'Basic';
          goto = '/pricing';
        }
      }
    }
  } else {
    locked = !SPREAD_ACCESS[currentTier].includes(key);
    if (locked) badge = SPREAD_ACCESS.basic.includes(key) ? 'Basic' : 'Pro';
  }
  return {
    key,
    number: s.number,
    name: s.name[lang],
    desc: s.description[lang],
    locked,
    badge,
    badgeTrial,
    goto,
  };
};

const spreadViews: SpreadCardView[] = Object.entries(SPREADS).map(([key, s]) => buildSpreadView(key, s));

const resultCount = verses?.length ?? 0;

// ── The sanctuary: verse of the day, season, and reading plans ─────────────
// The reader's local day (tz cookie, UTC fallback) picks the lectionary entry,
// the same source the /today walk uses, so the hero and the practice agree.
const day = resolveLocalDay(Astro);
const entry = getLectionaryDay(day);

// Short, contemplative excerpt for the hero slides.
const excerpt = (text: string, max: number): string => {
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  const at = lang === 'zh' ? cut.length : Math.max(cut.lastIndexOf(' '), 40);
  return `${cut.slice(0, at).replace(/[,;:.\s]+$/, '')}…`;
};

// The BCP lists morning psalms as bare numbers ("41, 52") — normalize the
// first one into a reference resolvePassage understands.
const psalmRef = (slot: string | null): string | null => {
  if (!slot) return null;
  const first = slot.split(',')[0]?.trim();
  return /^\d+(:\d+(-\d+)?)?$/.test(first) ? `Psalm ${first}` : null;
};

// Up to three slides from the day's readings: the focus, then epistle, then
// psalm. A slot the bundled chapter store cannot resolve is skipped, not
// broken; if none resolve the hero still speaks with a fixed word.
const heroSources = [
  focusReference(entry),
  entry.readings.epistle,
  psalmRef(entry.readings.psalmsMorning),
];
const heroVerses: Array<{ ref: string; text: string }> = [];
for (const ref of heroSources) {
  if (!ref || heroVerses.length >= 3) continue;
  const passage = resolvePassage(ref, lang);
  if (passage) {
    heroVerses.push({ ref: passage.ref, text: excerpt(passage.text, lang === 'zh' ? 110 : 210) });
  }
}
if (heroVerses.length === 0) {
  const fallback = resolvePassage('Matthew 11:28-30', lang);
  if (fallback) heroVerses.push({ ref: fallback.ref, text: excerpt(fallback.text, lang === 'zh' ? 110 : 210) });
}

// Season runs across the whole lectionary table: one pass gives every
// season's real start and end, which the plans use for their quiet progress.
interface SeasonRun { season: string; start: string; end: string; }
const dayTable = lectionaryDays as unknown as Record<string, { season: string }>;
const seasonRuns: SeasonRun[] = [];
for (const d of Object.keys(dayTable).sort()) {
  const last = seasonRuns[seasonRuns.length - 1];
  if (last && last.season === dayTable[d].season) last.end = d;
  else seasonRuns.push({ season: dayTable[d].season, start: d, end: d });
}
const runFor = (season: string): SeasonRun | null =>
  seasonRuns.find((r) => r.season === season && r.end >= day) ?? null;

const fmtDay = (iso: string): string => {
  const dt = new Date(`${iso}T00:00:00Z`);
  return lang === 'zh'
    ? `${dt.getUTCMonth() + 1}月${dt.getUTCDate()}日`
    : dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
};

interface PlanView {
  season: string;
  marker: string;
  name: string;
  tagline: string;
  description: string;
  context: string;
  prompts: string[];
  inSeason: boolean;
  progressLabel: string;
  progressPct: number;
  // The passage the season opens on: the focus reading of its first day.
  verseRef: string | null;
}

const PLAN_COPY: Array<Omit<PlanView, 'inSeason' | 'progressLabel' | 'progressPct' | 'verseRef'>> = [
  {
    season: 'advent', marker: 'I',
    name: lang === 'zh' ? '将临之光' : 'The Coming Light',
    tagline: lang === 'zh' ? '四个星期的守望与等候' : 'Four weeks of watching and waiting',
    description: lang === 'zh'
      ? '教会年历从等候开始。经文沿以赛亚书与福音书走向破晓——先知应许，马利亚反复思想，世界在昏暗中侧耳。'
      : 'The church year opens with the ache of waiting: prophets promising, Mary pondering, a world dim and listening. The readings walk Isaiah and the Gospels toward the dawn.',
    context: lang === 'zh'
      ? '将临期约为十一月末至圣诞前的四个星期，"将临"意为"即将来临"。'
      : 'Advent spans the four weeks before Christmas; the name simply means "coming."',
    prompts: lang === 'zh'
      ? ['有什么盼望，你还未说出口？', '光已经从哪里悄悄进来？', '「守望」与「赶路」有什么不同？']
      : ['What are you waiting for that you have not said aloud?', 'Where is light already entering — quietly?', 'What would it mean to keep watch, rather than to hurry?'],
  },
  {
    season: 'christmas', marker: 'II',
    name: lang === 'zh' ? '道成肉身' : 'The Word Made Flesh',
    tagline: lang === 'zh' ? '停留在伯利恒的十二天' : 'Twelve days at the manger',
    description: lang === 'zh'
      ? '十二天的圣诞期不催促任何决定，只有抵达。约翰福音的序言与婴孩叙事，把敬畏安放在马槽边。'
      : 'The twelve days of Christmas sit still at the incarnation — no resolutions, only arrival. John\'s prologue and the infancy narratives carry the awe.',
    context: lang === 'zh'
      ? '圣诞期从12月25日到1月5日，是年历中第一个「庆典之季」。'
      : 'Christmastide runs December 25 to January 5 — the year\'s first festival season.',
    prompts: lang === 'zh'
      ? ['「不平常」此刻藏在你生活的哪个「平常」里？', '有什么事不打招呼就「抵达」了你的生命？', '慢慢读约翰福音 1:14，哪个词留下了？']
      : ['Where does the extraordinary hide inside your ordinary?', 'What has arrived in your life unannounced?', 'Read John 1:14 slowly. Which word stays?'],
  },
  {
    season: 'epiphany', marker: 'III',
    name: lang === 'zh' ? '显现之光' : 'Light for the Nations',
    tagline: lang === 'zh' ? '星辰、河水与婚宴' : 'A star, a river, a wedding',
    description: lang === 'zh'
      ? '显现期跟随基督一次次「显明」的痕迹：博士来拜、约旦河的水、迦拿的酒。寻常的场景一扇扇变成门。'
      : 'Epiphany trails the showings of Christ — magi at the manger, the Jordan waters, wine at Cana. Ordinary scenes become doors.',
    context: lang === 'zh'
      ? '「显现」（Epiphany）意为「显明」，从1月6日基督显现日起，延续数周。'
      : '"Epiphany" means showing: the season begins January 6 and runs for weeks.',
    prompts: lang === 'zh'
      ? ['你身边哪个寻常场景，其实是一扇门？', '光正照向你的圈子之外的谁？', '写下这个星期的一次「忽然明白」。']
      : ['What ordinary scene is quietly a door?', 'Whom does the light reach beyond your circle?', 'Name one epiphany moment from this week.'],
  },
  {
    season: 'lent', marker: 'IV',
    name: lang === 'zh' ? '旷野之路' : 'The Wilderness Road',
    tagline: lang === 'zh' ? '四十天的诚实之地' : 'Forty days of honest ground',
    description: lang === 'zh'
      ? '大斋期陪着耶稣走进旷野。它不是阴沉的节期，而是一段删繁就简的诚实：当喧闹被放下，还剩下什么。'
      : 'Lent walks Jesus\' forty days into the desert — less a season of gloom than of uncluttered honesty: what remains when the noise is set down.',
    context: lang === 'zh'
      ? '大斋期从圣灰日起四十余天，止于复活节前的圣周。'
      : 'Lent runs from Ash Wednesday through Holy Week, forty days and more before Easter.',
    prompts: lang === 'zh'
      ? ['放下哪一件事，能为你腾出空间？', '你正被带往哪个自己不会选择的地方？', '写下你一直在回避的那句祷告。']
      : ['What one thing, set down, would make room?', 'Where are you being led that you would not choose?', 'Write the prayer you have been avoiding.'],
  },
  {
    season: 'easter', marker: 'V',
    name: lang === 'zh' ? '复活五十日' : 'Fifty Days of Light',
    tagline: lang === 'zh' ? '最长的庆典' : 'The longest festival',
    description: lang === 'zh'
      ? '复活期拒绝匆忙：五十天的显现、开门的锁屋、岸边的鱼与火。喜乐得到它所需要的空间。'
      : 'Eastertide refuses to hurry: fifty days of appearances, locked rooms opening, fish on a shore. Joy is given the space it needs.',
    context: lang === 'zh'
      ? '复活期五十天，从复活日到圣灵降临日，是年历中最长的庆典。'
      : 'Eastertide lasts fifty days, from the resurrection to Pentecost — the calendar\'s longest feast.',
    prompts: lang === 'zh'
      ? ['谁在背后叫你的名字，让生命回转？', '你哪一间「锁着的屋子」正在被打开？', '五十天的喜乐会如何改变你的节奏？']
      : ['Where is life standing behind you, saying your name?', 'What locked room of yours is being opened?', 'How would fifty days of joy change your pace?'],
  },
  {
    season: 'pentecost', marker: 'VI',
    name: lang === 'zh' ? '漫长的绿季' : 'The Long Green Season',
    tagline: lang === 'zh' ? '平常日子，不平常的生长' : 'Ordinary time, extraordinary growth',
    description: lang === 'zh'
      ? '圣灵降临之后，年历转绿。这是最长的一段「平常时间」——生活大部分发生在这里，诗篇与比喻慢慢做工。'
      : 'After Pentecost the calendar turns green. This long ordinary season is where most of life happens; the psalms and parables do their slow work.',
    context: lang === 'zh'
      ? '圣灵降临期从初夏延续到将临期前，占年历近一半，礼仪颜色是绿。'
      : 'Pentecost runs from early summer to the edge of Advent, nearly half the year, vested in green.',
    prompts: lang === 'zh'
      ? ['有什么正在你里面生长，却没有人为它鼓掌？', '今天可以重复的一次小小忠信之举是什么？', '在琐碎里，圣灵正在提醒你什么？']
      : ['What is growing in you that no one applauds?', 'Which small, faithful act can you repeat today?', 'Where is the Spirit prompting in the mundane?'],
  },
];

const plans: PlanView[] = PLAN_COPY.map((p) => {
  const run = runFor(p.season);
  const inSeason = entry.season === p.season;
  let progressLabel = '';
  let progressPct = 0;
  if (run) {
    const total = Math.round((Date.parse(`${run.end}T00:00:00Z`) - Date.parse(`${run.start}T00:00:00Z`)) / 86_400_000) + 1;
    if (inSeason && day >= run.start) {
      const nth = Math.round((Date.parse(`${day}T00:00:00Z`) - Date.parse(`${run.start}T00:00:00Z`)) / 86_400_000) + 1;
      progressLabel = lang === 'zh' ? `第 ${nth} 天 · 共 ${total} 天` : `Day ${nth} of ${total}`;
      progressPct = Math.round((nth / total) * 100);
    } else {
      progressLabel = lang === 'zh' ? `${fmtDay(run.start)} 开始` : `begins ${fmtDay(run.start)}`;
    }
  }
  // In season the walk is today's reading; otherwise the season's opening day.
  const verseDay = inSeason ? day : run?.start ?? null;
  const verseRef = verseDay
    ? resolvePassage(focusReference(getLectionaryDay(verseDay)), lang)?.ref ?? null
    : null;
  return { ...p, inSeason, progressLabel, progressPct, verseRef };
});

// Assistant widget context: what reading is currently on screen (design:
// docs/superpowers/specs/2026-09-01-web-assistant-design.md, section 3).
// Hidden interpretations (gated draws) are passed as '' - the assistant is
// instructed not to invent them.
const assistantReading = verses
  ? {
      spread: SPREADS[spreadKey]?.name?.[lang] ?? spreadKey,
      question: isDefaultQuestion ? '' : question,
      items: verses.map((v) => ({
        name: `${v.refEn} (${v.refZh})`,
        position: v.position ?? '',
        interp: v.interp_text ?? '',
      })),
    }
  : null;
const assistantContextJson = JSON.stringify(assistantReading).replace(/</g, '\\u003c');

const title = lang === 'zh'
  ? 'Lectio 圣言诵读 — 每日经文默想'
  : 'Lectio — Daily Scripture Reading and Reflection';
const description = lang === 'zh'
  ? '以圣言诵读（Lectio Divina）的方式领受经文：诵读、默想、祈祷、默观。为你的问题带来一节经文与温柔的默想陪伴，中英双语。'
  : 'Lectio Divina online: receive a scripture passage and sit with it through reading, reflection, response, and rest. Gentle, question-led reflection in English and Chinese.';
---
<Layout title={title} description={description} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "Lectio",
    "alternateName": "Lectio 圣言诵读",
    "url": "https://enjoyhim.org",
    "description": description,
    "inLanguage": [lang, lang === 'zh' ? 'en' : 'zh'],
    "applicationCategory": "LifestyleApplication",
    "offers": [
      { "@type": "Offer", "name": "Free", "price": "0", "priceCurrency": "USD", "description": "3–6 Daily Word readings per day, plus trial credits for the longer layouts" },
      { "@type": "Offer", "name": "Basic", "price": "4.99", "priceCurrency": "USD", "description": "Daily Word and Lectio Divina layouts, 20 readings per day, full history" },
      { "@type": "Offer", "name": "Pro", "price": "11.99", "priceCurrency": "USD", "description": "All layouts including Deep Lectio, unlimited readings, full history" }
    ]
  })}>
  </script>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Lectio",
    "url": "https://enjoyhim.org",
    "inLanguage": ["en", "zh"]
  })}>
  </script>

  <section class="sanctuary-hero" aria-labelledby="sanctuary-name">
    <div class="hero-breath" aria-hidden="true"></div>
    <img src="/logo.webp" alt="" class="site-logo" width="512" height="512" />
    <h1 class="sanctuary-name" id="sanctuary-name">{lang === 'zh' ? 'Lectio 圣言诵读' : 'Lectio'}</h1>
    <p class="sanctuary-sub">
      {lang === 'zh' ? '一座为默想读经而建的网络小圣所' : 'A quiet house for contemplative scripture reading'}
    </p>

    <div class="verse-of-day">
      <p class="verse-label">{lang === 'zh' ? '今日经文 · 沿教会年历' : 'Verse of the day · from the lectionary'}</p>
      <div class="verse-cycle" id="verse-cycle">
        {heroVerses.map((v, i) => (
          <div class={`verse-slide${i === 0 ? ' shown' : ''}`}>
            <blockquote>&ldquo;{v.text}&rdquo;</blockquote>
            <p class="verse-ref">{v.ref}</p>
          </div>
        ))}
      </div>
    </div>

    <a class="begin-cta" href="/today" data-event="cta_click" data-event-props='{"slot":"hero_begin"}'>
      {lang === 'zh' ? '开始诵读' : 'Begin Reading'}
    </a>
    <p class="hero-alt">
      <a href="#receive">{lang === 'zh' ? '或者，带着一个问题，领受一节经文' : 'Or bring a question and receive a verse'}</a>
    </p>
  </section>

  <hr class="rule" />

  <section class="paths-section" aria-labelledby="paths-heading">
    <p class="smallcaps" data-reveal>{lang === 'zh' ? '默观之路' : 'The Contemplative Paths'}</p>
    <h2 class="paths-title" id="paths-heading" data-reveal>{lang === 'zh' ? '四个动作' : 'The Four Movements'}</h2>
    <p class="paths-sub" data-reveal>
      {lang === 'zh'
        ? '圣言诵读不是读法，而是走法——在一段经文里，四个不慌不忙的动作。'
        : 'Lectio Divina is walked, not skimmed — four unhurried movements through one passage.'}
    </p>
    <div class="paths-grid">
      {[
        {
          latin: 'Lectio', name: lang === 'zh' ? '读' : 'Read', anchor: 'lectio',
          desc: lang === 'zh' ? '缓慢地读，直到有一个词亮起来。' : 'Read slowly, again and again, until a word shines.',
        },
        {
          latin: 'Meditatio', name: lang === 'zh' ? '想' : 'Reflect', anchor: 'meditatio',
          desc: lang === 'zh' ? '停在那词上，让它触到你的生活。' : 'Chew on the word that stopped you; let it touch your day.',
        },
        {
          latin: 'Oratio', name: lang === 'zh' ? '应' : 'Respond', anchor: 'oratio',
          desc: lang === 'zh' ? '把浮现的说回去——感谢、疑问、恳求，都算。' : 'Say back what surfaced — thanks, protest, plea, all honest.',
        },
        {
          latin: 'Contemplatio', name: lang === 'zh' ? '息' : 'Rest', anchor: 'contemplatio',
          desc: lang === 'zh' ? '放下言语，只是安静地待着。' : 'Set the words down. Sit with what has been given.',
        },
      ].map((p, i) => (
        <a
          class="path-card"
          href={`/approach#${p.anchor}`}
          data-reveal
          style={`--reveal-delay:${(i * 0.12).toFixed(2)}s`}
        >
          <p class="path-latin">{p.latin}</p>
          <p class="path-name">{p.name}</p>
          <p class="path-desc">{p.desc}</p>
        </a>
      ))}
    </div>
    <p class="paths-more" data-reveal>
      <a href="/library">{lang === 'zh' ? '或先到经文库看看' : 'Or browse the verse library first'}</a>
    </p>
  </section>

  <hr class="rule" />

  <section class="receive-section" id="receive" aria-labelledby="receive-heading">
    <p class="smallcaps" data-reveal>{lang === 'zh' ? '带着一个问题' : 'Bring a Question'}</p>
    <h2 class="receive-title" id="receive-heading" data-reveal>{lang === 'zh' ? '领受一句话' : 'Receive a Word'}</h2>
    <p class="receive-sub" data-reveal>
      {lang === 'zh'
        ? '经文不由你挑选地到来——正因如此，它才有机会说出你原本不会对自己说的话。'
        : 'The verse arrives unbidden — which is exactly why it may say what you would not say to yourself.'}
    </p>

  <form method="post" id="reading-form">
    <div class="suggested-questions">
      <h4>{lang === 'zh' ? '常见话题：' : 'Popular Topics:'}</h4>
      {(lang === 'zh'
        ? ['我该如何面对工作中的这段压力？', '我想在这段关系里学会更好地去爱。', '接下来这段时间，我需要放下什么？', '我该如何在忙碌中安静下来？']
        : [
            'How do I face this season of pressure at work?',
            'I want to learn to love better in this relationship.',
            'What do I need to let go of in the coming weeks?',
            'How can I find stillness in a busy life?',
          ]
      ).map((q) => (
        <div class="follow-up-question" data-question={q}>{q}</div>
      ))}
    </div>

    <div class="question-input">
      <input
        type="text"
        name="question"
        value={question}
        required
        placeholder={lang === 'zh' ? '我想探索的问题是' : 'I want to explore'}
        class={isDefaultQuestion ? 'default-question' : ''}
      />
    </div>

    <p class="quota-line">
      {registered
        ? (lang === 'zh'
            ? `今日已用 ${usedToday} / ${fmtLimit(dailyLimit)} 次`
            : `Used today: ${usedToday} / ${fmtLimit(dailyLimit)}`)
        : (lang === 'zh'
            ? `今日已用 ${usedToday} / ${ANON_DAILY_DRAWS} 次 · 免费注册升至 6 次/天`
            : `Used today: ${usedToday} / ${ANON_DAILY_DRAWS} · register free for 6/day`)}
    </p>

    <div class="spread-picker" id="spread-picker">
      {spreadViews.map((v) => (
        <div
          class={`spread-option ${spreadKey === v.key ? 'selected' : ''} ${v.locked ? 'locked' : ''}`}
          data-spread={v.key}
          data-locked={v.locked ? 'true' : 'false'}
          data-goto={v.locked ? v.goto : undefined}
        >
          <div class="spread-number">{v.number}</div>
          <div class="spread-name">{v.name}</div>
          <div class="spread-desc">{v.desc}</div>
          {v.badge && <span class={`tier-badge ${v.badgeTrial ? 'trial-badge' : ''}`}>{v.badge}</span>}
        </div>
      ))}
    </div>
    {showOpenPanel && (
      <div class="bible-flip-panel hidden" id="bible-flip-panel">
        <p class="bible-flip-title">{lang === 'zh' ? '翻开圣经，领受经文' : 'Flip open the Bible to receive your verses'}</p>
        <button type="submit" class="bible-flip-btn" id="bible-flip-btn">
          <span class="bible-scene" aria-hidden="true">
            <span class="bible-book">
              <span class="bible-book-glow"></span>
              <span class="bible-pageblock">
                <span class="bible-page-face">
                  <span class="bible-page-cross">✦</span>
                  <span class="bible-page-line" style="width:74%"></span>
                  <span class="bible-page-line" style="width:86%"></span>
                  <span class="bible-page-line" style="width:52%"></span>
                </span>
                <span class="bible-leaf l1"><span class="bible-leaf-rot"><span class="bible-leaf-face front"><span class="bible-page-line" style="width:80%"></span><span class="bible-page-line" style="width:60%"></span></span><span class="bible-leaf-face back"></span></span></span>
                <span class="bible-leaf l2"><span class="bible-leaf-rot"><span class="bible-leaf-face front"><span class="bible-page-line" style="width:70%"></span><span class="bible-page-line" style="width:84%"></span></span><span class="bible-leaf-face back"></span></span></span>
                <span class="bible-leaf l3"><span class="bible-leaf-rot"><span class="bible-leaf-face front"><span class="bible-page-line" style="width:88%"></span><span class="bible-page-line" style="width:56%"></span></span><span class="bible-leaf-face back"></span></span></span>
              </span>
              <span class="bible-cover">
                <span class="bible-cover-front"><span class="bible-flip-cross">✝</span></span>
                <span class="bible-cover-back"></span>
              </span>
            </span>
          </span>
          <span class="bible-flip-label">{lang === 'zh' ? '翻开圣经' : 'Flip open the Bible'}</span>
          <span class="visually-hidden" role="status" aria-live="polite" id="bible-flip-status"></span>
        </button>
        <p class="bible-flip-note">
          {lang === 'zh'
            ? '经文免费翻阅 — 注册后即可查看针对你问题的解读'
            : 'Verses are free to reveal — register to read the reflection for your question'}
        </p>
      </div>
    )}
    {showOpenPanel && <div class="bible-veil" id="bible-veil" aria-hidden="true"></div>}
    <input type="hidden" name="spread" id="spread-input" value={spreadKey} />
    <input type="hidden" name="picked" id="picked-input" value="" />

    <p><button type="submit" class="explore-button">{lang === 'zh' ? '开始探索' : 'Explore'}</button></p>
    <button type="button" class="settings-toggle" id="settings-toggle">⚙️ {lang === 'zh' ? '设置' : 'Settings'}</button>

    <div class="settings-menu" id="settings-menu">
      <p>
        <span class="bible-note">
          {lang === 'zh'
            ? '经文随机领受 — 请以默想的心阅读。'
            : 'Verses arrive unbidden. This is contemplative reading, not fortune-telling.'}
        </span>
      </p>
    </div>
  </form>

  <div class="wait-panel" id="wait-panel" hidden role="status" aria-live="polite">
    <p class="wait-title" id="wait-text">
      {lang === 'zh' ? '正在为你领受经文，请稍候...' : 'Receiving your verses, please wait...'}
    </p>
    <div class="teaser-line w85"></div>
    <div class="teaser-line w70"></div>
    <div class="teaser-line w60"></div>
  </div>

  {error && (
    <p class="error">{lang === 'zh' ? '错误:' : 'Error:'} {error}</p>
  )}
  </section>

  {!registered && (
    <div class="register-perk">
      <p class="register-perk-title">{lang === 'zh' ? '免费注册，默想更多经文' : 'Register free, read more'}</p>
      <ul>
        <li>{lang === 'zh' ? '每日经文默想 3 → 6 次' : 'Daily Word readings: 3 → 6 per day'}</li>
        <li>{lang === 'zh' ? '圣言诵读（三节经文）体验额度 ×3' : 'Lectio Divina (3 verses) trial credits ×3'}</li>
        <li>{lang === 'zh' ? '深度诵读（十节经文）体验额度 ×1' : 'Deep Lectio (10 verses) trial credit ×1'}</li>
      </ul>
      <a class="upsell-button" href={`/signup?lang=${lang}`}>
        {lang === 'zh' ? '立即免费注册' : 'Create free account'}
      </a>
    </div>
  )}

  {upsellReason && (
    <div class="upsell-cta">
      <p class="upsell-message">
        {upsellReason === 'spread_locked'
          ? (lang === 'zh'
              ? '此布局为订阅功能 — 免费注册可用体验额度试用'
              : 'This layout is a paid feature — register free to try it with welcome credits')
          : upsellReason === 'no_credits'
            ? (lang === 'zh'
                ? '多节经文体验额度已用完，升级订阅即可继续使用'
                : 'Your trial credits are used up — subscribe to keep using the longer layouts')
            : (registered
                ? (lang === 'zh' ? '今日免费次数已用完' : "You've used today's free readings")
                : (lang === 'zh'
                    ? '今日 3 次免费默想已用完 — 注册后每天 6 次'
                    : "You've used today's 3 free readings — register for 6 per day"))}
      </p>
      <div class="upsell-actions">
        {!registered && upsellReason !== 'no_credits' && (
          <a class="upsell-button" href={`/signup?lang=${lang}`}>
            {lang === 'zh' ? '免费注册' : 'Sign up free'}
          </a>
        )}
        <a class={`upsell-button ${!registered ? 'upsell-button-secondary' : ''}`} href={`/pricing?lang=${lang}`}>
          {lang === 'zh' ? '查看订阅方案' : 'See subscription plans'}
        </a>
      </div>
    </div>
  )}

  {pendingVerses && !verses && (
    <>
      <div class="result-header">
        <h2>{pendingTitle}</h2>
        <p class="result-question">&ldquo;{question}&rdquo;</p>
        <p class="result-spread">
          {pendingSpreadName}
          &middot;
          {lang === 'zh' ? `${pendingCount} 节经文` : `${pendingCount} verse${pendingCount !== 1 ? 's' : ''}`}
        </p>
      </div>
      <section>
        <div class="bible-arrive" id="bible-arrive">
            <div class="bible-arrive-clip">
              <div class="bible-arrive-book" aria-hidden="true">
                <span class="bible-cover">
                  <span class="bible-cover-front"><span class="bible-flip-cross">✝</span></span>
                  <span class="bible-cover-back"></span>
                </span>
              </div>
              <div class="bible-page">
            {biblePages.map((page) => (
              <div class="bible-chapter">
                <h3 class="bible-chapter-heading">
                  {lang === 'zh' ? `${page.bookZh} ${page.chapter}` : `${page.bookEn} ${page.chapter}`}
                  {lang === 'zh' && <span class="bible-chapter-alt">{page.bookEn} {page.chapter}</span>}
                </h3>
                <p class="bible-flow">
                  {page.startsOpen && <span class="bible-ellipsis" aria-hidden="true">…</span>}
                  {page.verses.map((v, i) => (
                    <span class={`bible-verse${v.drawnIndex >= 0 ? ' bible-verse-drawn' : ''}`} style={`--vd:${(1.38 + i * 0.12).toFixed(2)}s`}>
                      <sup class="bible-verse-num">{v.num}</sup>{lang === 'zh' ? v.textZh : v.textEn}
                      {v.drawnIndex >= 0 && v.isRangeStart && pendingPositionLabels[v.drawnIndex] && (
                        <span class="bible-position-tag">{pendingPositionLabels[v.drawnIndex]}</span>
                      )}
                    </span>
                  ))}
                  {page.endsOpen && <span class="bible-ellipsis" aria-hidden="true">…</span>}
                </p>
              </div>
            ))}
            </div>
            </div>
        </div>
        <script is:inline>
          document.querySelectorAll('.bible-arrive').forEach(function (el) { el.classList.add('arrive'); });
        </script>
      </section>
      <section class="interpret-bar">
        {pendingGateState.gate === 'action' && (
          registered ? (
            <form method="post" class="interpret-form" id="interpret-form">
              <input type="hidden" name="reveal_pending" value="1" />
              <button type="submit" class="interpret-button">
                <span class="interpret-star" aria-hidden="true">✦</span> {pendingButtonLabel}
              </button>
              <p class="interpret-hint">
                {lang === 'zh'
                  ? '基于你的问题写下完整默想'
                  : 'Writes the full reflection for your question'}
              </p>
            </form>
          ) : (
            <div class="interpret-form">
              <button type="button" class="interpret-button" id="interpret-btn">
                <span class="interpret-star" aria-hidden="true">✦</span> {pendingButtonLabel}
              </button>
              <p class="interpret-hint">
                {lang === 'zh' ? '免费注册后即可默想' : 'Register free to reflect'}
              </p>
            </div>
          )
        )}
        {pendingGateState.gate === 'credits' && (
          <>
            <h3 class="reveal-gate-title">🔑 {lang === 'zh' ? '体验额度已用完' : 'Trial credits used up'}</h3>
            <p class="reveal-gate-text">
              {lang === 'zh'
                ? '免费体验额度已用完，升级订阅即可默想这次的经文。'
                : 'Your free trial credits are used up — subscribe to reflect on this reading.'}
            </p>
            <div class="upsell-actions">
              <a class="upsell-button" href={`/pricing?lang=${lang}`}>{lang === 'zh' ? '查看订阅方案' : 'See subscription plans'}</a>
            </div>
          </>
        )}
        {pendingGateState.gate === 'quota' && (
          <>
            <h3 class="reveal-gate-title">⏳ {lang === 'zh' ? '今日次数已用完' : 'Daily limit reached'}</h3>
            <p class="reveal-gate-text">
              {lang === 'zh'
                ? '今天的默想次数已用完，明天回来即可继续这次的经文。'
                : "You've used today's readings — come back tomorrow to reflect on this one."}
            </p>
            <div class="upsell-actions">
              <a class="upsell-button" href={`/pricing?lang=${lang}`}>{lang === 'zh' ? '升级立即解读' : 'Upgrade to interpret now'}</a>
            </div>
          </>
        )}
        {pendingGateState.gate === 'retry' && (
          <>
            <h3 class="reveal-gate-title">⚠️ {lang === 'zh' ? '默想生成失败' : 'Could not write the reflection'}</h3>
            <p class="reveal-gate-text">
              {lang === 'zh'
                ? '生成默想时出现问题，你领受的经文已保存 — 刷新页面即可重试。'
                : 'Something went wrong while writing the reflection. Your verses are saved — reload the page to try again.'}
            </p>
          </>
        )}
        {pendingGateState.gate === 'locked' && (
          <>
            <h3 class="reveal-gate-title">👑 {lang === 'zh' ? '此布局需要 Pro 订阅' : 'This layout needs Pro'}</h3>
            <p class="reveal-gate-text">
              {lang === 'zh'
                ? '你领受的经文已保存 — 升级到 Pro 即可默想这次的经文。'
                : 'Your verses are saved — upgrade to Pro to reflect on this reading.'}
            </p>
            <div class="upsell-actions">
              <a class="upsell-button" href={`/pricing?lang=${lang}`}>{lang === 'zh' ? '查看订阅方案' : 'See subscription plans'}</a>
            </div>
          </>
        )}
        {pendingGateState.gate === 'action' && (
          <p class="gate-redraw"><a href={`/?lang=${lang}`}>{lang === 'zh' ? '重新领受' : 'Read again'}</a></p>
        )}
      </section>

      {pendingGateState.gate === 'action' && !registered && (
        <div class="gate-modal-backdrop" id="gate-modal" role="dialog" aria-modal="true" aria-labelledby="gate-modal-title">
          <div class="gate-modal">
            <button type="button" class="gate-modal-close" id="gate-modal-close" aria-label={lang === 'zh' ? '关闭' : 'Close'}>&times;</button>
            <div class="gate-modal-icon" aria-hidden="true">✝</div>
            <h3 id="gate-modal-title">{lang === 'zh' ? '你的默想已就绪' : 'Your reflection is ready'}</h3>
            <p>{gateCopy.modalText}</p>
            <ul class="gate-perks">
              <li>{gateCopy.modalReveal}</li>
              <li>{lang === 'zh' ? '注册即送体验额度：圣言诵读 ×3、深度诵读 ×1' : 'Welcome credits: Lectio Divina ×3, Deep Lectio ×1'}</li>
              <li>{lang === 'zh' ? '每日经文默想 3 → 6 次' : 'Daily Word readings: 3 → 6 per day'}</li>
            </ul>
            <a class="upsell-button" href={`/signup?lang=${lang}`}>{lang === 'zh' ? '免费注册，查看默想' : 'Sign up free to reveal'}</a>
            <a class="upsell-button upsell-button-secondary" href={`/login?lang=${lang}`}>{lang === 'zh' ? '已有账号，登录' : 'Log in'}</a>
            <button type="button" class="gate-modal-later" id="gate-modal-later">{lang === 'zh' ? '稍后再说' : 'Maybe later'}</button>
          </div>
        </div>
      )}
    </>
  )}

  {verses && (
    <>
      {assistantReading && (
        <script type="application/json" id="lectio-reading-context" set:html={assistantContextJson} />
      )}
      <div class="result-header">
        <h2>{lang === 'zh' ? '经文默想' : 'Your Reflection'}</h2>
        <p class="result-question">&ldquo;{question}&rdquo;</p>
        <p class="result-spread">
          {SPREADS[spreadKey]?.name[lang]}
          &middot;
          {lang === 'zh' ? `${verses.length} 节经文` : `${verses.length} verse${verses.length !== 1 ? 's' : ''}`}
        </p>
        <p class="result-again">
          <a href={`/?new=1&lang=${lang}`}>{lang === 'zh' ? '重新领受' : 'Read again'}</a>
        </p>
      </div>
      <section>
        <div class="cards">
          {verses.map((v) => (
            <div class="verse-card">
              {v.position && <span class="position-label">{v.position}</span>}
              <h3 class="verse-ref">
                {lang === 'zh' ? v.refZh : v.refEn}
                <span class="verse-ref-alt">{lang === 'zh' ? v.refEn : v.refZh}</span>
              </h3>
              <blockquote class="verse-text">{lang === 'zh' ? v.textZh : v.textEn}</blockquote>
              <p>{v.interp_text || (lang === 'zh' ? v.themeZh : v.themeEn)}</p>
              {v.tags && v.tags.length > 0 && (
                <div class="tags">
                  {v.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
              )}
            </div>
          ))}
        </div>
      </section>
    </>
  )}

  {resultCount > 1 && (
    <section>
      <h2>{lang === 'zh' ? '整体默想' : 'Overall Reflection'}</h2>
      <div class="interpretation">{interpretation}</div>
    </section>
  )}

  {followUpQuestions.length > 0 && (
    <section class="follow-up-questions">
      <h3>{lang === 'zh' ? '建议的后续问题：' : 'Suggested Follow-up Questions:'}</h3>
      {followUpQuestions.map((fq) => (
        <div class="follow-up-question" data-question={fq}>{fq}</div>
      ))}
    </section>
  )}

  <hr class="rule" />

  <section class="guide-section" aria-labelledby="guide-heading">
    <p class="smallcaps" data-reveal>{lang === 'zh' ? '向导手记' : 'From the Guide'}</p>
    <h2 class="guide-title" id="guide-heading" data-reveal>
      {lang === 'zh' ? '守此一隅的人' : 'A Note from the Keeper'}
    </h2>
    <p class="guide-sub" data-reveal>
      {lang === 'zh' ? '关于与经文相遇这件事' : 'On encountering the text'}
    </p>
    <div class="guide-body" data-reveal>
      <div class="guide-portrait" aria-hidden="true">
        <svg viewBox="0 0 100 100" role="img" aria-hidden="true">
          <defs>
            <radialGradient id="gp-bg" cx="38%" cy="30%" r="80%">
              <stop offset="0%" stop-color="#f3ecd7" />
              <stop offset="100%" stop-color="#ddd1b0" />
            </radialGradient>
          </defs>
          <circle cx="50" cy="50" r="49" fill="url(#gp-bg)" stroke="#b59a5e" stroke-width="1" />
          <path d="M30 74 Q 46 58 66 30" fill="none" stroke="#66744a" stroke-width="2.2" stroke-linecap="round" />
          <path d="M45 55 Q 38 48 28 48 Q 34 57 45 55 Z" fill="#7c8a5c" />
          <path d="M52 45 Q 60 38 70 40 Q 64 49 52 45 Z" fill="#66744a" />
          <path d="M58 36 Q 55 27 47 24 Q 48 34 58 36 Z" fill="#7c8a5c" />
          <path d="M40 63 Q 30 60 24 52 Q 34 52 40 63 Z" fill="#66744a" />
          <circle cx="50" cy="62" r="3.2" fill="#8a6d2c" />
          <circle cx="61" cy="49" r="2.6" fill="#96772e" />
        </svg>
      </div>
      <div class="guide-text">
        {lang === 'zh' ? (
          <>
            <p>
              我起初并不是到经文里找答案的。我来的方式，更像走进一座园子——厌倦了屏幕，厌倦了速度。
              第一个清晨，我对着一节经文坐了十分钟，什么也没有发生。{' '}
              <span class="annotated" tabindex="0">而这正是重点<span class="annotation">十分钟在起初会显得漫长；奇怪的是，练习得越久，它越短。</span></span>
              ：有什么在我里面终于安静了下来。
            </p>
            <p>
              许多年里，我读圣经像读新闻：快、扫视、随时准备离开。是圣言诵读{' '}
              <span class="annotated" tabindex="0">把读经慢了下来<span class="annotation">诵读（读）、默想（想）、祈祷（应）、默观（息）——正是这座小圣所立基的四个动作。</span></span>
              ——一段经文，四个动作，不要求结论。我在这里遇见的很少是答案；更多是陪伴。
            </p>
            <p class="guide-sign">—— 守此一隅的人</p>
          </>
        ) : (
          <>
            <p>
              I did not come to scripture looking for answers. I came the way you come to a garden —
              tired of screens, tired of speed. The first morning I sat with a single verse for ten
              minutes, nothing happened. That was the point: something in me{' '}
              <span class="annotated" tabindex="0">finally stopped<span class="annotation">Ten minutes can feel like an eternity at first. Strangely, it grows shorter the longer you practice.</span></span>.
            </p>
            <p>
              For years I read the Bible the way I read the news: fast, scanning, already leaving.
              Lectio Divina{' '}
              <span class="annotated" tabindex="0">unhurried the reading<span class="annotation">Lectio (read), Meditatio (reflect), Oratio (respond), Contemplatio (rest) — the same four movements this house is built on.</span></span>{' '}
              — one passage, four movements, no verdict required. What I meet here is rarely an
              answer; it is company.
            </p>
            <p class="guide-sign">&mdash; The keeper of this sanctuary</p>
          </>
        )}
      </div>
    </div>
  </section>

  <hr class="rule" />

  <section class="plans-section" aria-labelledby="plans-heading">
    <p class="smallcaps" data-reveal>{lang === 'zh' ? '诵读之旅' : 'Reading Plans'}</p>
    <h2 class="plans-title" id="plans-heading" data-reveal>{lang === 'zh' ? '随节期而读' : 'Seasons of Reading'}</h2>
    <p class="plans-sub" data-reveal>
      {lang === 'zh'
        ? '教会年历是最古老的诵读计划。用一个节期的长度，慢慢地走。'
        : 'The church year is the oldest reading plan there is. Walk one season, slowly.'}
    </p>
    <div class="plans-list">
      {plans.map((plan, i) => (
        <div class={`plan-card${plan.inSeason ? ' in-season' : ''}`} data-reveal style={`--reveal-delay:${(i * 0.08).toFixed(2)}s`}>
          <button class="plan-head" type="button" aria-expanded="false" aria-controls={`plan-body-${i}`}>
            <span class="plan-marker" aria-hidden="true">{plan.marker}</span>
            <span class="plan-head-text">
              <span class="plan-name">{plan.name}</span>
              <span class="plan-tagline">{plan.tagline}</span>
            </span>
            <svg class="plan-caret" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M3 6 L8 11 L13 6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </button>
          <div class="plan-body" id={`plan-body-${i}`} inert>
            <div class="plan-body-inner">
              <div class="plan-body-pad">
                <p>{plan.description}</p>
                <p class="plan-context">{plan.context}</p>
                <ul class="plan-prompts">
                  {plan.prompts.map((prompt) => <li>{prompt}</li>)}
                </ul>
                {plan.progressLabel && (
                  <div class="plan-progress">
                    <span>{plan.progressLabel}</span>
                    {plan.inSeason && (
                      <span class="plan-progress-track">
                        <span class="plan-progress-fill" style={`width:${plan.progressPct}%`}></span>
                      </span>
                    )}
                  </div>
                )}
                <a class="plan-walk" href="/today">
                  {lang === 'zh' ? '走过这段诵读' : 'Walk through this reading'}
                  {plan.verseRef && <span class="plan-walk-ref">{plan.verseRef}</span>}
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <hr class="rule" />

  <section class="invitation-section" aria-labelledby="invitation-heading">
    <p class="smallcaps" data-reveal>{lang === 'zh' ? '每日一句' : 'The Daily Invitation'}</p>
    <h2 class="invitation-title" id="invitation-heading" data-reveal>
      {lang === 'zh' ? '清晨的一句话' : 'One Verse with Your Morning'}
    </h2>
    <p class="invitation-sub" data-reveal>
      {lang === 'zh'
        ? '每个清晨，一节安静的经文抵达你的信箱。没有推送，没有打卡——只有一句话，陪你安坐。'
        : 'Each morning, one quiet verse in your inbox. No noise, no streaks — only a word to sit with.'}
    </p>
    <form class="invite-form" id="invite-form" data-reveal>
      <input
        class="invite-input"
        type="email"
        name="email"
        required
        autocomplete="email"
        aria-label={lang === 'zh' ? '电子邮箱' : 'Email address'}
        placeholder={lang === 'zh' ? '你的邮箱' : 'your@email'}
      />
      <button class="invite-button" type="submit">
        {lang === 'zh' ? '接受邀请' : 'Receive it'}
      </button>
    </form>
    <p class="invite-error" id="invite-error" hidden>
      {lang === 'zh' ? '这个邮箱看起来不太对——再看一眼？' : 'That address does not look right — one more look?'}
    </p>
    <div class="invite-success" id="invite-success" hidden>
      {lang === 'zh'
        ? '已经记下你了。明早见——愿第一缕光里有一句话等你。'
        : 'You are on the list. See you at morning light — may a word be waiting.'}
    </div>
    <p class="invite-note">
      {lang === 'zh' ? '每天最多一封，随时可退订。参见' : 'At most one email a day; unsubscribe anytime. See our '}
      <a href="/privacy">{lang === 'zh' ? '隐私说明' : 'privacy note'}</a>.
    </p>
  </section>

  <footer class="sanctuary-footer">
    <p>
      <a href="/approach">{lang === 'zh' ? '方法' : 'Approach'}</a>
      {' · '}
      <a href="/library">{lang === 'zh' ? '经文库' : 'Verse Library'}</a>
      {' · '}
      <a href="/today">{lang === 'zh' ? '今日诵读' : "Today's Reading"}</a>
      {' · '}
      <a href="/privacy">{lang === 'zh' ? '隐私' : 'Privacy'}</a>
    </p>
    <p>{lang === 'zh' ? 'Lectio 圣言诵读 — 一间安读经文的小圣所' : 'Lectio — a quiet house for scripture'}</p>
  </footer>

  <script>
    document.querySelectorAll<HTMLButtonElement>('.plan-head').forEach((button) => {
      const card = button.closest('.plan-card');
      const body = document.getElementById(button.getAttribute('aria-controls') ?? '');
      if (!card || !body) return;

      button.addEventListener('click', () => {
        const expanded = button.getAttribute('aria-expanded') !== 'true';
        button.setAttribute('aria-expanded', String(expanded));
        card.classList.toggle('open', expanded);
        body.inert = !expanded;
      });
    });

    function selectSpread(key: string) {
      const input = document.getElementById('spread-input') as HTMLInputElement | null;
      if (input) input.value = key;
      document.querySelectorAll('.spread-option').forEach((el) => {
        el.classList.toggle('selected', (el as HTMLElement).dataset.spread === key);
      });
      updateOpenPanel();
    }

    document.querySelectorAll('.spread-option').forEach((el) => {
      el.addEventListener('click', () => {
        const target = el as HTMLElement;
        if (target.dataset.locked === 'true') {
          window.location.href = target.dataset.goto || '/pricing';
          return;
        }
        selectSpread(target.dataset.spread ?? 'single');
      });
    });

    document.getElementById('settings-toggle')?.addEventListener('click', () => {
      document.getElementById('settings-menu')?.classList.toggle('show');
    });

    function setQuestionAndSubmit(question: string) {
      const input = document.querySelector<HTMLInputElement>('input[name="question"]');
      if (input) {
        input.value = question;
        input.classList.remove('default-question');
      }
      showLoading();
      (document.getElementById('reading-form') as HTMLFormElement | null)?.submit();
    }

    document.querySelectorAll<HTMLElement>('.follow-up-question').forEach((el) => {
      el.addEventListener('click', () => setQuestionAndSubmit(el.dataset.question ?? ''));
    });

    document.querySelector<HTMLInputElement>('input[name="question"]')?.addEventListener('focus', function () {
      if (this.classList.contains('default-question')) {
        this.value = '';
        this.classList.remove('default-question');
      }
    });

    function showLoading() {
      const panel = document.getElementById('wait-panel');
      if (panel) {
        panel.hidden = false;
        panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    }

    document.getElementById('reading-form')?.addEventListener('submit', () => {
      const text = document.getElementById('wait-text');
      if (text) {
        text.textContent = document.documentElement.lang === 'zh'
          ? '正在为你领受经文，请稍候...'
          : 'Receiving your verses, please wait...';
      }
      showLoading();
    });

    // ---- Open-the-Bible panel (anonymous read-to-reveal flow) ----
    // Only the multi-verse layouts go through the gated panel; the single
    // Daily Word submits straight from the Explore button.
    const biblePanel = document.getElementById('bible-flip-panel');
    const MULTI_SPREADS = ['3card', 'celtic_cross'];

    function currentSpread(): string {
      return (document.getElementById('spread-input') as HTMLInputElement | null)?.value ?? 'single';
    }

    function updateOpenPanel() {
      if (!biblePanel) return;
      biblePanel.classList.toggle('hidden', !MULTI_SPREADS.includes(currentSpread()));
    }

    updateOpenPanel();

    if (biblePanel) {
      const flipBtn = document.getElementById('bible-flip-btn');
      const flipStatus = document.getElementById('bible-flip-status');
      const bibleVeil = document.getElementById('bible-veil');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      flipBtn?.addEventListener('click', (e) => {
        const panel = biblePanel;
        // Reduced motion (or no veil): native submit, no animation.
        if (!panel || !bibleVeil || reduceMotion.matches) return;
        if (panel.classList.contains('is-opening')) { e.preventDefault(); return; }
        e.preventDefault();
        panel.classList.add('is-opening');
        if (flipStatus) {
          flipStatus.textContent = document.documentElement.lang === 'zh'
            ? '正在翻开圣经，请稍候...'
            : 'Opening the Bible, please wait...';
        }
        // Hold the submit until the second page lands so the cascade is not
        // cut by navigation; the veil then masks the page swap.
        setTimeout(() => {
          bibleVeil.classList.add('on');
          (flipBtn.closest('form') as HTMLFormElement | null)?.submit();
        }, 1800);
      });
    }

    // ---- Reflect (默想) → registration gate modal ----
    const gateModal = document.getElementById('gate-modal');
    if (gateModal) {
      // The modal opens only when the visitor presses the interpret button —
      // never automatically after the draw.
      document.getElementById('interpret-btn')?.addEventListener('click', () => gateModal.classList.add('show'));
      const closeGateModal = () => gateModal.classList.remove('show');
      document.getElementById('gate-modal-close')?.addEventListener('click', closeGateModal);
      document.getElementById('gate-modal-later')?.addEventListener('click', closeGateModal);
      gateModal.addEventListener('click', (e) => {
        if (e.target === gateModal) closeGateModal();
      });
    }

    // Interpret form (registered visitors): inline wait panel while the reading
    // is generated.
    document.getElementById('interpret-form')?.addEventListener('submit', () => {
      showLoading();
      const text = document.getElementById('wait-text');
      if (text) {
        text.textContent = document.documentElement.lang === 'zh'
          ? '正在写下默想，请稍候...'
          : 'Writing your reflection, please wait...';
      }
    });

    // ---- The verse of the day: slides share one cell and take turns ----
    const slides = document.querySelectorAll<HTMLElement>('#verse-cycle .verse-slide');
    if (slides.length > 1) {
      let current = 0;
      setInterval(() => {
        slides[current].classList.remove('shown');
        current = (current + 1) % slides.length;
        slides[current].classList.add('shown');
      }, 8000);
    }

    // ---- A revealed reading opens in the light, not below the fold ----
    const result = document.querySelector('.result-header');
    if (result) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      result.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
    }

    // ---- The Daily Invitation: one quiet POST, no redirect ----
    const inviteForm = document.getElementById('invite-form') as HTMLFormElement | null;
    if (inviteForm) {
      const errorNote = document.getElementById('invite-error');
      const successNote = document.getElementById('invite-success');
      inviteForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const input = inviteForm.querySelector<HTMLInputElement>('input[name="email"]');
        const email = input?.value.trim() ?? '';
        const lang = document.documentElement.lang === 'zh' ? 'zh' : 'en';
        // So the invitation arrives in this reader's morning, not ours.
        let tz = '';
        try {
          tz = Intl.DateTimeFormat().resolvedOptions().timeZone ?? '';
        } catch {
          tz = '';
        }
        errorNote?.setAttribute('hidden', '');
        try {
          const res = await fetch('/api/daily-invitation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, lang, tz }),
          });
          const data = (await res.json().catch(() => null)) as { ok?: boolean } | null;
          if (res.ok && data?.ok) {
            inviteForm.setAttribute('hidden', '');
            successNote?.removeAttribute('hidden');
          } else {
            errorNote?.removeAttribute('hidden');
          }
        } catch {
          errorNote?.removeAttribute('hidden');
        }
      });
    }
  </script>
</Layout>
