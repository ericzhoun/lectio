      document.querySelectorAll('.spread-option').forEach((el) => {
        el.classList.toggle('selected', (el as HTMLElement).dataset.spread === key);
      });
      updateDrawPanels();
    }

    function setMode(mode: string) {
      const input = document.getElementById('mode-input') as HTMLInputElement | null;
      if (input) input.value = mode;
      document.querySelectorAll('.mode-tab').forEach((el) => {
        el.classList.toggle('active', (el as HTMLElement).dataset.mode === mode);
      });
      document.querySelectorAll('.spread-picker').forEach((el) => {
        el.classList.toggle('hidden', (el as HTMLElement).dataset.mode !== mode);
      });
      const reversedSetting = document.getElementById('reversed-setting') as HTMLElement | null;
      if (reversedSetting) reversedSetting.style.display = mode === 'bible' ? 'none' : '';
      updateDrawPanels();
    }

    document.querySelectorAll('.mode-tab').forEach((el) => {
      el.addEventListener('click', () => setMode((el as HTMLElement).dataset.mode || 'tarot'));
    });

    document.querySelectorAll('.spread-option').forEach((el) => {
      el.addEventListener('click', () => {
        const target = el as HTMLElement;
        if (target.dataset.locked === 'true') {
          window.location.href = target.dataset.goto || '/pricing';
          return;
        }
        selectSpread(target.dataset.spread ?? 'single');
      });
    });

    document.getElementById('settings-toggle')?.addEventListener('click', () => {
      document.getElementById('settings-menu')?.classList.toggle('show');
    });

    function setQuestionAndSubmit(question: string) {
      const input = document.querySelector<HTMLInputElement>('input[name="question"]');
      if (input) {
        input.value = question;
        input.classList.remove('default-question');
      }
      showLoading();
      (document.getElementById('tarot-form') as HTMLFormElement | null)?.submit();
    }

    document.querySelectorAll<HTMLElement>('.follow-up-question').forEach((el) => {
      el.addEventListener('click', () => setQuestionAndSubmit(el.dataset.question ?? ''));
    });

    document.querySelector<HTMLInputElement>('input[name="question"]')?.addEventListener('focus', function () {
      if (this.classList.contains('default-question')) {
        this.value = '';
        this.classList.remove('default-question');
      }
    });

    function showLoading() {
      const overlay = document.getElementById('loading-overlay');
      if (overlay) overlay.style.display = 'flex';
    }

    document.getElementById('tarot-form')?.addEventListener('submit', showLoading);

    // ---- Pick-cards fan + Bible flip (anonymous draw-to-reveal flow) ----
    const fanWrap = document.getElementById('card-fan-wrap');
    const fanEl = document.getElementById('card-fan');
    const slotsEl = document.getElementById('fan-slots');
    const deckOrderInput = document.getElementById('deck-order-input') as HTMLInputElement | null;
    const pickedInput = document.getElementById('picked-input') as HTMLInputElement | null;
    const fanHint = document.getElementById('fan-hint');
    const biblePanel = document.getElementById('bible-flip-panel');
    const FAN_SIZE = 24;
    let fanPicked: number[] = [];
    let slotSpread = '';

    function fanDeckOrder(): string[] {
      if (!deckOrderInput?.value) return [];
      try {
        const arr = JSON.parse(deckOrderInput.value);
        return Array.isArray(arr) ? (arr as string[]) : [];
      } catch {
        return [];
      }
    }

    function fanCardImage(name: string): string {
      const slug = name.toLowerCase().replace(/ /g, '_').replace(/'/g, '').replace(/-/g, '_');
      return '/images/' + slug + '.webp';
    }

    function fanPositionMap(): Record<string, string[]> {
      if (!fanWrap?.dataset.positions) return {};
      try {
        const parsed: unknown = JSON.parse(fanWrap.dataset.positions);
        return parsed && typeof parsed === 'object' ? (parsed as Record<string, string[]>) : {};
      } catch {
        return {};
      }
    }

    function currentMode(): string {
      return (document.getElementById('mode-input') as HTMLInputElement | null)?.value ?? 'tarot';
    }

    function currentSpread(): string {
      return (document.getElementById('spread-input') as HTMLInputElement | null)?.value ?? 'single';
    }

    function fanSlotCount(): number {
      return fanPositionMap()[currentSpread()]?.length ?? 3;
    }

    function buildSlots() {
      if (!slotsEl) return;
      const spread = currentSpread();
      const labels = fanPositionMap()[spread] ?? [];
      slotSpread = spread;
      fanPicked = [];
      slotsEl.innerHTML = '';
      slotsEl.classList.toggle('celtic', labels.length > 3);
      labels.forEach((label, i) => {
        const slot = document.createElement('div');
        slot.className = 'fan-slot';
        slot.dataset.slot = String(i);
        slot.innerHTML =
          '<div class="fan-slot-flip"><div class="fan-slot-back"><span class="fan-slot-star">\u2726</span></div><div class="fan-slot-face"></div></div>' +
          '<span class="fan-slot-label"></span>';
        const labelEl = slot.querySelector<HTMLElement>('.fan-slot-label');
        if (labelEl) labelEl.textContent = labels.length > 3 ? (i + 1) + '. ' + label : label;
        slotsEl.appendChild(slot);
      });
      fanWrap?.querySelectorAll<HTMLElement>('.fan-card.picked').forEach((el) => el.classList.remove('picked'));
      renderFanSlots();
      updateFanState();
    }

    function renderFanSlots() {
      if (!slotsEl) return;
      const order = fanDeckOrder();
      slotsEl.querySelectorAll<HTMLElement>('.fan-slot').forEach((slot, i) => {
        const face = slot.querySelector<HTMLElement>('.fan-slot-face');
        const flip = slot.querySelector<HTMLElement>('.fan-slot-flip');
        if (!face || !flip) return;
        if (i < fanPicked.length) {
          const name = order[fanPicked[i]] ?? '';
          if (face.dataset.name !== name) {
            face.innerHTML = '';
            const img = document.createElement('img');
            img.src = fanCardImage(name);
            img.alt = '';
            face.appendChild(img);
            face.dataset.name = name;
          }
          flip.classList.add('flipped');
          slot.classList.add('filled');
        } else {
          face.innerHTML = '';
          delete face.dataset.name;
          flip.classList.remove('flipped');
          slot.classList.remove('filled');
        }
      });
    }

    function updateFanState() {
      if (pickedInput) pickedInput.value = fanPicked.join(',');
      if (!fanHint) return;
      const total = fanSlotCount();
      const start = fanHint.dataset.textStart ?? '';
      const count = fanHint.dataset.textCount ?? '';
      const all = fanHint.dataset.textAll ?? '';
      fanHint.textContent =
        fanPicked.length === 0 ? start
        : fanPicked.length >= total ? all.replace('{t}', String(total))
        : count.replace('{n}', String(fanPicked.length)).replace('{t}', String(total));
      document.querySelector('.explore-button')?.classList.toggle('ready', fanPicked.length >= total);
    }

    function dealFan() {
      if (!fanEl) return;
      const order = fanDeckOrder();
      const pool = order.map((_, i) => i);
      for (let i = pool.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [pool[i], pool[j]] = [pool[j], pool[i]];
      }
      const shown = pool.slice(0, FAN_SIZE);
      fanEl.innerHTML = '';
      const mid = (shown.length - 1) / 2;
      shown.forEach((deckIdx, i) => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'fan-card' + (fanPicked.includes(deckIdx) ? ' picked' : '');
        btn.dataset.deckIdx = String(deckIdx);
        const d = i - mid;
        btn.style.transform = 'rotate(' + (d * 1.6).toFixed(2) + 'deg) translateY(' + (d * d * 0.9).toFixed(1) + 'px)';
        fanEl.appendChild(btn);
      });
    }

    function updateDrawPanels() {
      const spread = currentSpread();
      const multi = !!fanPositionMap()[spread];
      if (fanWrap) {
        const show = currentMode() === 'tarot' && multi;
        fanWrap.classList.toggle('hidden', !show);
        if (show && slotSpread !== spread) buildSlots();
      }
      if (biblePanel) {
        biblePanel.classList.toggle('hidden', !(currentMode() === 'bible' && multi));
      }
    }

    if (fanWrap && fanEl && deckOrderInput) {
      dealFan();
      buildSlots();
      updateDrawPanels();

      fanEl.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLElement>('.fan-card');
        if (!btn) return;
        const deckIdx = Number(btn.dataset.deckIdx);
        const total = fanSlotCount();
        if (Number.isNaN(deckIdx) || fanPicked.includes(deckIdx) || fanPicked.length >= total) return;
        fanPicked.push(deckIdx);
        btn.classList.add('picked');
        renderFanSlots();
        updateFanState();
        if (fanPicked.length === total) {
          document.querySelector('.explore-button')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });

      slotsEl?.addEventListener('click', (e) => {
        const slot = (e.target as HTMLElement).closest<HTMLElement>('.fan-slot');
        if (!slot || !slot.dataset.slot) return;
        const i = Number(slot.dataset.slot);
        if (Number.isNaN(i) || i >= fanPicked.length) return;
        const removed = fanPicked.splice(i, 1)[0];
        const btn = fanEl?.querySelector<HTMLElement>('.fan-card[data-deck-idx="' + removed + '"]');
        if (btn) btn.classList.remove('picked');
        renderFanSlots();
        updateFanState();
      });

      document.getElementById('fan-reshuffle')?.addEventListener('click', () => {
        fanPicked = [];
        dealFan();
        renderFanSlots();
        updateFanState();
      });
    }

    if (biblePanel) {
      const flipBtn = document.getElementById('bible-flip-btn');
      const flipStatus = document.getElementById('bible-flip-status');
      const bibleVeil = document.getElementById('bible-veil');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      flipBtn?.addEventListener('click', (e) => {
        const panel = biblePanel;
        // Reduced motion (or no veil): native submit, no animation.
        if (!panel || !bibleVeil || reduceMotion.matches) return;
        if (panel.classList.contains('is-opening')) { e.preventDefault(); return; }
        e.preventDefault();
        panel.classList.add('is-opening');
        if (flipStatus) {
          flipStatus.textContent = document.documentElement.lang === 'zh'
            ? '正在翻开圣经，请稍候...'
            : 'Flipping open the Bible, please wait...';
        }
        // Hold the submit until the second page lands so the cascade is not
        // cut by navigation; the veil then masks the page swap.
        setTimeout(() => {
          bibleVeil.classList.add('on');
          (flipBtn.closest('form') as HTMLFormElement | null)?.submit();
        }, 1800);
      });
    }

    // ---- Interpret (解经/解读) → registration gate modal ----
    const gateModal = document.getElementById('gate-modal');
    if (gateModal) {
      // The modal opens only when the visitor presses the interpret button —
      // never automatically after the draw.
      document.getElementById('interpret-btn')?.addEventListener('click', () => gateModal.classList.add('show'));
      const closeGateModal = () => gateModal.classList.remove('show');
      document.getElementById('gate-modal-close')?.addEventListener('click', closeGateModal);
      document.getElementById('gate-modal-later')?.addEventListener('click', closeGateModal);
      gateModal.addEventListener('click', (e) => {
        if (e.target === gateModal) closeGateModal();
      });
    }

    // Interpret form (registered visitors): loading overlay while the reading
    // is generated.
    document.getElementById('interpret-form')?.addEventListener('submit', () => {
      showLoading();
      const text = document.getElementById('loading-text');
      if (text) {
        text.textContent = document.documentElement.lang === 'zh'
          ? '正在生成解读，请稍候...'
          : 'Interpreting your reading, please wait...';
      }
    });
  </script>
</Layout>
