---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import DailyProgress from '../../components/DailyProgress.astro';
import { env } from 'cloudflare:workers';
import { verifySessionToken } from '../../lib/session';
import { resolveLang } from '../../lib/i18n';
import { resolveActiveDay } from '../../lib/localDay';
import { getLectionaryDay, focusReference } from '../../lib/lectionary';
import { resolvePassage } from '../../lib/passage';
import { isStep, nextStep, STEP_COPY, WRITING_STEPS, stepIndex, type Step } from '../../lib/dailySteps';
import {
  ensureSession, getSession, advanceTo, canOpenStep, getStepEntries,
} from '../../lib/dailySession';
import { recordAnonProgress, takeAnonProgress } from '../../lib/anonProgress';
import { handleStepSubmit, STEP_TEXT_MAX_CHARS } from '../../lib/dailySubmit';
import type { WritingStep } from '../../lib/dailyReflection';

const stepParam = Astro.params.step;
if (!isStep(stepParam)) return Astro.redirect('/today');
const step: Step = stepParam;

const lang = resolveLang(Astro);
const day = resolveActiveDay(Astro);
const entry = getLectionaryDay(day);
const passage = resolvePassage(focusReference(entry), lang);

// Resolve clips on the server: a manifest entry does not guarantee that the
// deployed asset exists. The endpoint falls back to synthesis when missing.
const stepAudioUrl = (_lang: typeof lang, s: Step) => `/api/tts?step=${s}&lang=${_lang}`;
const stepAudio = stepAudioUrl(lang, step);
const passageAudio = `/api/tts?day=${day}&lang=${lang}`;

// The guided-session playlist, only ever handed to the browser as URLs: the
// six step prompts with the day's passage in the middle, separated by the
// page's own silences.
const guidedItems: { label: string; src: string; pauseSeconds: number }[] = [];
if (step === 'silencio') {
  const say = (s: Step | 'passage', src: string | null, pauseSeconds: number) => {
    if (!src) return;
    guidedItems.push({
      label: s === 'passage' ? (lang === 'zh' ? '经文' : 'Scripture') : STEP_COPY[s].name[lang],
      src,
      pauseSeconds,
    });
  };
  say('silencio', stepAudioUrl(lang, 'silencio'), 50);
  say('lectio', stepAudioUrl(lang, 'lectio'), 6);
  say('passage', passage ? passageAudio : null, 10);
  say('meditatio', stepAudioUrl(lang, 'meditatio'), 90);
  say('oratio', stepAudioUrl(lang, 'oratio'), 90);
  say('contemplatio', stepAudioUrl(lang, 'contemplatio'), 110);
  say('actio', stepAudioUrl(lang, 'actio'), 0);
}
const guidedAvailable = guidedItems.length === 7;

const sessionCookie = Astro.cookies.get('session')?.value;
const userId = sessionCookie ? await verifySessionToken(sessionCookie, env.SESSION_SECRET) : null;

// Anonymous readers may take the first two steps. Meditatio asks them to sign
// in, because from there on they are writing something worth keeping.
const ANON_STEPS: Step[] = ['silencio', 'lectio'];
if (!userId && !ANON_STEPS.includes(step)) {
  const returnTo = encodeURIComponent(`/today/${step}`);
  return Astro.redirect(`/login?lang=${lang}&returnTo=${returnTo}`);
}

// An anonymous walk leaves no session row to remember it, so the furthest step
// reached travels in a signed cookie and seeds the session once they sign in.
if (!userId) await recordAnonProgress(Astro.cookies, day, step, env.SESSION_SECRET);

const isWriting = (WRITING_STEPS as readonly Step[]).includes(step);

// An anonymous reader has genuinely reached whichever step they are on; there
// is just no session row to remember it, so the rail would otherwise show them
// stuck at the first step.
let reached: Step = userId ? 'silencio' : step;
if (userId) {
  let session = await getSession(userId, day);
  if (!session) {
    // First session since signing in mid-walk: resume where the anonymous
    // reader left off rather than restarting at Silencio.
    session = await ensureSession(
      userId, day, lang, env.DB,
      await takeAnonProgress(Astro.cookies, day, env.SESSION_SECRET)
    );
  }
  reached = session.reachedStep;
  // No jumping ahead: nobody lands on Oratio without having read.
  if (!canOpenStep(reached, step)) return Astro.redirect(`/today/${reached}`);
}

let submitError: 'empty' | null = null;

if (Astro.request.method === 'POST' && userId && passage && isWriting) {
  const form = await Astro.request.formData();
  const userText = String(form.get('step_text') ?? '');
  const result = await handleStepSubmit({
    userId, day, step: step as WritingStep, userText, passage, lang,
  });
  if (result.error === 'empty') submitError = 'empty';
  // Redirect after POST so a refresh never resubmits.
  else return Astro.redirect(`/today/${step}?saved=1`);
}

const entries = userId ? await getStepEntries(userId, day) : [];
const priorText = (s: Step) => entries.find((e) => e.step === s)?.userText ?? '';
const myEntry = entries.find((e) => e.step === step) ?? null;
const saved = Astro.url.searchParams.get('saved') === '1';

// Arriving at a silent step is all it takes to have taken it. A writing step
// advances on submit instead, which handleStepSubmit does.
if (userId && !isWriting) {
  await advanceTo(userId, day, step);
  const refreshed = await getSession(userId, day);
  reached = refreshed?.reachedStep ?? reached;
}

const copy = STEP_COPY[step];
const next = nextStep(step);
const advanceHref = next ? `/today/${next}` : '/today/amen';
const continueLabel = lang === 'zh' ? '继续' : 'Continue';
---

<Layout title={`${copy.name[lang]} · ${entry.title[lang]}`} lang={lang} noindex={true} chrome="minimal">
  <article class="daily ritual">
    <header class="ritual-top">
      <DailyProgress reached={reached} current={step} lang={lang} variant="dots" />
      <span class="ritual-count">
        {lang === 'zh' ? `第 ${stepIndex(step) + 1} 步，共 6 步` : `Step ${stepIndex(step) + 1} of 6`}
      </span>
      <a class="ritual-exit" href="/" aria-label={lang === 'zh' ? '返回首页' : 'Back to home'}>✕</a>
    </header>

    <div class="ritual-body">
      <header>
        <p class="day">{entry.title[lang]}</p>
        <h1>{copy.name[lang]}</h1>
        <p class="prompt">{copy.prompt[lang]}</p>
        {stepAudio && (
          <button type="button" class="listen" data-clip={stepAudio}
            aria-label={lang === 'zh' ? '朗读引导语' : 'Listen to the guidance'}
          >{lang === 'zh' ? '▶ 引导' : '▶ Guidance'}</button>
        )}
      </header>

      {step === 'silencio' && (
        <section class="silence">
          <div class="timer" data-seconds="60" aria-live="polite"></div>
          <div class="bell-row">
            <button type="button" class="bell-toggle" id="bell-toggle" aria-pressed="false">
              <span class="bell-icon" aria-hidden="true">🔔</span>
              <span id="bell-label">{lang === 'zh' ? '开场钟声 · 关' : 'Opening bell · off'}</span>
            </button>
          </div>
          {guidedAvailable && (
            <div class="guided">
              <button type="button" class="listen" data-guided={JSON.stringify(guidedItems)}
                aria-label={lang === 'zh' ? '播放整场引导音频' : 'Play the whole guided session'}
              >{lang === 'zh' ? '▶ 整场引导' : '▶ Guided session'}</button>
              <p class="guided-now" data-guided-now hidden aria-live="polite"></p>
              <p class="guided-hint">
                {lang === 'zh' ? '依次朗读六个步骤与经文，之间留出安歇的时间。' : 'Reads the six steps and the passage aloud, with rests between.'}
              </p>
            </div>
          )}
        </section>
      )}

      {step === 'lectio' && (
        <section class="reading">
          <div class="controls" role="group" aria-label={lang === 'zh' ? '字体大小' : 'Text size'}>
            <button type="button" data-scale="-1" aria-label={lang === 'zh' ? '缩小字体' : 'Smaller text'}>A-</button>
            <button type="button" data-scale="0" aria-label={lang === 'zh' ? '默认字体' : 'Default text size'}>A</button>
            <button type="button" data-scale="1" aria-label={lang === 'zh' ? '放大字体' : 'Larger text'}>A+</button>
          </div>
          {passage ? (
            <>
              <p class="ref">{passage.ref}</p>
              <p class="text">{passage.text}</p>
              <button type="button" class="listen" data-listen data-day={day}
                aria-label={lang === 'zh' ? '朗读经文' : 'Listen to the passage'}
              >{lang === 'zh' ? '▶ 朗读' : '▶ Listen'}</button>
              <p class="twice">{lang === 'zh' ? '请再读一遍。' : 'Now read it a second time.'}</p>
            </>
          ) : (
            <p class="text">
              {lang === 'zh' ? '今天的经文暂时无法显示。' : "Today's passage could not be loaded."}
            </p>
          )}
        </section>
      )}

      {step === 'contemplatio' && (
        <section class="rest">
          {priorText('oratio') && <blockquote class="own-words mine">{priorText('oratio')}</blockquote>}
          <div class="timer" data-seconds="120" aria-live="polite"></div>
        </section>
      )}

      {isWriting && (
        <section class="writing">
          {step === 'meditatio' && passage && <p class="text passage-again">{passage.text}</p>}
          {step !== 'meditatio' && priorText('meditatio') && (
            <blockquote class="own-words">{priorText('meditatio')}</blockquote>
          )}

          {saved && myEntry ? (
            <>
              <blockquote class="own-words mine">{myEntry.userText}</blockquote>
              {myEntry.aiText
                ? (
                  <>
                    <p class="reply">{myEntry.aiText}</p>
                    <button type="button" class="listen" data-reply data-day={day} data-step={step}
                      aria-label={lang === 'zh' ? '朗读回复' : 'Listen to the reply'}
                    >{lang === 'zh' ? '▶ 听回复' : '▶ Reply'}</button>
                  </>
                )
                : <p class="reply muted">{copy.prompt[lang]}</p>}
            </>
          ) : (
            <form method="post" id="step-form">
              <label for="step_text">{copy.prompt[lang]}</label>
              {/* A textarea's value is its children, never a value attribute. */}
              <textarea
                id="step_text"
                name="step_text"
                rows="5"
                maxlength={STEP_TEXT_MAX_CHARS}
                required
              >{myEntry?.userText ?? ''}</textarea>
              {submitError === 'empty' && (
                <p class="error">{lang === 'zh' ? '请先写下一点什么。' : 'Write something first.'}</p>
              )}
            </form>
          )}
        </section>
      )}
    </div>

    <div class="action-bar">
      {step === 'silencio' && (
        <a class="advance bar-action" href={advanceHref}>{lang === 'zh' ? '开始' : 'Begin'}</a>
      )}
      {step === 'lectio' && (
        <a class="advance bar-action ready" href={advanceHref}>{continueLabel}</a>
      )}
      {step === 'contemplatio' && (
        <a class="advance bar-action" href={advanceHref}>{continueLabel}</a>
      )}
      {isWriting && saved && (
        <a class="advance ready bar-action" href={advanceHref}>{continueLabel}</a>
      )}
      {isWriting && !saved && (
        <button type="submit" form="step-form" class="bar-action">{continueLabel}</button>
      )}
    </div>
  </article>
</Layout>

<script>
  const audioError = (button: HTMLButtonElement) => {
    let message = button.nextElementSibling;
    if (!message?.classList.contains('audio-error')) {
      message = document.createElement('p');
      message.className = 'audio-error';
      message.setAttribute('role', 'status');
      button.parentNode?.insertBefore(message, button.nextSibling);
    }
    message.textContent = document.documentElement.lang === 'zh'
      ? '音频暂时无法播放，请重试。' : 'Audio could not play. Please try again.';
  };
  const clearAudioError = (button: HTMLButtonElement) => {
    if (button.nextElementSibling?.classList.contains('audio-error')) button.nextElementSibling.remove();
  };
  // Count down, then bring the advance link forward. Never disabled: a reader
  // who is ready before the timer is ready.
  document.querySelectorAll<HTMLElement>('.timer').forEach((el) => {
    let left = Number(el.dataset.seconds ?? 60);
    const render = () => { el.textContent = String(left); };
    render();
    const id = setInterval(() => {
      left -= 1;
      render();
      if (left <= 0) {
        clearInterval(id);
        el.textContent = '';
        el.closest('section')?.classList.add('ready');
        document.querySelector('.action-bar')?.classList.add('ready');
      }
    }, 1000);
  });

  const reading = document.querySelector<HTMLElement>('.reading');
  if (reading) {
    let scale = 1;
    reading.querySelectorAll<HTMLButtonElement>('[data-scale]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const step = Number(btn.dataset.scale);
        scale = step === 0 ? 1 : Math.min(1.6, Math.max(0.85, scale + step * 0.15));
        reading.style.setProperty('--reading-scale', String(scale));
      });
    });

    // Read the passage aloud via the open-source MeloTTS model on Workers AI.
    // The text itself stays server-side; the button only names the day.
    const listen = reading.querySelector<HTMLButtonElement>('[data-listen]');
    const lang = document.documentElement.lang === 'zh' ? 'zh' : 'en';
    if (listen?.dataset.day) {
      const label = {
        idle: lang === 'zh' ? '▶ 朗读' : '▶ Listen',
        loading: lang === 'zh' ? '生成中…' : 'Loading…',
        playing: lang === 'zh' ? '■ 停止' : '■ Stop',
      };
      let audio: HTMLAudioElement | null = null;
      let objectUrl: string | null = null;
      let loading = false;

      const stop = () => {
        audio?.pause();
        audio = null;
        if (objectUrl) URL.revokeObjectURL(objectUrl);
        objectUrl = null;
        listen.textContent = label.idle;
      };

      listen.addEventListener('click', async () => {
        // Mid-playback, the button really is a stop button.
        if (audio) return stop();
        // A second click while the model is still working would buy a second clip.
        if (loading) return;
        loading = true;
        clearAudioError(listen);
        listen.textContent = label.loading;
        try {
          // The prebuilt clip, when today has one; on-demand MeloTTS otherwise.
          audio = new Audio(`/api/tts?day=${listen.dataset.day}&lang=${lang}`);
          audio.addEventListener('ended', stop);
          await audio.play();
          listen.textContent = label.playing;
          window.lectioTrack?.('audio_play', { player: 'passage', step: listen.dataset.day ?? '' });
        } catch {
          stop();
          audioError(listen);
        } finally {
          loading = false;
        }
      });
    }
  }

  // The rest of the players. `lang` above is scoped to the reading block.
  const uiLang = document.documentElement.lang === 'zh' ? 'zh' : 'en';
  const clipLabels = (idle: string) => ({
    idle,
    loading: uiLang === 'zh' ? '生成中…' : 'Loading…',
    playing: uiLang === 'zh' ? '■ 停止' : '■ Stop',
  });

  // Shared button contract with the passage Listen button: click plays, click
  // again stops, a second click while loading does nothing.
  const clipPlayer = (button: HTMLButtonElement, load: string | (() => Promise<string>), idle: string): void => {
    const label = clipLabels(idle);
    let audio: HTMLAudioElement | null = null;
    let objectUrl: string | null = null;
    let loading = false;
    const stop = () => {
      audio?.pause();
      audio = null;
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = null;
      button.textContent = label.idle;
    };
    button.addEventListener('click', async () => {
      if (audio) return stop();
      if (loading) return;
      loading = true;
      clearAudioError(button);
      button.textContent = label.loading;
      try {
        const src = typeof load === 'string' ? load : await load();
        if (src.startsWith('blob:')) objectUrl = src;
        audio = new Audio(src);
        audio.addEventListener('ended', stop);
        await audio.play();
        button.textContent = label.playing;
        window.lectioTrack?.('audio_play', { player: 'clip', clip: button.dataset.clip ?? '' });
      } catch {
        stop();
        audioError(button);
      } finally {
        loading = false;
      }
    });
  };

  // Step guidance clips, prebuilt and committed under /audio/steps/.
  document.querySelectorAll<HTMLButtonElement>('[data-clip]').forEach((btn) => {
    const src = btn.dataset.clip;
    if (src) clipPlayer(btn, src, uiLang === 'zh' ? '▶ 引导' : '▶ Guidance');
  });

  // The model's reply, spoken only from what is already stored in D1 for this
  // reader's day and step - never from request text.
  document.querySelectorAll<HTMLButtonElement>('[data-reply]').forEach((btn) => {
    clipPlayer(
      btn,
      async () => {
        const res = await fetch('/api/reflection-tts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ day: btn.dataset.day, step: btn.dataset.step }),
        });
        if (!res.ok) throw new Error(String(res.status));
        return URL.createObjectURL(await res.blob());
      },
      uiLang === 'zh' ? '▶ 听回复' : '▶ Reply',
    );
  });

  // The whole guided session: the six prompts and the passage, in order, with
  // rests between. It never navigates - the reader walks the pages themselves.
  const guided = document.querySelector<HTMLButtonElement>('[data-guided]');
  const guidedNow = document.querySelector<HTMLElement>('[data-guided-now]');
  if (guided && guidedNow) {
    type GuidedItem = { label: string; src: string; pauseSeconds: number };
    const idle = uiLang === 'zh' ? '▶ 整场引导' : '▶ Guided session';
    const playing = uiLang === 'zh' ? '■ 停止' : '■ Stop';
    let running = false;
    let audio: HTMLAudioElement | null = null;
    let objectUrl: string | null = null;
    let timer: ReturnType<typeof setTimeout> | null = null;

    const stop = () => {
      running = false;
      if (timer) clearTimeout(timer);
      timer = null;
      audio?.pause();
      audio = null;
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = null;
      guided.textContent = idle;
      guidedNow.hidden = true;
    };

    const playAt = async (items: GuidedItem[], i: number): Promise<void> => {
      if (i >= items.length) return stop();
      const item = items[i];
      guidedNow.textContent = item.label;
      guidedNow.hidden = false;
      let src = item.src;
      if (src.startsWith('/api/')) {
        const res = await fetch(src);
        if (!res.ok) return stop();
        objectUrl = URL.createObjectURL(await res.blob());
        src = objectUrl;
      }
      audio = new Audio(src);
      audio.addEventListener('ended', () => {
        audio = null;
        timer = setTimeout(() => void playAt(items, i + 1), item.pauseSeconds * 1000);
      });
      await audio.play();
      window.lectioTrack?.('audio_play', { player: 'guided' });
    };

    guided.addEventListener('click', () => {
      if (running) return stop();
      const items = JSON.parse(guided.dataset.guided ?? '[]') as GuidedItem[];
      if (!items.length) return;
      running = true;
      guided.textContent = playing;
      void playAt(items, 0).catch(stop);
    });
  }

  // ---- Opt-in ambient bell: a soft chime as the session begins ----
  // Pure Web Audio, no asset: a small bowl tone with inharmonic partials and a
  // long decay. Plays only on a user gesture (browsers block otherwise).
  const bellBtn = document.getElementById('bell-toggle');
  if (bellBtn) {
    const bellLabel = document.getElementById('bell-label');
    const zhPage = document.documentElement.lang === 'zh';
    let bellOn = false;
    try { bellOn = localStorage.getItem('lectio_bell') === 'on'; } catch { /* private mode */ }

    const renderBell = () => {
      bellBtn.classList.toggle('on', bellOn);
      bellBtn.setAttribute('aria-pressed', String(bellOn));
      if (bellLabel) {
        bellLabel.textContent = zhPage
          ? `开场钟声 · ${bellOn ? '开' : '关'}`
          : `Opening bell · ${bellOn ? 'on' : 'off'}`;
      }
    };
    renderBell();

    const chime = () => {
      try {
        const Ctx = window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (!Ctx) return;
        const ctx = new Ctx();
        if (ctx.state === 'suspended') void ctx.resume();
        const t0 = ctx.currentTime;
        const master = ctx.createGain();
        master.gain.setValueAtTime(0.0001, t0);
        master.gain.exponentialRampToValueAtTime(0.13, t0 + 0.04);
        master.gain.exponentialRampToValueAtTime(0.0001, t0 + 5.5);
        master.connect(ctx.destination);
        // A quiet singing-bowl: fundamental at 432 Hz plus faint inharmonic partials.
        const partials: Array<[number, number]> = [[432, 1], [866, 0.4], [1298, 0.18], [1732, 0.08], [2589, 0.04]];
        for (const [freq, amp] of partials) {
          const osc = ctx.createOscillator();
          osc.type = 'sine';
          osc.frequency.value = freq;
          const g = ctx.createGain();
          g.gain.value = amp;
          osc.connect(g);
          g.connect(master);
          osc.start(t0);
          osc.stop(t0 + 6);
        }
        setTimeout(() => void ctx.close(), 6500);
      } catch { /* audio unavailable; silence is also a fine beginning */ }
    };

    bellBtn.addEventListener('click', () => {
      bellOn = !bellOn;
      try { localStorage.setItem('lectio_bell', bellOn ? 'on' : 'off'); } catch { /* private mode */ }
      renderBell();
      if (bellOn) chime();
    });

    // With the bell opted in, the first gesture of the sitting lets it sound.
    if (bellOn) {
      const once = () => chime();
      document.addEventListener('pointerdown', once, { once: true });
      document.addEventListener('keydown', once, { once: true });
    }
  }
</script>

<style>
  .daily {
    max-width: 38rem;
    margin: 0 auto;
    padding: 2.5rem 1.25rem 4rem;
  }

  .ritual {
    padding: 0 1.25rem;
  }

  /* Page-specific action-bar behavior (frame geometry lives in global.css). */
  .action-bar .advance { opacity: 0.35; }
  .action-bar.ready .advance,
  .action-bar .advance.ready { opacity: 1; }
  .ritual .advance {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 0;
    padding: 0 1.5rem;
    border: none;
    border-radius: 14px;
  }

  .daily header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .day {
    font-size: 0.85rem;
    opacity: 0.6;
    margin: 0 0 0.4rem;
    letter-spacing: 0.03em;
  }

  .daily h1 {
    font-size: 1.6rem;
    font-weight: 500;
    margin: 0 0 0.6rem;
    letter-spacing: 0.04em;
  }

  .prompt {
    margin: 0;
    opacity: 0.75;
    line-height: 1.6;
  }

  .text {
    font-size: calc(1.05rem * var(--reading-scale, 1));
    line-height: 1.9;
    margin: 1.5rem 0;
  }

  .passage-again {
    font-size: 1rem;
    opacity: 0.75;
    border-left: 2px solid currentColor;
    padding-left: 1rem;
  }

  .ref {
    text-align: center;
    font-size: 0.85rem;
    opacity: 0.6;
    margin: 0;
  }

  .twice {
    font-size: 0.85rem;
    opacity: 0.55;
    font-style: italic;
  }

  .controls {
    display: flex;
    justify-content: flex-end;
    gap: 0.35rem;
  }

  .listen {
    display: block;
    margin: 0 auto;
    background: none;
    border: 1px solid rgba(128, 128, 128, 0.35);
    border-radius: 999px;
    padding: 0 1.2rem;
    min-height: 44px;
    font-size: 0.85rem;
    cursor: pointer;
  }

  .controls button {
    background: none;
    border: 1px solid rgba(128, 128, 128, 0.35);
    border-radius: 4px;
    padding: 0.15rem 0.5rem;
    font-size: 0.8rem;
    cursor: pointer;
    color: inherit;
    min-width: 44px;
    min-height: 44px;
  }

  .silence,
  .rest {
    text-align: center;
    padding: 2rem 0;
