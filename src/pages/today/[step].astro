---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import DailyProgress from '../../components/DailyProgress.astro';
import ReadingMusic from '../../components/ReadingMusic.astro';
import { resolveMusic } from '../../lib/singingBible';
import { env } from 'cloudflare:workers';
import { verifySessionToken } from '../../lib/session';
import { resolveLang, langHref } from '../../lib/i18n';
import { resolveActiveDay, resolveLocalDay, isVerseDay, verseSlugOfDay } from '../../lib/localDay';
import { getLectionaryDay, focusReference } from '../../lib/lectionary';
import { resolvePassage, type ResolvedPassage } from '../../lib/passage';
import { getLibraryVerseBySlug } from '../../lib/scripture';
import { isStep, nextStep, STEP_COPY, STEP_ORDER, WRITING_STEPS, stepIndex, TOTAL_WALK_MINUTES, type Step } from '../../lib/dailySteps';
import {
  ensureSession, getSession, advanceTo, canOpenStep, getStepEntries,
} from '../../lib/dailySession';
import { guestReaderId } from '../../lib/guestSession';
import { isLikelyBotUa } from '../../lib/botFilter';
import { handleStepSubmit, STEP_TEXT_MAX_CHARS } from '../../lib/dailySubmit';
import type { WritingStep } from '../../lib/dailyReflection';

const stepParam = Astro.params.step;
if (!isStep(stepParam)) return Astro.redirect('/today');
const step: Step = stepParam;

const lang = resolveLang(Astro);
const day = resolveActiveDay(Astro);
// A library walk (`verse:<slug>` pseudo-day) reads its own passage straight
// from the verse deck; a dated walk reads the lectionary's focus. A stale
// pseudo-day whose slug has left the deck returns to the start of /today
// rather than rendering a broken walk.
const libraryVerse = isVerseDay(day) ? getLibraryVerseBySlug(verseSlugOfDay(day)) : null;
if (isVerseDay(day) && !libraryVerse) return Astro.redirect('/today');
const lectionaryEntry = libraryVerse ? null : getLectionaryDay(day);
const walkTitle = libraryVerse
  ? (lang === 'zh' ? libraryVerse.refZh : libraryVerse.refEn)
  : lectionaryEntry!.title[lang];
// A walk opened from a reading plan is not today's; say so, so nobody wonders
// why the reading does not match the date. A library walk carries no date,
// so there is nothing to wonder about.
const otherDay = !libraryVerse && day !== resolveLocalDay(Astro)
  ? new Date(`${day}T00:00:00Z`).toLocaleDateString(lang === 'zh' ? 'zh-CN' : 'en-US',
      { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })
  : null;
const passage: ResolvedPassage | null = libraryVerse
  ? {
      ref: lang === 'zh' ? libraryVerse.refZh : libraryVerse.refEn,
      text: lang === 'zh' ? libraryVerse.textZh : libraryVerse.textEn,
    }
  : resolvePassage(focusReference(lectionaryEntry!), lang);
const music = passage
  ? resolveMusic(libraryVerse ? libraryVerse.refEn : focusReference(lectionaryEntry!))
  : null;

// Resolve clips on the server: a manifest entry does not guarantee that the
// deployed asset exists. The endpoint falls back to synthesis when missing.
const stepAudioUrl = (_lang: typeof lang, s: Step) => `/api/tts?step=${s}&lang=${_lang}`;
const stepAudio = stepAudioUrl(lang, step);
const passageAudio = libraryVerse
  ? `/api/tts?ref=${encodeURIComponent(libraryVerse.refEn)}&lang=${lang}`
  : `/api/tts?day=${day}&lang=${lang}`;

// The guided-session playlist, only ever handed to the browser as URLs: the
// five step prompts with the day's passage in the middle, separated by the
// page's own silences. It hangs off Lectio, which is where the walk now opens.
const guidedItems: { label: string; src: string; pauseSeconds: number }[] = [];
if (step === 'lectio') {
  const say = (s: Step | 'passage', src: string | null, pauseSeconds: number) => {
    if (!src) return;
    guidedItems.push({
      label: s === 'passage' ? (lang === 'zh' ? '经文' : 'Scripture') : STEP_COPY[s].name[lang],
      src,
      pauseSeconds,
    });
  };
  say('lectio', stepAudioUrl(lang, 'lectio'), 6);
  say('passage', passage ? passageAudio : null, 10);
  say('meditatio', stepAudioUrl(lang, 'meditatio'), 90);
  say('oratio', stepAudioUrl(lang, 'oratio'), 90);
  say('contemplatio', stepAudioUrl(lang, 'contemplatio'), 110);
  say('actio', stepAudioUrl(lang, 'actio'), 0);
}
const guidedAvailable = guidedItems.length === 6;

const sessionCookie = Astro.cookies.get('session')?.value;
const userId = sessionCookie ? await verifySessionToken(sessionCookie, env.SESSION_SECRET) : null;

// The whole walk is open to anonymous readers. Their session and their words
// are stored against the first-party visitor id and move onto the account they
// create later; the invitation to register waits until Amen.
const readerId = userId ?? guestReaderId(Astro.locals.vid);

const isWriting = (WRITING_STEPS as readonly Step[]).includes(step);

// Same crawler gate as /today: a bot gets the page rendered but never gets a
// session row or a step advance written on its behalf.
const isBot = isLikelyBotUa(Astro.request.headers.get('user-agent'));

const session = isBot
  ? null
  : await getSession(readerId, day)
    ?? await ensureSession(readerId, day, lang, env.DB);
let reached: Step = session?.reachedStep ?? 'lectio';
// No jumping ahead: nobody lands on Oratio without having read.
if (!canOpenStep(reached, step)) return Astro.redirect(`/today/${reached}`);

let submitError: 'empty' | null = null;

if (Astro.request.method === 'POST' && passage && isWriting) {
  const form = await Astro.request.formData();
  const userText = String(form.get('step_text') ?? '');
  const result = await handleStepSubmit({
    userId: readerId, day, step: step as WritingStep, userText, passage, lang,
  });
  if (result.error === 'empty') submitError = 'empty';
  // Redirect after POST so a refresh never resubmits.
  else return Astro.redirect(`/today/${step}?saved=1`);
}

const entries = await getStepEntries(readerId, day);
const priorText = (s: Step) => entries.find((e) => e.step === s)?.userText ?? '';
const myEntry = entries.find((e) => e.step === step) ?? null;
const saved = Astro.url.searchParams.get('saved') === '1';

// The actio-to-draw handoff: the one thing they will do today becomes the
// question the verse draw answers on the homepage. Collapsed to one line and
// capped, since it rides in a URL.
let actioQuestion: string | null = null;
if (step === 'actio' && myEntry?.userText) {
  const oneLine = myEntry.userText.replace(/\s+/g, ' ').trim();
  actioQuestion = oneLine.length > 120 ? `${oneLine.slice(0, 120)}…` : oneLine;
}

// Arriving at a silent step is all it takes to have taken it. A writing step
// advances on submit instead, which handleStepSubmit does.
if (!isWriting && !isBot) {
  await advanceTo(readerId, day, step);
  const refreshed = await getSession(readerId, day);
  reached = refreshed?.reachedStep ?? reached;
}

const copy = STEP_COPY[step];
const next = nextStep(step);
const advanceHref = next ? `/today/${next}` : '/today/amen';
const continueLabel = lang === 'zh' ? '继续' : 'Continue';
---

<Layout title={`${copy.name[lang]} · ${walkTitle}`} lang={lang} noindex={true} chrome="minimal">
  <article class="daily ritual">
    <header class="ritual-top">
      <DailyProgress reached={reached} current={step} lang={lang} variant="dots" />
      <span class="ritual-count">
        {lang === 'zh'
          ? `第 ${stepIndex(step) + 1} 步，共 ${STEP_ORDER.length} 步 · 约 ${copy.minutes} 分钟`
          : `Step ${stepIndex(step) + 1} of ${STEP_ORDER.length} · ~${copy.minutes} min`}
      </span>
      <a class="ritual-exit" href="/" aria-label={lang === 'zh' ? '返回首页' : 'Back to home'}>✕</a>
    </header>

    <div class="ritual-body">
      <header>
        <p class="day">
          {walkTitle}
          {otherDay && <span class="day-away">{otherDay}</span>}
        </p>
        <h1>{copy.name[lang]}</h1>
        <p class="prompt">{copy.prompt[lang]}</p>
        {/* The walk opens here now, so the length of the whole sitting is said
            once, at the top, before anything is asked for. */}
        {step === 'lectio' && (
          <p class="walk-length">
            {lang === 'zh'
              ? `整场诵读共 ${STEP_ORDER.length} 步，约 ${TOTAL_WALK_MINUTES} 分钟——可以随时停下，已写下的会替你保留。`
              : `${STEP_ORDER.length} steps, about ${TOTAL_WALK_MINUTES} minutes in all. Stop anytime — what you have written is kept for you.`}
          </p>
        )}
        {stepAudio && (
          <button type="button" class="listen" data-clip={stepAudio}
            aria-label={lang === 'zh' ? '朗读引导语' : 'Listen to the guidance'}
          >{lang === 'zh' ? '▶ 引导' : '▶ Guidance'}</button>
        )}
      </header>

      {/* The Word stays in view through every movement after Lectio, so a
          reader never has to leave their step to find it again. */}
      {step !== 'lectio' && passage && (
        <p class="text passage-again">
          {passage.text}
          <span class="passage-ref">{passage.ref}</span>
        </p>
      )}

      {step === 'lectio' && (
        <section class="reading">
          {/* The opening movement leads with the sung passage: the Word heard
              before it is read. */}
          {passage && music && (
            <div class="opening">
              <ReadingMusic clip={music} lang={lang} />
            </div>
          )}

          <div class="controls" role="group" aria-label={lang === 'zh' ? '字体大小' : 'Text size'}>
            <button type="button" data-scale="-1" aria-label={lang === 'zh' ? '缩小字体' : 'Smaller text'}>A-</button>
            <button type="button" data-scale="0" aria-label={lang === 'zh' ? '默认字体' : 'Default text size'}>A</button>
            <button type="button" data-scale="1" aria-label={lang === 'zh' ? '放大字体' : 'Larger text'}>A+</button>
          </div>
          {passage ? (
            <>
              <p class="ref">{passage.ref}</p>
              <p class="text">{passage.text}</p>
              <button type="button" class="listen" data-listen data-day={day} data-audio={passageAudio}
                aria-label={lang === 'zh' ? '朗读经文' : 'Listen to the passage'}
              >{lang === 'zh' ? '▶ 朗读' : '▶ Listen'}</button>
              <p class="twice">{lang === 'zh' ? '请再读一遍。' : 'Now read it a second time.'}</p>
            </>
          ) : (
            <p class="text">
              {lang === 'zh' ? '今天的经文暂时无法显示。' : "Today's passage could not be loaded."}
            </p>
          )}

          <div class="bell-row">
            <button type="button" class="bell-toggle" id="bell-toggle" aria-pressed="false">
              <span class="bell-icon" aria-hidden="true">🔔</span>
              <span id="bell-label">{lang === 'zh' ? '开场钟声 · 关' : 'Opening bell · off'}</span>
            </button>
          </div>
          {guidedAvailable && (
            <div class="guided">
              <button type="button" class="listen" data-guided={JSON.stringify(guidedItems)}
                aria-label={lang === 'zh' ? '播放整场引导音频' : 'Play the whole guided session'}
              >{lang === 'zh' ? '▶ 整场引导' : '▶ Guided session'}</button>
              <p class="guided-now" data-guided-now hidden aria-live="polite"></p>
              <p class="guided-hint">
                {lang === 'zh'
                  ? '依次朗读每个步骤与经文，之间留出安歇的时间。'
                  : `Reads the ${STEP_ORDER.length} steps and the passage aloud, with rests between.`}
              </p>
            </div>
          )}
        </section>
      )}

      {step === 'contemplatio' && (
        <section class="rest">
          {priorText('oratio') && <blockquote class="own-words mine">{priorText('oratio')}</blockquote>}
          <div class="breath" data-breath>
            <svg class="breath-svg" viewBox="0 0 240 240" aria-hidden="true" focusable="false">
              <defs>
                <radialGradient id="breath-glow" cx="50%" cy="36%" r="62%">
                  <stop offset="0%" class="breath-stop-a"></stop>
                  <stop offset="58%" class="breath-stop-b"></stop>
                  <stop offset="100%" class="breath-stop-c"></stop>
                </radialGradient>
                <radialGradient id="breath-halo-grad">
                  <stop offset="0%" class="breath-halo-a"></stop>
                  <stop offset="72%" class="breath-halo-b"></stop>
                  <stop offset="100%" class="breath-halo-c"></stop>
                </radialGradient>
                <mask id="breath-cross-mask">
                  <rect x="107" y="38" width="26" height="164" rx="9" fill="#fff"></rect>
                  <rect x="57" y="77" width="126" height="26" rx="9" fill="#fff"></rect>
                </mask>
                <filter id="breath-soften" x="-60%" y="-60%" width="220%" height="220%">
                  <feTurbulence type="fractalNoise" baseFrequency="0.028" numOctaves="2" seed="11" result="waver">
                    <animate
                      attributeName="baseFrequency"
                      values="0.022;0.04;0.022"
                      dur="11s"
                      repeatCount="indefinite"
                      calcMode="spline"
                      keySplines="0.42 0 0.58 1;0.42 0 0.58 1"
                    ></animate>
                  </feTurbulence>
                  <feDisplacementMap in="SourceGraphic" in2="waver" scale="10" result="displaced"></feDisplacementMap>
                  <feGaussianBlur in="displaced" stdDeviation="7"></feGaussianBlur>
                </filter>
              </defs>
              <circle class="breath-halo" cx="120" cy="120" r="90" fill="url(#breath-halo-grad)"></circle>
              <g class="breath-cross-glow" filter="url(#breath-soften)">
                <rect x="107" y="38" width="26" height="164" rx="9"></rect>
                <rect x="57" y="77" width="126" height="26" rx="9"></rect>
              </g>
              <rect class="breath-cross" x="57" y="38" width="126" height="164" fill="url(#breath-glow)" mask="url(#breath-cross-mask)"></rect>
            </svg>
            <p class="breath-hint" aria-live="polite"></p>
          </div>
        </section>
      )}

      {isWriting && (
        <section class="writing">
          {step !== 'meditatio' && priorText('meditatio') && (
            <blockquote class="own-words">{priorText('meditatio')}</blockquote>
          )}

          {saved && myEntry ? (
            <>
              <blockquote class="own-words mine">{myEntry.userText}</blockquote>
              {myEntry.aiText
                ? (
                  <>
                    <p class="reply">{myEntry.aiText}</p>
                    <button type="button" class="listen" data-reply data-day={day} data-step={step}
                      aria-label={lang === 'zh' ? '朗读回复' : 'Listen to the reply'}
                    >{lang === 'zh' ? '▶ 听回复' : '▶ Reply'}</button>
                  </>
                )
                : <p class="reply muted">{copy.prompt[lang]}</p>}
            </>
          ) : (
            <form method="post" id="step-form">
              <label for="step_text">{copy.prompt[lang]}</label>
              {/* A textarea's value is its children, never a value attribute. */}
              <textarea
                id="step_text"
                name="step_text"
                rows="5"
                maxlength={STEP_TEXT_MAX_CHARS}
                required
              >{myEntry?.userText ?? ''}</textarea>
              {submitError === 'empty' && (
                <p class="error">{lang === 'zh' ? '请先写下一点什么。' : 'Write something first.'}</p>
              )}
            </form>
          )}

          {/* The walk's last step hands off to the draw: the resolution they
              just written becomes the question a received verse answers. The
              homepage keeps its own, fuller entry to the same feature. */}
          {step === 'actio' && saved && actioQuestion && (
            <a
              class="actio-draw"
              href={langHref(`/?question=${encodeURIComponent(actioQuestion)}`, lang)}
              data-event="cta_click" data-event-props='{"slot":"actio_draw"}'
            >
              {lang === 'zh' ? '把今天这一步带到神面前 — 领受一节经文' : 'Bring this step to God — receive a verse for it'}
            </a>
          )}
        </section>
      )}
    </div>

    <div class="action-bar">
      {step === 'lectio' && (
        <a class="advance bar-action ready" href={advanceHref}>{continueLabel}</a>
      )}
      {step === 'contemplatio' && (
        <a class="advance bar-action" href={advanceHref}>{continueLabel}</a>
      )}
      {isWriting && saved && (
        <a class="advance ready bar-action" href={advanceHref}>{continueLabel}</a>
      )}
      {isWriting && !saved && (
        <button type="submit" form="step-form" class="bar-action">{continueLabel}</button>
      )}
    </div>
  </article>
</Layout>

<script>
  // The live transport sits right after its pill, so the error line is looked
  // up by class inside the same block rather than by sibling position.
  const audioError = (button: HTMLButtonElement) => {
    const parent = button.parentNode;
    if (!parent) return;
    let message = parent.querySelector<HTMLElement>('.audio-error');
    if (!message) {
      message = document.createElement('p');
      message.className = 'audio-error';
      message.setAttribute('role', 'status');
      parent.insertBefore(message, button.nextSibling);
    }
    message.textContent = document.documentElement.lang === 'zh'
      ? '音频暂时无法播放，请重试。' : 'Audio could not play. Please try again.';
  };
  const clearAudioError = (button: HTMLButtonElement) => {
    button.parentNode?.querySelector('.audio-error')?.remove();
  };
  // The breathing cross: three deep breaths across ten seconds — an Apple
  // Watch style moment in place of the old countdown — then the step is
  // taken. The advance link never waits on it: a reader who is ready early
  // is ready.
  document.querySelectorAll<HTMLElement>('[data-breath]').forEach((el) => {
    const ball = el.querySelector<SVGElement>('.breath-svg');
    const hint = el.querySelector<HTMLElement>('.breath-hint');
    const zhPage = document.documentElement.lang === 'zh';
    const TOTAL_S = 10;
    const CYCLES = 3;  // three deep breaths across the whole animation
    const cycleS = TOTAL_S / CYCLES;
    const IN = 0.45;   // fraction of a breath spent breathing in
    const HOLD = 0.12; // a short rest at the top of the breath
    const GROW = 0.34; // how far the ball swells at the top of the breath

    const ease = (x: number) => 0.5 - 0.5 * Math.cos(Math.PI * Math.min(1, Math.max(0, x)));
    const settle = () => {
      if (ball) ball.style.transform = '';
      el.classList.add('settled'); // hands the cross a slow idle glow
      if (hint) hint.textContent = '';
      el.closest('section')?.classList.add('ready');
      document.querySelector('.action-bar')?.classList.add('ready');
    };
    // Deliberately ignores prefers-reduced-motion: this is guidance, not
    // decoration — the breath leads whether or not the OS asks for stillness.

    const started = performance.now();
    const tick = (now: number) => {
      const t = (now - started) / 1000;
      if (t >= TOTAL_S || !ball) return settle();
      const p = (t % cycleS) / cycleS;
      const swell = p < IN
        ? ease(p / IN) // breathing in
        : p < IN + HOLD ? 1 : ease(1 - (p - IN - HOLD) / (1 - IN - HOLD)); // out
      ball.style.transform = `scale(${(1 + GROW * swell).toFixed(4)})`;
      if (hint) {
        const want = p < IN ? (zhPage ? '吸气…' : 'Breathe in…')
          : p >= IN + HOLD ? (zhPage ? '呼气…' : 'Breathe out…') : null;
        if (want && want !== hint.textContent) hint.textContent = want;
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });

  const reading = document.querySelector<HTMLElement>('.reading');
  if (reading) {
    let scale = 1;
    reading.querySelectorAll<HTMLButtonElement>('[data-scale]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const step = Number(btn.dataset.scale);
        scale = step === 0 ? 1 : Math.min(1.6, Math.max(0.85, scale + step * 0.15));
        reading.style.setProperty('--reading-scale', String(scale));
      });
    });

  }

  // Every Listen pill hands over to a small transport while its clip plays:
  // pause/resume, ten seconds back, ten seconds on, stop. Stop — or the clip
  // ending — gives the pill back, so a reader can listen again without a reload.
  const uiLang = document.documentElement.lang === 'zh' ? 'zh' : 'en';
  const SKIP_SECONDS = 10;

  const formatTime = (seconds: number): string => {
    const total = Number.isFinite(seconds) && seconds > 0 ? Math.floor(seconds) : 0;
    return `${Math.floor(total / 60)}:${String(total % 60).padStart(2, '0')}`;
  };

  const transportPlayer = (
    button: HTMLButtonElement,
    load: () => Promise<string>,
    idle: string,
    onPlay: () => void,
  ): void => {
    const zh = uiLang === 'zh';
    const copy = {
      ready: idle,
      loading: zh ? '生成中…' : 'Loading…',
      player: zh ? '音频播放器' : 'Audio player',
      progress: zh ? '播放进度' : 'Progress',
      pause: zh ? '暂停' : 'Pause',
      play: zh ? '继续' : 'Resume',
      back: zh ? '后退 10 秒' : 'Rewind 10 seconds',
      forward: zh ? '前进 10 秒' : 'Forward 10 seconds',
      stop: zh ? '停止' : 'Stop',
    };

    const transportButton = (glyph: string, label: string, extra = ''): HTMLButtonElement => {
      const el = document.createElement('button');
      el.type = 'button';
      el.className = extra ? `audio-player-btn ${extra}` : 'audio-player-btn';
      el.textContent = glyph;
      el.setAttribute('aria-label', label);
      el.title = label;
      return el;
    };

    const back = transportButton('↺10', copy.back);
    const toggle = transportButton('❚❚', copy.pause, 'audio-player-toggle');
    const forward = transportButton('10↻', copy.forward);
    const halt = transportButton('■', copy.stop);

    const controls = document.createElement('span');
    controls.className = 'audio-player-controls';
    controls.appendChild(back);
    controls.appendChild(toggle);
    controls.appendChild(forward);
    controls.appendChild(halt);

    const bar = document.createElement('span');
    bar.className = 'audio-player-bar';
    bar.setAttribute('role', 'progressbar');
    bar.setAttribute('aria-label', copy.progress);
    bar.setAttribute('aria-valuemin', '0');
    bar.setAttribute('aria-valuemax', '100');
    bar.setAttribute('aria-valuenow', '0');
    const fill = document.createElement('span');
    fill.className = 'audio-player-fill';
    bar.appendChild(fill);

    const clock = document.createElement('span');
    clock.className = 'audio-player-time';

    const meter = document.createElement('span');
    meter.className = 'audio-player-meter';
    meter.appendChild(bar);
    meter.appendChild(clock);

    const player = document.createElement('span');
    player.className = 'audio-player';
    player.hidden = true;
    player.setAttribute('role', 'group');
    player.setAttribute('aria-label', copy.player);
    player.appendChild(controls);
    player.appendChild(meter);
    button.insertAdjacentElement('afterend', player);

    let audio: HTMLAudioElement | null = null;
    let objectUrl: string | null = null;
    let loading = false;

    const paint = (): void => {
      const duration = audio && Number.isFinite(audio.duration) && audio.duration > 0 ? audio.duration : 0;
      const at = audio?.currentTime ?? 0;
      const ratio = duration ? Math.min(1, at / duration) : 0;
      fill.style.width = `${(ratio * 100).toFixed(2)}%`;
      bar.setAttribute('aria-valuenow', String(Math.round(ratio * 100)));
      clock.textContent = duration ? `${formatTime(at)} / ${formatTime(duration)}` : formatTime(at);
    };

    const setToggle = (playing: boolean): void => {
      const label = playing ? copy.pause : copy.play;
      toggle.textContent = playing ? '❚❚' : '▶';
      toggle.setAttribute('aria-label', label);
      toggle.title = label;
    };

    // Hand the pill back: the clip stops, the object URL is released, the
    // transport is hidden again — and the reader can listen a second time.
    const release = (): void => {
      const clip = audio;
      audio = null;
      clip?.pause();
      if (objectUrl) {
        URL.revokeObjectURL(objectUrl);
        objectUrl = null;
      }
      player.hidden = true;
      button.hidden = false;
      button.textContent = copy.ready;
      setToggle(false);
      fill.style.width = '0';
      clock.textContent = '';
      bar.setAttribute('aria-valuenow', '0');
    };

    back.addEventListener('click', () => {
      const clip = audio;
      if (!clip) return;
      clip.currentTime = Math.max(0, clip.currentTime - SKIP_SECONDS);
      paint();
    });

    forward.addEventListener('click', () => {
      const clip = audio;
      if (!clip) return;
      const end = Number.isFinite(clip.duration) && clip.duration > 0 ? Math.max(0, clip.duration - 0.25) : Infinity;
      clip.currentTime = Math.min(end, clip.currentTime + SKIP_SECONDS);
      paint();
    });

    toggle.addEventListener('click', () => {
      const clip = audio;
      if (!clip) return;
      // A pause mid-clip is not a stop: the clip keeps its place.
      if (clip.paused) void clip.play().catch(() => { /* the pill reports failures */ });
      else clip.pause();
    });

    halt.addEventListener('click', release);

    button.addEventListener('click', async () => {
      if (loading || audio) return;
      loading = true;
      clearAudioError(button);
      button.textContent = copy.loading;
      try {
        const src = await load();
        if (src.startsWith('blob:')) objectUrl = src;
        const clip = new Audio(src);
        clip.addEventListener('ended', release);
        clip.addEventListener('timeupdate', paint);
        clip.addEventListener('loadedmetadata', paint);
        clip.addEventListener('play', () => setToggle(true));
        clip.addEventListener('pause', () => setToggle(false));
        audio = clip;
        await clip.play();
        // The pill steps aside; the transport takes its place and its focus.
        button.hidden = true;
        player.hidden = false;
        setToggle(true);
        paint();
        if (document.activeElement === button || document.activeElement === document.body) toggle.focus();
        onPlay();
      } catch {
        release();
        audioError(button);
      } finally {
        loading = false;
      }
    });
  };

  // Step guidance clips, prebuilt and committed under /audio/steps/.
  document.querySelectorAll<HTMLButtonElement>('[data-clip]').forEach((btn) => {
    const src = btn.dataset.clip;
    if (!src) return;
    transportPlayer(btn, async () => src, uiLang === 'zh' ? '▶ 引导' : '▶ Guidance', () => {
      window.lectioTrack?.('audio_play', { player: 'clip', clip: btn.dataset.clip ?? '' });
    });
  });

  // The passage aloud, read by the open-source MeloTTS model on Workers AI —
  // the prebuilt clip when today has one, on-demand synthesis otherwise. The
  // text itself stays server-side; the button only names the day. Library
  // walks carry their own audio URL (the deck ref, not a day).
  document.querySelectorAll<HTMLButtonElement>('.reading [data-listen]').forEach((btn) => {
    if (!btn.dataset.day) return;
    transportPlayer(
      btn,
      async () => btn.dataset.audio || `/api/tts?day=${btn.dataset.day}&lang=${uiLang}`,
      uiLang === 'zh' ? '▶ 朗读' : '▶ Listen',
      () => {
        window.lectioTrack?.('audio_play', { player: 'passage', step: btn.dataset.day ?? '' });
      },
    );
  });

  // The model's reply, spoken only from what is already stored in D1 for this
  // reader's day and step - never from request text.
  document.querySelectorAll<HTMLButtonElement>('[data-reply]').forEach((btn) => {
    transportPlayer(
      btn,
      async () => {
        const res = await fetch('/api/reflection-tts', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ day: btn.dataset.day, step: btn.dataset.step }),
        });
        if (!res.ok) throw new Error(String(res.status));
        return URL.createObjectURL(await res.blob());
      },
      uiLang === 'zh' ? '▶ 听回复' : '▶ Reply',
      () => {
        window.lectioTrack?.('audio_play', { player: 'clip', clip: btn.dataset.clip ?? '' });
      },
    );
  });

  // The whole guided session: the five prompts and the passage, in order, with
  // rests between. It never navigates - the reader walks the pages themselves.
  const guided = document.querySelector<HTMLButtonElement>('[data-guided]');
  const guidedNow = document.querySelector<HTMLElement>('[data-guided-now]');
  if (guided && guidedNow) {
    type GuidedItem = { label: string; src: string; pauseSeconds: number };
    const idle = uiLang === 'zh' ? '▶ 整场引导' : '▶ Guided session';
    const playing = uiLang === 'zh' ? '■ 停止' : '■ Stop';
    let running = false;
    let audio: HTMLAudioElement | null = null;
    let objectUrl: string | null = null;
    let timer: ReturnType<typeof setTimeout> | null = null;

    const stop = () => {
      running = false;
      if (timer) clearTimeout(timer);
      timer = null;
      audio?.pause();
      audio = null;
      if (objectUrl) URL.revokeObjectURL(objectUrl);
      objectUrl = null;
      guided.textContent = idle;
      guidedNow.hidden = true;
    };

    const playAt = async (items: GuidedItem[], i: number): Promise<void> => {
      if (i >= items.length) return stop();
      const item = items[i];
      guidedNow.textContent = item.label;
      guidedNow.hidden = false;
      let src = item.src;
      if (src.startsWith('/api/')) {
        const res = await fetch(src);
        if (!res.ok) return stop();
        objectUrl = URL.createObjectURL(await res.blob());
        src = objectUrl;
      }
      audio = new Audio(src);
      audio.addEventListener('ended', () => {
        audio = null;
        timer = setTimeout(() => void playAt(items, i + 1), item.pauseSeconds * 1000);
      });
      await audio.play();
      window.lectioTrack?.('audio_play', { player: 'guided' });
    };

    guided.addEventListener('click', () => {
      if (running) return stop();
      const items = JSON.parse(guided.dataset.guided ?? '[]') as GuidedItem[];
      if (!items.length) return;
      running = true;
      guided.textContent = playing;
      void playAt(items, 0).catch(stop);
    });
  }

  // ---- Opt-in ambient bell: a soft chime as the session begins ----
  // Pure Web Audio, no asset: a small bowl tone with inharmonic partials and a
  // long decay. Plays only on a user gesture (browsers block otherwise).
  const bellBtn = document.getElementById('bell-toggle');
  if (bellBtn) {
    const bellLabel = document.getElementById('bell-label');
    const zhPage = document.documentElement.lang === 'zh';
    let bellOn = false;
    try { bellOn = localStorage.getItem('lectio_bell') === 'on'; } catch { /* private mode */ }

    const renderBell = () => {
      bellBtn.classList.toggle('on', bellOn);
      bellBtn.setAttribute('aria-pressed', String(bellOn));
      if (bellLabel) {
        bellLabel.textContent = zhPage
          ? `开场钟声 · ${bellOn ? '开' : '关'}`
          : `Opening bell · ${bellOn ? 'on' : 'off'}`;
      }
    };
    renderBell();

    const chime = () => {
      try {
        const Ctx = window.AudioContext ?? (window as unknown as { webkitAudioContext?: typeof AudioContext }).webkitAudioContext;
        if (!Ctx) return;
        const ctx = new Ctx();
        if (ctx.state === 'suspended') void ctx.resume();
        const t0 = ctx.currentTime;
        const master = ctx.createGain();
        master.gain.setValueAtTime(0.0001, t0);
        master.gain.exponentialRampToValueAtTime(0.13, t0 + 0.04);
        master.gain.exponentialRampToValueAtTime(0.0001, t0 + 5.5);
        master.connect(ctx.destination);
        // A quiet singing-bowl: fundamental at 432 Hz plus faint inharmonic partials.
        const partials: Array<[number, number]> = [[432, 1], [866, 0.4], [1298, 0.18], [1732, 0.08], [2589, 0.04]];
        for (const [freq, amp] of partials) {
          const osc = ctx.createOscillator();
          osc.type = 'sine';
          osc.frequency.value = freq;
          const g = ctx.createGain();
          g.gain.value = amp;
          osc.connect(g);
          g.connect(master);
          osc.start(t0);
          osc.stop(t0 + 6);
        }
        setTimeout(() => void ctx.close(), 6500);
      } catch { /* audio unavailable; silence is also a fine beginning */ }
    };

    bellBtn.addEventListener('click', () => {
      bellOn = !bellOn;
      try { localStorage.setItem('lectio_bell', bellOn ? 'on' : 'off'); } catch { /* private mode */ }
      renderBell();
      if (bellOn) chime();
    });

    // With the bell opted in, the first gesture of the sitting lets it sound.
    if (bellOn) {
      const once = () => chime();
      document.addEventListener('pointerdown', once, { once: true });
      document.addEventListener('keydown', once, { once: true });
    }
  }
</script>

