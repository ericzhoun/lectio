---
export const prerender = false;
import LoginForm from '../components/LoginForm.astro';
import { safeAuthReturn } from '../lib/authReturn';
import Layout from '../layouts/Layout.astro';
import { resolveLang } from '../lib/i18n';

const url = Astro.url;
const lang = resolveLang(Astro);
const error = url.searchParams.get('error');

const returnTo = safeAuthReturn(url.searchParams.get('returnTo'), `/?lang=${lang}`);

---
<Layout title={lang === 'zh' ? '登录 — Lectio' : 'Log In — Lectio'} noindex lang={lang}>
  <div class="auth-page">
    <div class="auth-hero">
      <h1>{lang === 'zh' ? '欢迎回来' : 'Welcome back'}</h1>
      <p class="auth-hero-sub">
        {lang === 'zh'
          ? '登录后继续你的圣言诵读，保存每一次默想'
          : 'Sign in to continue your reading practice and keep every reflection'}
      </p>
    </div>

    <LoginForm lang={lang} returnTo={returnTo} error={error} />
  </div>
</Layout>
