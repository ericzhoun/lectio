---
export const prerender = false;
import Layout from '../layouts/Layout.astro';
import { resolveLang } from '../lib/i18n';

const lang = resolveLang(Astro);

// Checkout outcomes bounce back here; without a visible message a failed
// Subscribe click looks like the button did nothing at all.
const notices: Record<string, { zh: string; en: string }> = {
  invalid_tier: {
    zh: '结账暂时无法开始，请稍后重试或联系我们',
    en: 'Checkout could not be started. Please try again later or contact us.',
  },
  cancelled: {
    zh: '你已取消结账，随时可以重新订阅',
    en: 'Checkout cancelled. You can subscribe again anytime.',
  },
};
const noticeKey = Astro.url.searchParams.get('error')
  ?? (Astro.url.searchParams.get('checkout') === 'cancelled' ? 'cancelled' : null);
const notice = noticeKey ? notices[noticeKey] ?? null : null;

const tiers = [
  {
    key: 'free',
    name: { zh: '免费', en: 'Free' },
    monthly: { zh: '$0', en: '$0' },
    annual: { zh: '$0', en: '$0' },
    blurb: { zh: '未注册每日 3 次每日经文；注册后每日 6 次 + 圣言诵读 ×3、深度诵读 ×1 体验额度', en: 'Guests: 3 Daily Word readings/day. Registered: 6/day + trial credits (Lectio Divina ×3, Deep Lectio ×1)' },
  },
  {
    key: 'basic',
    name: { zh: '基础版', en: 'Basic' },
    monthly: { zh: '$4.99/月', en: '$4.99/mo' },
    annual: { zh: '$2.99/月', en: '$2.99/mo' },
    annualTotal: { zh: '$35.88/年', en: '$35.88/yr' },
    blurb: { zh: '每日经文 / 圣言诵读，每日 20 次，历史记录', en: 'Daily Word + Lectio Divina, 20 readings/day, history' },
  },
  {
    key: 'pro',
    name: { zh: '专业版', en: 'Pro' },
    monthly: { zh: '$11.99/月', en: '$11.99/mo' },
    annual: { zh: '$7.19/月', en: '$7.19/mo' },
    annualTotal: { zh: '$86.28/年', en: '$86.28/yr' },
    blurb: { zh: '全部布局，无限次数，历史记录', en: 'All layouts, unlimited readings, history' },
  },
];

const title = lang === 'zh'
  ? 'Lectio 价格方案 — 免费、基础版与专业版'
  : 'Lectio Plans & Pricing — Free, Basic & Pro';
const description = lang === 'zh'
  ? '选择适合你的方案：免费每日 6 次每日经文，基础版 $4.99/月含圣言诵读，专业版 $11.99/月解锁全部布局无限默想。月付方案首月免费试用，年付享六折优惠。'
  : 'Choose your Lectio plan: free tier with 6 Daily Word readings a day, Basic at $4.99/mo for Lectio Divina, or Pro at $11.99/mo for every layout unlimited. First month free on monthly plans; save 40% with annual billing.';
---
<Layout title={title} description={description} lang={lang}>
  <h1>{lang === 'zh' ? '价格方案' : 'Plans & Pricing'}</h1>

  {notice && (
    <p class="auth-error" role="alert">
      <span class="auth-error-icon" aria-hidden="true">!</span>
      {lang === 'zh' ? notice.zh : notice.en}
    </p>
  )}

  <div class="billing-toggle" role="radiogroup" aria-label={lang === 'zh' ? '计费周期' : 'Billing period'}>
    <button class="billing-toggle-btn active" data-billing="monthly" role="radio" aria-checked="true">
      {lang === 'zh' ? '月付' : 'Monthly'}
    </button>
    <button class="billing-toggle-btn" data-billing="annual" role="radio" aria-checked="false">
      {lang === 'zh' ? '年付省 40%' : 'Annual — save 40%'}
    </button>
  </div>

  <p class="trial-note">
    {lang === 'zh'
      ? '月付方案首月免费试用 · 试用期内可随时取消，不产生费用'
      : 'Monthly plans start with a free first month · cancel anytime during the trial and pay nothing'}
  </p>

  <div class="pricing-grid">
    {tiers.map((t) => (
      <div class="pricing-card" data-tier={t.key}>
        <h2>{t.name[lang]}</h2>
        <p class="price" data-price-monthly={t.monthly[lang]} data-price-annual={t.annual[lang]}>
          {t.monthly[lang]}
        </p>
        {t.annualTotal && (
          <p class="price-annual-total" hidden>
            {lang === 'zh' ? `按年付 ${t.annualTotal[lang]}` : `Billed annually at ${t.annualTotal[lang]}`}
          </p>
        )}
        {t.key !== 'free' && (
          <span class="save-badge trial-badge" data-trial-badge>
            {lang === 'zh' ? '首月免费' : 'First month free'}
          </span>
        )}
        {t.key !== 'free' && (
          <span class="save-badge" data-save-badge hidden>
            {lang === 'zh' ? '省 40%' : 'Save 40%'}
          </span>
        )}
        <p>{t.blurb[lang]}</p>
        {t.key !== 'free' && (
          <form method="post" action="/api/stripe/checkout">
            <input type="hidden" name="tier" value={t.key} />
            <input type="hidden" name="billing" value="monthly" data-billing-input />
            <button type="submit">{lang === 'zh' ? '订阅' : 'Subscribe'}</button>
          </form>
        )}
      </div>
    ))}
  </div>

  <script>
    // The notice describes the click that brought you here, not the page you are
    // on now. Drop the param so a reload or a shared link starts clean.
    if (location.search) {
      const params = new URLSearchParams(location.search);
      if (params.has('error') || params.has('checkout')) {
        params.delete('error');
        params.delete('checkout');
        const qs = params.toString();
        history.replaceState(null, '', location.pathname + (qs ? '?' + qs : '') + location.hash);
      }
    }

    const toggle = document.querySelector('.billing-toggle');
    toggle?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('.billing-toggle-btn') as HTMLButtonElement | null;
      if (!btn) return;
      const billing = btn.dataset.billing ?? 'monthly';
      toggle.querySelectorAll('.billing-toggle-btn').forEach((b) => {
        b.classList.toggle('active', b === btn);
        b.setAttribute('aria-checked', String(b === btn));
      });
      document.querySelectorAll('.pricing-card').forEach((card) => {
        const priceEl = card.querySelector('.price') as HTMLElement | null;
        const totalEl = card.querySelector('.price-annual-total') as HTMLElement | null;
        const badge = card.querySelector('[data-save-badge]') as HTMLElement | null;
        const trialBadge = card.querySelector('[data-trial-badge]') as HTMLElement | null;
        const input = card.querySelector('[data-billing-input]') as HTMLInputElement | null;
        if (priceEl) {
          priceEl.textContent = billing === 'annual'
            ? (priceEl.dataset.priceAnnual ?? priceEl.textContent ?? '')
            : (priceEl.dataset.priceMonthly ?? priceEl.textContent ?? '');
        }
        if (totalEl) totalEl.hidden = billing !== 'annual';
        if (badge) badge.hidden = billing !== 'annual';
        if (trialBadge) trialBadge.hidden = billing === 'annual';
        if (input) input.value = billing;
      });
    });
  </script>
</Layout>
