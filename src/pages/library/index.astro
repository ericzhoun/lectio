---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getLibraryVerses } from '../../lib/scripture';
import { resolveLang } from '../../lib/i18n';

const url = Astro.url;
const lang = resolveLang(Astro);
const testament = url.searchParams.get('testament') ?? 'all';

let verses = getLibraryVerses();
if (testament === 'old' || testament === 'new') {
  verses = verses.filter((v) => v.testament === testament);
}

const title = lang === 'zh'
  ? '经文库 — 圣言诵读常用经文与主题'
  : 'Verse Library — Scripture for Lectio Divina';
const description = lang === 'zh'
  ? '浏览 Lectio 的完整经文库：旧约与新约的常用默想经文，附中英对照原文与主题。'
  : "Browse Lectio's full verse library: passages from the Old and New Testament for contemplative reading, with English and Chinese text and themes.";

function filterHref(t: string) {
  return `?lang=${lang}&testament=${t}`;
}
---
<Layout title={title} description={description} lang={lang}>
  <header>
    <h1>{lang === 'zh' ? '经文库' : 'Verse Library'}</h1>
  </header>

  <div class="filters">
    <a href={filterHref('all')} class={testament === 'all' ? 'active' : ''}>{lang === 'zh' ? '全部' : 'All'}</a>
    <a href={filterHref('old')} class={testament === 'old' ? 'active' : ''}>{lang === 'zh' ? '旧约' : 'Old Testament'}</a>
    <a href={filterHref('new')} class={testament === 'new' ? 'active' : ''}>{lang === 'zh' ? '新约' : 'New Testament'}</a>
  </div>
  <div class="count">
    {lang === 'zh' ? `共 ${verses.length} 节经文` : `${verses.length} verse${verses.length !== 1 ? 's' : ''}`}
  </div>

  <div class="verse-grid">
    {verses.map((v) => (
      <a class="verse-grid-item" href={`/library/${v.slug}?lang=${lang}`}>
        <h3 class="verse-ref">
          {lang === 'zh' ? v.refZh : v.refEn}
          <span class="verse-ref-alt">{lang === 'zh' ? v.refEn : v.refZh}</span>
        </h3>
        <blockquote class="verse-text">{lang === 'zh' ? v.textZh : v.textEn}</blockquote>
        <span class="tag">{lang === 'zh' ? v.themeZh : v.themeEn}</span>
      </a>
    ))}
  </div>
</Layout>
