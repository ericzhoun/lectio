---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getLibraryCards } from '../../lib/tarot';
import { resolveLang } from '../../lib/i18n';

const { slug } = Astro.params;
const lang = resolveLang(Astro);

const cards = getLibraryCards();
const card = cards.find((c) => c.slug === slug);

if (!card) {
  return new Response(null, { status: 404 });
}

const cardName = lang === 'zh' ? card.zh : card.en;
const title = lang === 'zh'
  ? `${card.zh}（${card.en}）— 塔罗牌含义与解读`
  : `${card.en} Tarot Card — Meaning & Interpretation`;
const description = lang === 'zh'
  ? `${card.zh}塔罗牌详解：正位含义 — ${card.meaning_zh.upright}；逆位含义 — ${card.meaning_zh.reversed}`
  : `${card.en} tarot card: upright — ${card.meaning_en.upright}; reversed — ${card.meaning_en.reversed}`;
---
<Layout title={title} description={description} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "image": `https://dramatherapy.us${card.image_url}`,
    "inLanguage": lang === 'zh' ? 'zh' : 'en',
    "about": {
      "@type": "Thing",
      "name": card.en,
      "alternateName": card.zh,
      "description": `Rider-Waite tarot card: ${card.en}`
    },
    "isPartOf": {
      "@type": "WebSite",
      "name": "Inspiration Tarot",
      "url": "https://dramatherapy.us"
    }
  })}>
  </script>

  <a class="back-link" href={`/library?lang=${lang}`}>&larr; {lang === 'zh' ? '返回牌库' : 'Back to Library'}</a>

  <header>
    <h1>{lang === 'zh' ? card.zh : card.en}</h1>
    <p>{lang === 'zh' ? card.en : card.zh}</p>
  </header>

  <div class="detail-images">
    <figure>
      <img src={card.image_url} alt={`${card.en} tarot card upright — Rider-Waite deck`} />
      <figcaption>{lang === 'zh' ? '正位' : 'Upright'}</figcaption>
    </figure>
    <figure>
      <img src={card.image_url} alt={`${card.en} tarot card reversed — Rider-Waite deck`} class="reversed-img" />
      <figcaption>{lang === 'zh' ? '逆位' : 'Reversed'}</figcaption>
    </figure>
  </div>

  <div class="meaning-block">
    <h3>{lang === 'zh' ? '正位含义' : 'Upright Meaning'}</h3>
    <p>{lang === 'zh' ? card.meaning_zh.upright : card.meaning_en.upright}</p>
  </div>
  <div class="meaning-block">
    <h3>{lang === 'zh' ? '逆位含义' : 'Reversed Meaning'}</h3>
    <p>{lang === 'zh' ? card.meaning_zh.reversed : card.meaning_en.reversed}</p>
  </div>
</Layout>
