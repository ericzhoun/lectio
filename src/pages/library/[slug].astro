---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getLibraryVerses } from '../../lib/scripture';
import { resolveLang } from '../../lib/i18n';
import {
  episodesForVerse,
  getPodcastEpisodes,
  PODCAST_ATTRIBUTION,
  PODCAST_PAGE_URL,
} from '../../lib/podcast';

const { slug } = Astro.params;
const lang = resolveLang(Astro);

const verse = getLibraryVerses().find((v) => v.slug === slug);

if (!verse) {
  return new Response(null, { status: 404 });
}

const title = lang === 'zh'
  ? `${verse.refZh}（${verse.refEn}）— 经文默想`
  : `${verse.refEn} — Scripture for Reflection`;
const description = lang === 'zh'
  ? `${verse.refZh}：${verse.textZh}`
  : `${verse.refEn}: ${verse.textEn}`;

// Daily Lectio Divina podcast (Abiding Way Ministries) — episodes covering
// this exact passage, streamed from the publisher's feed with permission.
const podcastEpisodes = episodesForVerse(await getPodcastEpisodes(100), verse.refEn);
---
<Layout title={title} description={description} lang={lang}>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": title,
    "description": description,
    "inLanguage": lang === 'zh' ? 'zh' : 'en',
    "about": {
      "@type": "Thing",
      "name": verse.refEn,
      "alternateName": verse.refZh,
      "description": verse.themeEn
    },
    "isPartOf": {
      "@type": "WebSite",
      "name": "Lectio",
      "url": "https://enjoyhim.org"
    }
  })}>
  </script>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://enjoyhim.org/" },
      { "@type": "ListItem", "position": 2, "name": lang === 'zh' ? '经文库' : 'Verse Library', "item": "https://enjoyhim.org/library" },
      { "@type": "ListItem", "position": 3, "name": verse.refEn }
    ]
  })}>
  </script>

  <a class="back-link" href={`/library?lang=${lang}`}>&larr; {lang === 'zh' ? '返回经文库' : 'Back to Library'}</a>

  <header>
    <h1>{lang === 'zh' ? verse.refZh : verse.refEn}</h1>
    <p>{lang === 'zh' ? verse.refEn : verse.refZh}</p>
  </header>

  <div class="meaning-block">
    <h3>{lang === 'zh' ? '经文' : 'The Passage'}</h3>
    <blockquote class="verse-text">{lang === 'zh' ? verse.textZh : verse.textEn}</blockquote>
  </div>
  <div class="meaning-block">
    <h3>{lang === 'zh' ? '对照' : 'In the other language'}</h3>
    <blockquote class="verse-text">{lang === 'zh' ? verse.textEn : verse.textZh}</blockquote>
  </div>
  <div class="meaning-block">
    <h3>{lang === 'zh' ? '主题' : 'Theme'}</h3>
    <p><span class="tag">{lang === 'zh' ? verse.themeZh : verse.themeEn}</span></p>
  </div>

  {podcastEpisodes.length > 0 && (
    <div class="meaning-block podcast-block">
      <h3>{lang === 'zh' ? '本段经文的引导音频' : 'Guided audio for this passage'}</h3>
      {podcastEpisodes.map((ep) => (
        <div class="podcast-episode">
          <audio controls preload="none" src={ep.audioUrl}></audio>
          <p class="podcast-meta">
            {ep.passage} · {ep.title} · {ep.duration}
          </p>
        </div>
      ))}
      <p class="podcast-attribution">
        {PODCAST_ATTRIBUTION[lang]}{lang === 'zh' ? '（播客为英文）' : ''}
        {' · '}
        <a href={PODCAST_PAGE_URL} target="_blank" rel="noopener">abidingway.life</a>
        {' · '}{lang === 'zh' ? '经许可使用' : 'Featured with permission'}
      </p>
    </div>
  )}

  <p class="library-cta">
    <a class="upsell-button" href={`/?lang=${lang}`}>
      {lang === 'zh' ? '开始一次圣言诵读' : 'Begin a Lectio reading'}
    </a>
  </p>
</Layout>
