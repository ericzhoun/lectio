---
import type { Lang } from '../lib/reading';
interface Props { lang: Lang; returnTo: string; error?: string | null; headingId?: string; }
const { lang, returnTo, error = null, headingId } = Astro.props;
const errors: Record<string, { zh: string; en: string }> = {
  invalid: { zh: '邮箱或密码错误', en: 'Invalid email or password' },
  cancelled: {
    zh: '你取消了 Google 授权，随时可以重新尝试',
    en: 'You cancelled Google authorization. You can try again anytime.',
  },
  oauth_failed: {
    zh: 'Google 登录失败，请稍后重试',
    en: 'Google sign-in failed. Please try again.',
  },
  invalid_state: {
    zh: '登录请求已过期或无效，请重新发起登录',
    en: 'This sign-in request was invalid or expired. Please start again.',
  },
  config: {
    zh: 'Google 登录暂未配置，请先使用邮箱登录',
    en: 'Google sign-in is not configured yet. Please use email login.',
  },
};
const errorMsg = error ? errors[error] : null;
---
    <div class="auth-card">
      <h2 id={headingId}>{lang === 'zh' ? '登录' : 'Log in'}</h2>

      {errorMsg && (
        <p class="auth-error" role="alert">
          <span class="auth-error-icon" aria-hidden="true">!</span>
          {lang === 'zh' ? errorMsg.zh : errorMsg.en}
        </p>
      )}

      <div class="auth-google">
        <a class="google-btn" data-auth-google href={`/api/auth/google/start?lang=${lang}&returnTo=${encodeURIComponent(returnTo)}`}>
          <svg class="google-icon" viewBox="0 0 48 48" width="20" height="20" aria-hidden="true">
            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
          </svg>
          <span>{lang === 'zh' ? '使用 Google 继续' : 'Continue with Google'}</span>
        </a>
      </div>

      <div class="auth-divider">
        <span>{lang === 'zh' ? '或使用邮箱' : 'or use email'}</span>
      </div>

      <form method="post" action="/api/auth/login" data-login-form>
        <input type="hidden" name="lang" value={lang} />
        <input type="hidden" name="returnTo" value={returnTo} />
        <p class="auth-error" data-login-error role="alert" hidden></p>
        <p><input type="email" name="email" autocomplete="email" aria-label={lang === 'zh' ? '邮箱' : 'Email'} placeholder={lang === 'zh' ? '邮箱' : 'Email'} required /></p>
        <p><input type="password" name="password" autocomplete="current-password" aria-label={lang === 'zh' ? '密码' : 'Password'} placeholder={lang === 'zh' ? '密码' : 'Password'} required /></p>
        <button type="submit" class="explore-button auth-submit">{lang === 'zh' ? '登录' : 'Log in'}</button>
      </form>

      <p class="auth-switch"><a data-auth-signup href={`/signup?lang=${lang}&returnTo=${encodeURIComponent(returnTo)}`}>{lang === 'zh' ? '没有账号？注册' : "Don't have an account? Sign up"}</a></p>
    </div>
