---
import LoginForm from './LoginForm.astro';
import type { Lang } from '../lib/tarot';
interface Props { lang: Lang; }
const { lang } = Astro.props;
---
<dialog id="login-overlay" aria-labelledby="login-overlay-title" data-lang={lang}>
  <button type="button" class="login-close" aria-label={lang === 'zh' ? '关闭' : 'Close'}>&times;</button>
  <LoginForm lang={lang} returnTo={Astro.url.pathname + Astro.url.search} headingId="login-overlay-title" />
</dialog>
<style>
  dialog { width: min(460px, calc(100% - 32px)); max-height: calc(100dvh - 40px); padding: 0; border: 1px solid var(--panel-border); border-radius: 18px; background: var(--panel); color: var(--text); box-shadow: 0 24px 80px #0008; }
  dialog::backdrop { background: rgb(7 10 20 / 65%); }
  dialog :global(.auth-card) { border: 0; margin: 0; padding: 36px 28px 24px; }
  .login-close { position: absolute; top: 8px; right: 12px; background: transparent; border: 0; color: var(--text-dim); font-size: 28px; cursor: pointer; }
</style>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#login-overlay');
  if (dialog) {
    const form = dialog.querySelector<HTMLFormElement>('form')!;
    const error = dialog.querySelector<HTMLElement>('[data-login-error]')!;
    let previousOverflow = '';
    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
      const link = (event.target as Element).closest<HTMLAnchorElement>('a[href]');
      if (!link || link.target === '_blank' || link.hasAttribute('download')) return;
      const url = new URL(link.href);
      if (url.origin !== location.origin || url.pathname !== '/login') return;
      event.preventDefault();
      const returnTo = ['/login', '/signup'].includes(location.pathname)
        ? new URLSearchParams(location.search).get('returnTo') || `/?lang=${dialog.dataset.lang}`
        : location.pathname + location.search + location.hash;
      (form.elements.namedItem('returnTo') as HTMLInputElement).value = returnTo;
      for (const [selector, path] of [['[data-auth-google]', '/api/auth/google/start'], ['[data-auth-signup]', '/signup']]) {
        dialog.querySelector<HTMLAnchorElement>(selector)!.href = `${path}?${new URLSearchParams({ lang: dialog.dataset.lang!, returnTo })}`;
      }
      error.hidden = true;
      if (!dialog.open) {
        previousOverflow = document.body.style.overflow;
        dialog.showModal();
        document.body.style.overflow = 'hidden';
      }
    });
    dialog.querySelector('.login-close')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      const bounds = dialog.getBoundingClientRect();
      if (event.target === dialog && (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom)) dialog.close();
    });
    dialog.addEventListener('close', () => { document.body.style.overflow = previousOverflow; });
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      button.disabled = true;
      error.hidden = true;
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const result = await response.json() as { error?: string; returnTo?: string };
        if (!response.ok) throw new Error(result.error);
        if (!result.returnTo) throw new Error('Missing return destination');
        location.assign(result.returnTo);
      } catch (failure) {
        error.textContent = failure instanceof Error && failure.message === 'invalid'
          ? (dialog.dataset.lang === 'zh' ? '邮箱或密码错误' : 'Invalid email or password')
          : (dialog.dataset.lang === 'zh' ? '登录失败，请稍后重试' : 'Sign-in failed. Please try again.');
        error.hidden = false;
        button.disabled = false;
      }
    });
  }
</script>
