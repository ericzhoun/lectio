---
// src/components/AssistantWidget.astro
// Site-wide floating chat assistant. Thread is ephemeral (sessionStorage);
// quota + replies come from /api/assistant/*.
import type { Lang } from '../lib/reading';

interface Props {
  lang: Lang;
  loggedIn: boolean;
}
const { lang, loggedIn } = Astro.props;
const zh = lang === 'zh';
const t = {
  bubbleLabel: zh ? '打开助手' : 'Open assistant',
  title: zh ? 'Lectio 助手' : 'Lectio Assistant',
  placeholder: zh ? '随便问点什么…' : 'Ask anything…',
  send: zh ? '发送' : 'Send',
  minimize: zh ? '最小化助手' : 'Minimize assistant',
  greeting: zh
    ? '你好！我是 Lectio 助手 - 可以问经文的意思、聊聊近况，或了解网站的使用方法。'
    : "Hi! I'm the Lectio Assistant - ask about your verses, talk through what's on your mind, or learn how the site works.",
  quotaTemplate: zh ? '今日剩余 {n} 条' : '{n} left today',
  cappedTitle: zh ? '今日消息已用完' : "You've used today's messages",
  cappedAnon: zh ? '注册免费账户，每天可聊 30 条。' : 'Create a free account for 30 messages a day.',
  cappedFree: zh ? '升级 Pro，每天可聊 100 条。' : 'Upgrade to Pro for 100 messages a day.',
  signup: zh ? '免费注册' : 'Sign up free',
  viewPlans: zh ? '查看方案' : 'View plans',
  error: zh ? '我暂时没能回复，请重试。' : "I couldn't respond just now. Please try again.",
  retry: zh ? '重试' : 'Retry',
  thinking: zh ? '思考中…' : 'Thinking…',
  bubbleText: zh ? '提问' : 'Ask a question',
  teaserTitle: zh ? '有问题吗？' : 'Questions?',
  teaserBody: zh
    ? '点这里就能向助手提问，比如今天经文的意思，或网站的使用方法。'
    : "Chat with the assistant — ask what today's reading means, or how the site works.",
  teaserCta: zh ? '开始提问' : 'Ask a question',
  teaserDismiss: zh ? '关闭提示' : 'Dismiss tip',
};
---
<div id="assistant-root" data-logged-in={loggedIn ? '1' : '0'} data-lang={lang}>
  <div id="assistant-teaser" hidden role="status">
    <button type="button" id="assistant-teaser-close" aria-label={t.teaserDismiss}>×</button>
    <p class="assistant-teaser-title">{t.teaserTitle}</p>
    <p class="assistant-teaser-body">{t.teaserBody}</p>
    <button type="button" id="assistant-teaser-open" class="assistant-teaser-cta">{t.teaserCta}</button>
  </div>
  <button type="button" id="assistant-bubble" aria-label={t.bubbleLabel}>
    <span class="assistant-bubble-icon" aria-hidden="true">✦</span>
    <span class="assistant-bubble-label">{t.bubbleText}</span>
  </button>
  <section id="assistant-panel" hidden aria-label={t.title}>
    <header class="assistant-head">
      <strong>{t.title}</strong>
      <span id="assistant-quota" class="assistant-quota"></span>
      <button type="button" id="assistant-minimize" aria-label={t.minimize}>−</button>
    </header>
    <div id="assistant-thread" class="assistant-thread"></div>
    <div id="assistant-upsell" class="assistant-upsell" hidden>
      <p class="assistant-upsell-title">{t.cappedTitle}</p>
      <p id="assistant-upsell-body"></p>
      <a id="assistant-upsell-link" class="assistant-upsell-btn" href="/signup">{t.signup}</a>
    </div>
    <form id="assistant-form" class="assistant-form" autocomplete="off">
      <input id="assistant-input" type="text" placeholder={t.placeholder} maxlength="2000" />
      <button type="submit">{t.send}</button>
    </form>
  </section>
</div>

<script>
  // All strings the script needs at runtime are read from data attributes /
  // generated here, so no server round-trip is required for i18n.
  import { renderMarkdownLite } from '../lib/minimark';

  const zh = document.getElementById('assistant-root')?.getAttribute('data-lang') === 'zh';
  const T = {
    greeting: zh
      ? '你好！我是 Lectio 助手 - 可以问经文的意思、聊聊近况，或了解网站的使用方法。'
      : "Hi! I'm the Lectio Assistant - ask about your verses, talk through what's on your mind, or learn how the site works.",
    quotaTemplate: zh ? '今日剩余 {n} 条' : '{n} left today',
    cappedTitle: zh ? '今日消息已用完' : "You've used today's messages",
    cappedAnon: zh ? '注册免费账户，每天可聊 30 条。' : 'Create a free account for 30 messages a day.',
    cappedFree: zh ? '升级 Pro，每天可聊 100 条。' : 'Upgrade to Pro for 100 messages a day.',
    signup: zh ? '免费注册' : 'Sign up free',
    viewPlans: zh ? '查看方案' : 'View plans',
    error: zh ? '我暂时没能回复，请重试。' : "I couldn't respond just now. Please try again.",
    retry: zh ? '重试' : 'Retry',
    thinking: zh ? '思考中…' : 'Thinking…',
  };
  const CHIPS: Record<string, string[]> = zh
    ? {
        '/pricing': ['Pro 包含什么？', '首月免费是怎么运作的？', '可以随时取消吗？'],
        '/library': ['这节经文在讲什么？', '哪些经文适合在焦虑时读？', '旧约和新约有什么不同？'],
        '/': ['一次圣言诵读是怎么进行的？', '什么是 Lectio Divina？', '你可以帮我做什么？'],
      }
    : {
        '/pricing': ["What's in Pro?", 'How does the free trial work?', 'Can I cancel anytime?'],
        '/library': ['What is this verse about?', 'Which verses are good for anxious times?', "What's the difference between the Old and New Testament?"],
        '/': ['How does a reading work?', 'What is Lectio Divina?', 'What can you help with?'],
      };
  const DEFAULT_CHIPS = zh
    ? ['你能帮我做什么？', '每日默想次数是怎么算的？', '我过去的默想在哪里看？']
    : ['What can you help with?', 'How do the daily readings work?', 'Where are my past readings?'];

  // Actions the assistant may offer as [label](action:id) links; clicking one
  // navigates the site (kept in sync with ASSISTANT_ACTIONS in assistant.ts).
  const ACTION_DEST: Record<string, string> = {
    new_reading: '/?new=1',
    today: '/today',
    library: '/library',
    history: '/history',
    pricing: '/pricing',
    account: '/account',
    signup: '/signup',
  };
  const HISTORY_SENT = 10;
  const THREAD_KEPT = 20;
  const STORE_KEY = 'inspire-assistant-thread';

  const bubble = document.getElementById('assistant-bubble') as HTMLButtonElement;
  const teaser = document.getElementById('assistant-teaser') as HTMLElement;
  const teaserClose = document.getElementById('assistant-teaser-close') as HTMLButtonElement;
  const teaserOpen = document.getElementById('assistant-teaser-open') as HTMLButtonElement;
  const panel = document.getElementById('assistant-panel') as HTMLElement;
  const minimizeBtn = document.getElementById('assistant-minimize') as HTMLButtonElement;
  const threadEl = document.getElementById('assistant-thread') as HTMLElement;
  const form = document.getElementById('assistant-form') as HTMLFormElement;
  const input = document.getElementById('assistant-input') as HTMLInputElement;
  const quotaEl = document.getElementById('assistant-quota') as HTMLElement;
  const upsellEl = document.getElementById('assistant-upsell') as HTMLElement;
  const upsellBody = document.getElementById('assistant-upsell-body') as HTMLElement;
  const upsellLink = document.getElementById('assistant-upsell-link') as HTMLAnchorElement;

  // Action links drive the site; unknown ids (stale thread in sessionStorage)
  // are ignored. Plain links navigate natively — same tab for site-relative
  // hrefs, new tab for external ones.
  threadEl.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a');
    if (!a) return;
    const href = a.getAttribute('href') ?? '';
    if (!href.startsWith('action:')) return;
    e.preventDefault();
    const dest = ACTION_DEST[href.slice(7)];
    if (dest) window.location.href = dest;
  });

  // On ritual writing steps the launcher must never cover the gold action bar:
  // lift it above the bar and collapse it to an icon-only tab.
  if (document.querySelector('.ritual .writing')) {
    document.getElementById('assistant-root')?.classList.add('above-action');
  }

  interface Turn { role: 'user' | 'assistant'; content: string }
  let thread: Turn[] = [];
  try {
    thread = JSON.parse(sessionStorage.getItem(STORE_KEY) ?? '[]') as Turn[];
    thread = thread.filter((t) => t && (t.role === 'user' || t.role === 'assistant') && typeof t.content === 'string');
  } catch { thread = []; }
  let capped = false;
  let busy = false;
  let quotaLoaded = false;

  const save = () => {
    try { sessionStorage.setItem(STORE_KEY, JSON.stringify(thread.slice(-THREAD_KEPT))); } catch { /* ignore */ }
  };
  const scroll = () => { threadEl.scrollTop = threadEl.scrollHeight; };

  // One-time first-visit teaser: a labeled card pointing at the question
  // bubble, so new users can discover that they can ask things. Once they
  // open the assistant (or dismiss it) it never shows again.
  const TEASER_KEY = 'inspire-assistant-teaser-seen';
  let teaserSeen = false;
  try { teaserSeen = localStorage.getItem(TEASER_KEY) === '1'; } catch { /* ignore */ }
  function dismissTeaser() {
    teaser.hidden = true;
    teaserSeen = true;
    try { localStorage.setItem(TEASER_KEY, '1'); } catch { /* ignore */ }
  }
  function maybeShowTeaser() {
    if (teaserSeen || thread.length > 0) return;
    setTimeout(() => { if (!teaserSeen && panel.hidden) teaser.hidden = false; }, 1500);
  }
  teaserClose.addEventListener('click', dismissTeaser);
  teaserOpen.addEventListener('click', () => { dismissTeaser(); openPanel(); });
  maybeShowTeaser();

  function bubbleEl(role: 'user' | 'assistant' | 'error', content: string): HTMLElement {
    const el = document.createElement('div');
    el.className = `assistant-msg assistant-msg-${role}`;
    // Assistant replies arrive as markdown; render them. User input and error
    // lines are plain text and must stay textContent (no HTML from visitors).
    if (role === 'assistant') el.innerHTML = renderMarkdownLite(content);
    else el.textContent = content;
    threadEl.appendChild(el);
    scroll();
    return el;
  }

  function addChips() {
    const chips = CHIPS[location.pathname] ?? DEFAULT_CHIPS;
    const row = document.createElement('div');
    row.className = 'assistant-chips';
    for (const text of chips) {
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = text;
      b.addEventListener('click', () => { row.remove(); void send(text); });
      row.appendChild(b);
    }
    threadEl.appendChild(row);
  }

  function buildContext(): { path: string; title: string; reading: unknown } {
    const ctx: { path: string; title: string; reading: unknown } = {
      path: location.pathname,
      title: document.title,
      reading: null,
    };
    const el = document.getElementById('lectio-reading-context');
    if (el) {
      try { ctx.reading = JSON.parse(el.textContent ?? 'null'); } catch { ctx.reading = null; }
    }
    return ctx;
  }

  function showUpsell(data: { registered?: boolean; tier?: string }) {
    capped = true;
    upsellEl.hidden = false;
    if (data.registered) {
      upsellBody.textContent = T.cappedFree;
      upsellLink.textContent = T.viewPlans;
      upsellLink.href = '/pricing';
    } else {
      upsellBody.textContent = T.cappedAnon;
      upsellLink.textContent = T.signup;
      upsellLink.href = `/signup?next=${encodeURIComponent(location.pathname)}`;
    }
    quotaEl.textContent = T.quotaTemplate.replace('{n}', '0');
  }

  async function refreshQuota() {
    try {
      const res = await fetch('/api/assistant/quota');
      if (!res.ok) return;
      const data = (await res.json()) as { ok: boolean; remaining: number; registered: boolean };
      quotaEl.textContent = T.quotaTemplate.replace('{n}', String(data.remaining));
      if (!data.ok) showUpsell(data);
    } catch { /* quota display is best-effort */ }
  }

  function addErrorBubble(failedText: string) {
    const wrap = document.createElement('div');
    wrap.className = 'assistant-msg assistant-msg-error';
    const span = document.createElement('span');
    span.textContent = T.error;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.textContent = T.retry;
    btn.addEventListener('click', () => { wrap.remove(); void send(failedText); });
    wrap.appendChild(span);
    wrap.appendChild(btn);
    threadEl.appendChild(wrap);
    scroll();
  }

  // --- Tool-calling protocol 2 -------------------------------------------
  // The chat endpoint streams newline-delimited JSON events. A confirm card
  // is redeemed against /api/assistant/act, which is the ONLY place a write
  // happens; every string below passes through a model, so it is rendered
  // with textContent and never innerHTML.
  interface CardField { label: string; value: string }
  interface CardEvent {
    t: 'card';
    id?: string | number;
    tool?: string;
    token: string;
    summary: { title: string; fields?: CardField[]; confirmLabel?: string };
  }
  interface Verse { reference: string; position?: string; text?: string }
  interface Reading { kind: 'reading'; readingId?: string; question?: string; verses?: Verse[]; summary?: string }

  const CARD_T = {
    cancel: zh ? '取消' : 'Cancel',
    confirm: zh ? '确认' : 'Confirm',
    expired: zh ? '这个确认已过期，再问我一次，我会重新给你。' : 'That confirmation expired. Ask me again and I will offer it fresh.',
    signIn: zh ? '请先登录，然后再问我一次。' : 'Please sign in first, then ask me again.',
    failed: zh ? '没有成功，请再试一次。' : 'That did not go through. Please try again.',
    done: zh ? '已完成。' : 'Done.',
    openReading: zh ? '查看完整默想' : 'Open the full reading',
    billingLabel: zh ? '打开账单页面' : 'Open your billing portal',
    billingOpened: zh ? '已在新标签页打开账单页面。' : 'Your billing portal opened in a new tab.',
    billingBlocked: zh ? '浏览器拦截了新窗口，请点下面的链接。' : 'Your browser blocked the new tab - use the link below.',
  };

  // Only ever hand an http(s) URL to an anchor or window.open.
  function safeHttpUrl(raw: string): string | null {
    try {
      const u = new URL(raw, location.origin);
      return u.protocol === 'https:' || u.protocol === 'http:' ? u.href : null;
    } catch { return null; }
  }

  // The billing card must never dead-end: the anchor is the primary route and
  // is always rendered, whether or not the popup attempt survived the blocker.
  function replaceCardWithLink(el: HTMLElement, text: string, href: string, label: string) {
    replaceCard(el, text);
    const a = document.createElement('a');
    a.setAttribute('href', href);
    a.setAttribute('target', '_blank');
    a.setAttribute('rel', 'noopener');
    a.className = 'assistant-card-link';
    a.textContent = label;
    el.append(a);
    scroll();
  }

  function replaceCard(el: HTMLElement, text: string) {
    el.replaceChildren();
    el.classList.add('assistant-card-resolved');
    const p = document.createElement('p');
    p.className = 'assistant-card-note';
    p.textContent = text;
    el.append(p);
    scroll();
  }

  function renderReading(reading: Reading) {
    const el = document.createElement('div');
    el.className = 'assistant-reading-card';
    const h = document.createElement('div');
    h.className = 'assistant-reading-question';
    h.textContent = reading.question ?? '';
    const list = document.createElement('ul');
    list.className = 'assistant-reading-verses';
    for (const verse of reading.verses ?? []) {
      if (!verse || typeof verse.reference !== 'string') continue;
      const li = document.createElement('li');
      li.textContent = verse.position ? `${verse.position}: ${verse.reference}` : verse.reference;
      list.append(li);
    }
    const summary = document.createElement('p');
    summary.className = 'assistant-reading-summary';
    summary.textContent = reading.summary ?? '';
    const link = document.createElement('a');
    link.href = '/';
    link.className = 'assistant-reading-open';
    link.textContent = CARD_T.openReading;
    el.append(h, list, summary, link);
    threadEl.append(el);
    scroll();

    // A completed reading really happened, so it belongs in the thread: it must
    // survive a panel close, and the model's history needs a record of it. Keep
    // the record short - the question and the references, not the reflection.
    const refs = (reading.verses ?? [])
      .filter((v) => v && typeof v.reference === 'string')
      .map((v) => v.reference)
      .join(', ');
    const parts = [zh ? '（已完成一次默想）' : '(Started a reading.)'];
    if (reading.question) parts.push(`${zh ? '问题' : 'Question'}: ${reading.question}`);
    if (refs) parts.push(`${zh ? '经文' : 'Verses'}: ${refs}`);
    thread.push({ role: 'assistant', content: parts.join(' ') });
    save();
  }

  async function confirmCard(el: HTMLElement, token: string) {
    // Disable both buttons up front so a double-tap cannot spend two readings.
    el.querySelectorAll('button').forEach((b) => { (b as HTMLButtonElement).disabled = true; });
    let data: { error?: string; ok?: boolean; tool?: string; result?: { url?: string; kind?: string } } = {};
    try {
      const res = await fetch('/api/assistant/act', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ token }),
      });
      data = (await res.json().catch(() => ({ error: 'network' }))) as typeof data;
    } catch {
      data = { error: 'network' };
    }
    if (data.error === 'invalid_card') return replaceCard(el, CARD_T.expired);
    if (data.error === 'sign_in_required') return replaceCard(el, CARD_T.signIn);
    // tool_failed, forbidden_origin, network and anything else share one line.
    if (data.error) return replaceCard(el, CARD_T.failed);
    const result = data.result;
    // Key on the tool name, not on the shape of the result, so a future tool
    // whose result happens to carry a `url` is never given billing copy.
    if (data.tool === 'open_billing') {
      const href = typeof result?.url === 'string' ? safeHttpUrl(result.url) : null;
      if (href) {
        let opened = false;
        try { opened = window.open(href, '_blank', 'noopener') !== null; } catch { opened = false; }
        replaceCardWithLink(el, opened ? CARD_T.billingOpened : CARD_T.billingBlocked, href, CARD_T.billingLabel);
        return;
      }
      return replaceCard(el, CARD_T.failed);
    }
    if (result && result.kind === 'reading') {
      renderReading(result as unknown as Reading);
      el.remove();
      return;
    }
    replaceCard(el, CARD_T.done);
  }

  function renderCard(event: CardEvent) {
    const summary = event.summary;
    if (!summary || typeof event.token !== 'string') return;
    const el = document.createElement('div');
    el.className = 'assistant-card';
    const title = document.createElement('div');
    title.className = 'assistant-card-title';
    title.textContent = summary.title ?? '';
    const dl = document.createElement('dl');
    dl.className = 'assistant-card-fields';
    for (const field of summary.fields ?? []) {
      if (!field) continue;
      const dt = document.createElement('dt');
      dt.textContent = String(field.label ?? '');
      const dd = document.createElement('dd');
      dd.textContent = String(field.value ?? '');
      dl.append(dt, dd);
    }
    const actions = document.createElement('div');
    actions.className = 'assistant-card-actions';
    const confirm = document.createElement('button');
    confirm.type = 'button';
    confirm.className = 'assistant-card-confirm';
    confirm.textContent = summary.confirmLabel || CARD_T.confirm;
    confirm.addEventListener('click', () => { void confirmCard(el, event.token); });
    const cancel = document.createElement('button');
    cancel.type = 'button';
    cancel.className = 'assistant-card-cancel';
    cancel.textContent = CARD_T.cancel;
    cancel.addEventListener('click', () => el.remove());
    actions.append(confirm, cancel);
    el.append(title, dl, actions);
    threadEl.append(el);
    scroll();
  }

  async function send(text: string) {
    const clean = text.trim();
    if (!clean || capped || busy) return;
    busy = true;
    input.value = '';
    bubbleEl('user', clean);
    thread.push({ role: 'user', content: clean });

    const thinking = document.createElement('div');
    thinking.className = 'assistant-msg assistant-msg-thinking';
    thinking.textContent = T.thinking;
    threadEl.appendChild(thinking);
    scroll();

    try {
      const res = await fetch('/api/assistant/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          message: clean,
          history: thread.slice(0, -1).slice(-HISTORY_SENT),
          context: buildContext(),
          protocol: 2,
        }),
      });

      if (res.status === 429) {
        const data = (await res.json().catch(() => ({}))) as { registered?: boolean; tier?: string };
        thinking.remove();
        thread.pop(); // not answered - allow resending after upgrade/reset
        input.value = clean; // keep the typed message for a retry
        showUpsell(data);
        return;
      }
      if (!res.ok || !res.body) {
        thinking.remove();
        thread.pop();
        addErrorBubble(clean);
        return;
      }

      thinking.remove();
      const el = bubbleEl('assistant', '');
      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let full = '';
      // Under protocol 2 an upstream failure is an HTTP 200 whose terminal
      // frame carries `error`, so the done frame decides, not the status.
      let streamError = false;
      // A turn may be card-only (a card frame and no text frames). The empty
      // bubble must then be dropped, and no empty assistant turn recorded.
      let sawText = false;
      const handleEvent = (event: { t?: string; v?: string; error?: string; remaining?: number }) => {
        if (!event || typeof event.t !== 'string') return;
        if (event.t === 'text') {
          if (typeof event.v !== 'string') return;
          sawText = true;
          full += event.v;
          el.innerHTML = renderMarkdownLite(full);
          scroll();
        } else if (event.t === 'card') {
          renderCard(event as unknown as CardEvent);
        } else if (event.t === 'done') {
          if (typeof event.error === 'string' && event.error) streamError = true;
          else if (typeof event.remaining === 'number') {
            quotaEl.textContent = T.quotaTemplate.replace('{n}', String(event.remaining));
          }
        }
        // Unknown `t` values are ignored on purpose.
      };

      let buffered = '';
      for (;;) {
        const { done, value } = await reader.read();
        if (done) break;
        buffered += decoder.decode(value, { stream: true });
        let nl: number;
        while ((nl = buffered.indexOf('\n')) >= 0) {
          const line = buffered.slice(0, nl).trim();
          buffered = buffered.slice(nl + 1);
          if (!line) continue;
          let event: unknown;
          try { event = JSON.parse(line); } catch { continue; }
          handleEvent(event as { t?: string });
        }
      }
      // A stream cut short may leave a final line with no trailing newline.
      const tail = buffered.trim();
      if (tail) {
        try { handleEvent(JSON.parse(tail) as { t?: string }); } catch { /* malformed tail is ignored */ }
      }

      if (!sawText || !full) el.remove();
      if (streamError && !full) {
        thread.pop();
        addErrorBubble(clean);
        return;
      }
      // Only a real reply becomes a turn; an empty one would be replayed as
      // history on the next request.
      if (full) thread.push({ role: 'assistant', content: full });
      save();
      // An error after partial prose still needs the retry affordance, or the
      // visitor is left with a truncated reply and no way to notice.
      if (streamError) addErrorBubble(clean);
      void refreshQuota();
    } catch {
      thinking.remove();
      thread.pop();
      addErrorBubble(clean);
    } finally {
      busy = false;
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    void send(input.value);
  });

  function openPanel() {
    dismissTeaser();
    panel.hidden = false;
    bubble.hidden = true;
    // Rebuild the thread from state on every open so reopening never duplicates.
    threadEl.replaceChildren();
    if (thread.length === 0) {
      bubbleEl('assistant', T.greeting);
      addChips();
    } else {
      for (const t of thread) bubbleEl(t.role, t.content);
    }
    if (!quotaLoaded) {
      quotaLoaded = true;
      void refreshQuota();
    }
    input.focus();
  }
  function minimizePanel() {
    panel.hidden = true;
    bubble.hidden = false;
    bubble.focus();
  }

  bubble.addEventListener('click', openPanel);
  minimizeBtn.addEventListener('click', minimizePanel);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) minimizePanel();
  });
</script>

