---
import '../styles/global.css';
import { env } from 'cloudflare:workers';
import { verifySessionToken } from '../lib/session';
import { langSwitchHref } from '../lib/i18n';
import LoginOverlay from '../components/LoginOverlay.astro';
import AssistantWidget from '../components/AssistantWidget.astro';
import MobileNav from '../components/MobileNav.astro';
import type { Lang } from '../lib/reading';

interface Props {
  title: string;
  description?: string;
  lang: Lang;
  noindex?: boolean;
  chrome?: 'full' | 'minimal';
}
const { title, description = '', lang, noindex = false, chrome = 'full' } = Astro.props;

const sessionCookie = Astro.cookies.get('session')?.value;
const userId = sessionCookie ? await verifySessionToken(sessionCookie, env.SESSION_SECRET) : null;

// Canonical URL: strip query params (including ?lang=) so search engines
// see one URL per piece of content.
const siteUrl = 'https://enjoyhim.org';
const canonicalPath = Astro.url.pathname;
const canonicalUrl = lang === 'zh'
  ? `${siteUrl}${canonicalPath}?lang=zh`
  : `${siteUrl}${canonicalPath}`;

// Active-page highlight (same bold treatment as the language links below).
const path = Astro.url.pathname;
const isActive = (p: string) => path === p || path.startsWith(`${p}/`);

// Alternate language URL (for hreflang): en → bare path, zh → ?lang=zh,
// matching the canonical scheme above.
const altLang: Lang = lang === 'zh' ? 'en' : 'zh';
const altLangUrl = lang === 'zh'
  ? `${siteUrl}${canonicalPath}`
  : `${siteUrl}${canonicalPath}?lang=zh`;
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

  <!-- Sanctuary fonts: Cormorant Garamond (headings), EB Garamond (body),
       Noto Serif SC (Chinese). Loaded with display=swap so text never hides. -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Noto+Serif+SC:wght@400;600&display=swap"
  />

  <!-- Apply the saved theme before first paint so there is no flash of the wrong
       colors. Morning (light, parchment) is the sanctuary's default; vespers
       (dark) is an explicit choice kept in localStorage. -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') t = 'light';
        document.documentElement.setAttribute('data-theme', t);
        var m = document.getElementById('theme-color-meta');
        if (m) m.setAttribute('content', t === 'light' ? '#f5efe2' : '#211e18');
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
        var m2 = document.getElementById('theme-color-meta');
        if (m2) m2.setAttribute('content', '#f5efe2');
      }
    })();
  </script>

  <!-- SEO: title + meta description -->
  <title>{title}</title>
  {description && <meta name="description" content={description} />}

  <!-- SEO: canonical + hreflang (avoid duplicate content across lang variants) -->
  <link rel="canonical" href={canonicalUrl} />
  <link rel="alternate" hreflang={lang} href={canonicalUrl} />
  <link rel="alternate" hreflang={altLang} href={altLangUrl} />
  <link rel="alternate" hreflang="x-default" href={`${siteUrl}${canonicalPath}`} />
  <!-- SEO: opt out of indexing for private pages -->
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph / social sharing -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={`${siteUrl}/og-image.png`} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={lang === 'zh' ? 'Lectio 圣言诵读 — 每日经文默想' : 'Lectio — Daily Lectio Divina scripture reflection'} />
  <meta property="og:site_name" content="Lectio" />
  <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
  <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />

  <!-- Twitter card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  {description && <meta name="twitter:description" content={description} />}
  <meta name="twitter:image" content={`${siteUrl}/og-image.png`} />
  <meta name="twitter:image:alt" content={lang === 'zh' ? 'Lectio 圣言诵读 — 每日经文默想' : 'Lectio — Daily Lectio Divina scripture reflection'} />

  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/webp" href="/logo.webp" />
  <link rel="manifest" href="/manifest.webmanifest" />
  <link rel="apple-touch-icon" href="/logo-192.png" />
  <meta name="theme-color" id="theme-color-meta" content="#f5efe2" />

  <!-- Site-wide organization identity for search and AI engines. -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Lectio",
    "alternateName": "Lectio 圣言诵读",
    "url": siteUrl,
    "logo": `${siteUrl}/logo.webp`,
    "description": "Daily Lectio Divina scripture reflection in English and Chinese.",
  })} />
</head>
<body>
  {chrome === 'full' && (
    <div class="top-nav">
      {path !== '/' && <a href="/" style={isActive('/') ? 'font-weight: bold;' : undefined}>{lang === 'zh' ? '首页' : 'Home'}</a>}
      {userId ? (
        <a href="/account" style={isActive('/account') ? 'font-weight: bold;' : undefined}>{lang === 'zh' ? '账户' : 'Account'}</a>
      ) : (
        <a href={`/login?lang=${lang}&returnTo=${encodeURIComponent(Astro.url.pathname + Astro.url.search)}`} style={isActive('/login') ? 'font-weight: bold;' : undefined}>{lang === 'zh' ? '登录' : 'Log in'}</a>
      )}
      <a href="/today" data-event="cta_click" data-event-props='{"slot":"nav_today"}' style={isActive('/today') ? 'font-weight: bold;' : undefined}>{lang === 'zh' ? '今日' : 'Today'}</a>
      <a href="/pricing" data-event="cta_click" data-event-props='{"slot":"nav_pricing"}' style={isActive('/pricing') ? 'font-weight: bold;' : undefined}>{lang === 'zh' ? '价格' : 'Pricing'}</a>
      <a href="/library" style={isActive('/library') ? 'font-weight: bold;' : undefined}>{lang === 'zh' ? '经文库' : 'Verse Library'}</a>
      <a href="/approach" style={isActive('/approach') ? 'font-weight: bold;' : undefined}>{lang === 'zh' ? '方法' : 'Approach'}</a>
      <a href="/privacy" style={isActive('/privacy') ? 'font-weight: bold;' : undefined}>{lang === 'zh' ? '隐私' : 'Privacy'}</a>
      <a href={langSwitchHref(Astro, 'zh')} style={lang === 'zh' ? 'font-weight: bold;' : undefined}>中文</a>
      <a href={langSwitchHref(Astro, 'en')} style={lang === 'en' ? 'font-weight: bold;' : undefined}>English</a>
    </div>
  )}
  {chrome === 'full' && <MobileNav lang={lang} loggedIn={!!userId} />}
  <slot />
  {!userId && <LoginOverlay lang={lang} />}
  <script is:inline>
    // The server can only know the reader's local day if the browser tells it
    // which zone they are in. A daily practice that rolls over at the wrong
    // local hour is worse than no daily practice.
    (function () {
      try {
        var tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
        if (tz && document.cookie.indexOf('tz=') === -1) {
          document.cookie =
            'tz=' + encodeURIComponent(tz) + ';path=/;max-age=31536000;samesite=lax';
        }
      } catch (e) {
        /* no zone available; the server falls back to UTC */
      }
    })();
  </script>
  <script is:inline>
    // Headlines and sections fade up, unhurried (800ms), as they enter view.
    // Elements already on screen reveal at once; reduced-motion users simply
    // see everything (the CSS keeps [data-reveal] static for them).
    (function () {
      var els = document.querySelectorAll('[data-reveal]');
      if (!els.length) return;
      if (!('IntersectionObserver' in window)) {
        els.forEach(function (el) { el.classList.add('revealed'); });
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('revealed');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
      els.forEach(function (el) { io.observe(el); });
    })();
  </script>
  <script src="../scripts/analytics.ts"></script>
  <script src="../scripts/authPosition.ts"></script>
  <AssistantWidget lang={lang} loggedIn={!!userId} />
</body>
</html>
