# Prebuilt Chatterbox audio. Step clips are content-hashed and day clips are
# immutable once generated, so both may be cached hard at the edge.
/audio/*
  Cache-Control: public, max-age=86400, s-maxage=2592000

# Pre-cut music filenames include their source/timing hash.
/music/singing-bible/*
  Cache-Control: public, max-age=31536000, immutable

# PWA identity files. The manifest references content-addressed icons, so a
# one-day client cache is safe and cheap.
/manifest.webmanifest
  Cache-Control: public, max-age=86400
/logo-192.png
  Cache-Control: public, max-age=86400
