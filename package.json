{
  "name": "lectio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/check-node.mjs && node scripts/build-lectionary.mjs && node scripts/generate-sitemap.mjs && node scripts/generate-og-image.mjs",
    "build": "astro build",
    "deploy": "npm run build && node scripts/check-build-output.mjs && wrangler deploy && wrangler deploy -c dist/lectio_daily_invitation_cron/wrangler.json",
    "preview": "astro preview",
    "astro": "astro",
    "og": "node scripts/generate-og-image.mjs",
    "test": "vitest run",
    "tts:steps": "tsx scripts/tts/steps.mts",
    "tts:passages": "tsx scripts/tts/passages.mts",
    "music:download": "tsx scripts/download-daily-music.mts",
    "music:text": "node scripts/fetch-singing-texts.mjs",
    "music:prepare": "tsx scripts/prepare-singing-bible.mts"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "astro": "^7.2.8",
    "openai": "^7.7.0",
    "stripe": "^22.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20260827.1",
    "@types/node": "^26.4.0",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
